#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dest=${1:-"$repo_root/assets/previews"}
mkdir -p "$dest"
"$repo_root/scripts/run-all" >/dev/null
cp "$repo_root/out/01-arrows.svg" "$dest/01-arrows.svg"
cp "$repo_root/out/02-identity-composition.svg" "$dest/02-identity-composition.svg"
cp "$repo_root/out/03-composition-associativity.svg" "$dest/03-composition-associativity.svg"
cp "$repo_root/out/04-commutative-square.svg" "$dest/04-commutative-square.svg"
cp "$repo_root/out/05-product.svg" "$dest/05-product.svg"
cp "$repo_root/out/06-coproduct.svg" "$dest/06-coproduct.svg"
cp "$repo_root/out/07-array-functor.svg" "$dest/07-array-functor.svg"
cp "$repo_root/out/08-shape-preservation.svg" "$dest/08-shape-preservation.svg"
cp "$repo_root/out/09-natural-transformation.svg" "$dest/09-natural-transformation.svg"
cp "$repo_root/out/10-homomorphisms.svg" "$dest/10-homomorphisms.svg"
cp "$repo_root/out/11-lawful-reduction.svg" "$dest/11-lawful-reduction.svg"
cp "$repo_root/out/12-context-map.svg" "$dest/12-context-map.svg"
cp "$repo_root/out/13-kleisli-pipeline.svg" "$dest/13-kleisli-pipeline.svg"
cp "$repo_root/out/14-independent-contexts.svg" "$dest/14-independent-contexts.svg"
cp "$repo_root/out/15-dependent-contexts.svg" "$dest/15-dependent-contexts.svg"
cp "$repo_root/out/16-fold-fusion.svg" "$dest/16-fold-fusion.svg"
cp "$repo_root/out/17-bounded-unfold.svg" "$dest/17-bounded-unfold.svg"
cp "$repo_root/out/18-model-config-lens.svg" "$dest/18-model-config-lens.svg"
cp "$repo_root/out/19-diagonal-product-adjunction.svg" "$dest/19-diagonal-product-adjunction.svg"
cp "$repo_root/out/20-opposite-duality.svg" "$dest/20-opposite-duality.svg"
cp "$repo_root/out/21-universal-endpoints.svg" "$dest/21-universal-endpoints.svg"
cp "$repo_root/out/22-equalizer.svg" "$dest/22-equalizer.svg"
cp "$repo_root/out/23-coequalizer.svg" "$dest/23-coequalizer.svg"
echo "README previews written"
