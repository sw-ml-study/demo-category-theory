#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
budget=${WEB_GROUP_BUDGET:-26}
bad=0
for f in "$repo_root"/web/*.mlpl; do
  [ -f "$f" ] || continue
  groups=$(awk 'NF && $1 !~ /^#/ {n++} END{print n+0}' "$f")
  [ "$groups" -le "$budget" ] || { echo "${f#$repo_root/}: $groups groups exceeds $budget" >&2; bad=1; }
done
[ "$bad" -eq 0 ]
echo "web size: ok"
