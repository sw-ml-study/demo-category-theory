#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
bad=0
for f in $(find "$repo_root/lib" "$repo_root/probes" "$repo_root/tests" "$repo_root/demos" -name '*.mlpl' 2>/dev/null | sort); do
  head -n 24 "$f" | grep -q '^# ' || { echo "missing header: ${f#$repo_root/}" >&2; bad=1; }
  case "$f" in "$repo_root"/probes/*|"$repo_root"/demos/*)
    head -n 24 "$f" | grep -q '^# visual:' || { echo "missing visual: ${f#$repo_root/}" >&2; bad=1; }
    head -n 24 "$f" | grep -q '^# loops:' || { echo "missing loops: ${f#$repo_root/}" >&2; bad=1; };; esac
done
[ "$bad" -eq 0 ]
echo "docstrings: ok"
