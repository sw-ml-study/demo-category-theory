#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
manifest="$repo_root/docs/lesson-quality.tsv"

awk -F '\t' 'NR == 1 { if (NF != 9) exit 1; next } NF != 9 { exit 1 } END { if (NR != 35) exit 1 }' "$manifest"

for leaf in "$repo_root"/demos/web/*.mlpl; do
  name=$(basename "$leaf")
  count=$(awk -F '\t' -v name="$name" 'NR > 1 && $1 == name { n++ } END { print n + 0 }' "$manifest")
  [ "$count" -eq 1 ] || { echo "$name: expected one quality-manifest row" >&2; exit 1; }
  for heading in 'WHAT THIS SHOWS' 'THE VISUAL' 'HOW TO READ THE RESULT' 'THE POINT'; do
    grep -q "$heading" "$leaf" || { echo "$name: missing $heading" >&2; exit 1; }
  done
done

awk -F '\t' 'NR > 1 && $7 == "weak" && $9 == "none" { print $1 ": weak CT rating lacks follow-up"; bad=1 } NR > 1 && $8 == "weak" && $9 == "none" { print $1 ": weak expression rating lacks follow-up"; bad=1 } END { exit bad }' "$manifest"
echo "lesson quality: ok (34 leaves)"
