#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for leaf in arrows array_functor natural_transformation equalizer diagonal_product_adjunction; do
  file="$repo_root/demos/web/$leaf.mlpl"
  grep -q '# \* SETTING --' "$file" || { echo "$leaf: missing categorical setting" >&2; exit 1; }
  grep -q '# \* BOUNDARY --' "$file" || { echo "$leaf: missing claim boundary" >&2; exit 1; }
done

! grep -q 'Equal matrices prove' "$repo_root/demos/web/natural_transformation.mlpl"
! grep -q 'arrays are a concrete functor' "$repo_root/demos/web/array_functor.mlpl"
! grep -q 'largest agreeing subset' "$repo_root/demos/web/equalizer.mlpl"
grep -q 'STAGE 1' "$repo_root/demos/web/diagonal_product_adjunction.mlpl"
grep -q 'STAGE 3' "$repo_root/demos/web/diagonal_product_adjunction.mlpl"
echo "mathematical boundaries: ok"
