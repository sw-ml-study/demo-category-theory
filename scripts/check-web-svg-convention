#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
bad=0
for file in "$repo_root"/demos/web/*.mlpl; do
  [ -f "$file" ] || continue
  rel=${file#"$repo_root"/}
  grep -q '^# visual: svg' "$file" || continue
  if grep -q '^"<svg' "$file"; then
    echo "$rel: top-level SVG literal exposes raw markup in the transcript" >&2
    bad=1
  fi
  grep -q '# bind visual constant$' "$file" || {
    echo "$rel: missing named visual binding" >&2
    bad=1
  }
  grep -q '# display bound visual once$' "$file" || {
    echo "$rel: missing single bound-visual display" >&2
    bad=1
  }
  included_svg_source=$(sed -n 's/^include "\(lib\/[^";]*\.mlpl\)".*/\1/p' "$file" | head -n 1)
  marker_found=0
  arrow_style_found=0
  grep -q '<marker id=\\"arrowhead\\"' "$file" && marker_found=1
  grep -Eq '\.(arrow|a)\{marker-end:url\(\\\\23 arrowhead\);' "$file" && arrow_style_found=1
  if [ -n "$included_svg_source" ] && [ -f "$repo_root/$included_svg_source" ]; then
    grep -q '<marker id=\\"arrowhead\\"' "$repo_root/$included_svg_source" && marker_found=1
    grep -Eq '\.(arrow|a)\{marker-end:url\(\\\\23 arrowhead\);' "$repo_root/$included_svg_source" && arrow_style_found=1
  fi
  [ "$marker_found" -eq 1 ] || {
    echo "$rel: missing shared arrowhead marker" >&2
    bad=1
  }
  [ "$arrow_style_found" -eq 1 ] || {
    echo "$rel: semantic arrow style does not use the arrowhead marker" >&2
    bad=1
  }
done
[ "$bad" -eq 0 ]
echo "web SVG convention: ok"
