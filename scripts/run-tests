#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
runner=${MLPLUNIT:-$(command -v mlplunit 2>/dev/null || true)}
if [ -z "$runner" ] && [ -x "$repo_root/../../softwarewrighter/mlplunit/bin/mlplunit" ]; then
  runner="$repo_root/../../softwarewrighter/mlplunit/bin/mlplunit"
fi
[ -n "$runner" ] && [ -x "$runner" ] || { echo "mlplunit not found; set MLPLUNIT" >&2; exit 1; }
if [ "$#" -gt 0 ]; then exec "$runner" --mlpl "$mlpl" --config "$repo_root/mlplunit.conf" "$@"; fi
exec "$runner" --mlpl "$mlpl" --config "$repo_root/mlplunit.conf" "$repo_root/tests/test_category.mlpl" "$repo_root/tests/test_context.mlpl" "$repo_root/tests/test_finite_recursion.mlpl" "$repo_root/tests/test_model_config_lens.mlpl" "$repo_root/tests/test_diagonal_product_adjunction.mlpl" "$repo_root/tests/test_universal_endpoints.mlpl" "$repo_root/tests/test_equalizer_coequalizer.mlpl" "$repo_root/tests/test_pullback_pushout.mlpl" "$repo_root/tests/test_finite_limits_colimits.mlpl" "$repo_root/tests/test_representable_hom.mlpl" "$repo_root/tests/test_finite_yoneda.mlpl" "$repo_root/tests/test_unique_universal_isomorphism.mlpl"
