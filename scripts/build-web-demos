#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dest=${1:-"$repo_root/web"}
mkdir -p "$dest"
for f in "$repo_root"/demos/web/*.mlpl; do [ -f "$f" ] || continue; cp "$f" "$dest/$(basename "$f")"; done
cp "$repo_root/docs/browser-learning-path.md" "$dest/START_HERE.md"
echo "web entries written"
