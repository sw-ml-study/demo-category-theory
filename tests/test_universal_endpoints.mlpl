# Tests for CT020-CT024 finite duality and universal endpoints.
include "lib/universal_endpoints.mlpl";

@test {name: "opposite reverses arrows and dualizes path order", tags: ["CT020", "CT021", "duality"]}
def u:test_opposite_and_dual_statement() { "Finite transpose reverses arrows, is involutive, and reverses explicit composition order.";
  relation = [[0, 1, 0], [0, 0, 1], [0, 0, 0]];
  opposite = u:opposite_relation(relation);
  u:assert_eq(equal(opposite, [[0, 0, 0], [1, 0, 0], [0, 1, 0]]), 1, "opposite arrows")?;
  u:assert_eq(equal(u:opposite_twice(relation), relation), 1, "opposite involution")?;
  u:assert_eq(equal(u:reverse_three_arrow_path([10, 20, 30]), [30, 20, 10]), 1, "dual path order")?;
  ok({test: "opposite-duality", cases: 3})
}

@test {name: "initial terminal and zero objects have unique arrows", tags: ["CT022", "CT023", "CT024", "universal"]}
def u:test_universal_endpoint_objects() { "Finite function counts and a pointed category distinguish initial, terminal, and zero objects.";
  u:assert_eq(u:endpoint_function_count(0, 3), 1, "empty initial arrow")?;
  u:assert_eq(u:endpoint_function_count(3, 1), 1, "singleton terminal arrow")?;
  not_initial = u:unique_arrow_witness("singleton initial", 1, u:endpoint_function_count(1, 2));
  not_terminal = u:unique_arrow_witness("empty terminal", 1, 0);
  u:assert_eq(not_initial.found * not_terminal.found, 1, "endpoint witnesses")?;
  pointed_hom_counts = [[1, 1], [1, 2]];
  u:assert_eq(u:is_zero_by_hom_counts(pointed_hom_counts, 0, 2), 1, "pointed zero object")?;
  u:assert_eq(u:is_zero_by_hom_counts(pointed_hom_counts, 1, 2), 0, "ordinary object not zero")?;
  ok({test: "universal-endpoints", cases: 5})
}

u:run_registered_tests()
