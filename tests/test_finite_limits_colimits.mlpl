# Tests for CT027-CT036 cones, cocones, and finite universal shapes.
include "lib/finite_limits_colimits.mlpl";

@test {name: "cones and cocones commute over a finite arrow", tags: ["CT027", "CT028", "cone", "cocone"]}
def u:test_cone_and_cocone_routes() {
  "Verify lawful finite legs and retain one broken leg in each direction.";
  diagram_arrow = [1, 0, 1];
  cone = u:cone_routes(diagram_arrow, [0, 2], [1, 1]);
  broken_cone = u:cone_routes(diagram_arrow, [0, 2], [1, 0]);
  cocone = u:cocone_routes(diagram_arrow, [0, 1, 0], [1, 0]);
  broken_cocone = u:cocone_routes(diagram_arrow, [0, 1, 0], [0, 0]);
  u:assert_eq(cone.commutes, 1, "cone commutes")?;
  u:assert_eq(broken_cone.commutes, 0, "broken cone witness")?;
  u:assert_eq(cocone.commutes, 1, "cocone commutes")?;
  u:assert_eq(broken_cocone.commutes, 0, "broken cocone witness")?;
  ok({test: "cone-cocone", cases: 4})
}

@test {name: "finite limits and colimits are universal bounded cones", tags: ["CT033", "CT034", "CT035", "CT036"]}
def u:test_bounded_finite_universality() {
  "Select terminal and initial candidates while rejecting non-unique factorization counts.";
  limit = u:terminal_cone_from_factor_counts([10, 11, 12], [1, 1, 1]);
  colimit = u:initial_cocone_from_factor_counts([20, 21, 22], [1, 1, 1]);
  bad_limit = u:bounded_universality_witness("not terminal cone", [1, 2, 1]);
  bad_colimit = u:bounded_universality_witness("not initial cocone", [1, 1, 0]);
  u:assert_eq(limit.universal * colimit.universal, 1, "bounded universals")?;
  u:assert_eq(bad_limit.found * bad_colimit.found, 1, "factorization witnesses")?;
  u:assert_eq(equal(u:finite_limit_shape_codes(), [1, 2, 3]), 1, "finite limit shapes")?;
  u:assert_eq(equal(u:finite_colimit_shape_codes(), [4, 5, 6]), 1, "finite colimit shapes")?;
  ok({test: "finite-limits-colimits", cases: 4})
}

u:run_registered_tests()
