# Conformance for the concrete contextual record and its mapping/bind behavior.
# loops: 0
include "lib/context.mlpl";
def u:identity_payload(value) {
  "Return one payload unchanged.";
  value
}
def u:increment_payload(value) {
  "Increment one numeric payload.";
  value + 1
}
def u:double_payload(value) {
  "Double one numeric payload.";
  value * 2
}
def u:increment_then_double_payload(value) {
  "Increment and then double one numeric payload.";
  2 * (value + 1)
}
def u:validate_positive_payload(value) {
  "Double a positive payload or return a contextual failure.";
  scalar = take(value, 0, 0);
  if equal(lt(0, scalar), 1) { u:context_success(scalar * 2) } else { u:context_failure("not positive") }
}
def u:require_even_payload(value) {
  "Return half of an even payload or a contextual failure.";
  scalar = take(value, 0, 0);
  if equal(mod(scalar, 2), 0) { u:context_success(scalar / 2) } else { u:context_failure("not even") }
}
def u:add_ten_payload(value) {
  "Add ten to a contextual payload.";
  scalar = take(value, 0, 0);
  u:context_success(scalar + 10)
}
def u:identity_context_payload(value) {
  "Return one scalar payload unchanged.";
  value
}
def u:increment_then_double_context_payload(value) {
  "Increment and then double one scalar payload.";
  2 * (value + 1)
}
def u:load_row_count(dataset_id) {
  "Load a fixed row count for one known dataset identifier.";
  scalar = take(dataset_id, 0, 0);
  if equal(scalar, 7) { u:context_success(120) } else { u:context_failure("dataset missing") }
}
def u:choose_batch_count(row_count) {
  "Choose a batch count from a previously loaded row count.";
  scalar = take(row_count, 0, 0);
  u:context_success(scalar / 10)
}

@test {name: "context records retain nested payloads", tags: ["contexts", "records"]}
def u:test_context_records() {
  "Nested records and arrays survive contextual wrapping and equality.";
  nested = u:context_success({items: [1, 2], meta: {count: 2}});
  u:assert_eq(equal(nested, u:context_success({items: [1, 2], meta: {count: 2}})), 1, "nested payload changed")?;
  u:assert_eq(u:context_is_success(nested), 1, "success tag missing")?;
  u:assert_eq(u:context_is_failure(u:context_failure("bad")), 1, "failure tag missing")?;
  ok({test: "context-records", cases: 3})
}

@test {name: "context map obeys concrete functor laws", tags: ["contexts", "laws"]}
def u:test_context_map_laws() {
  "Mapping identity/composition works and failures short-circuit.";
  success = u:context_success(3);
  failure = u:context_failure("bad input");
  u:assert_eq(equal(u:context_map(success, :u:identity_payload), success), 1, "identity law")?;
  mapped_twice = u:context_map(u:context_map(success, :u:increment_payload), :u:double_payload);
  mapped_once = u:context_map(success, :u:increment_then_double_payload);
  u:assert_eq(equal(mapped_twice, mapped_once), 1, "composition law")?;
  u:assert_eq(equal(u:context_map(failure, :u:increment_payload), failure), 1, "failure was transformed")?;
  ok({test: "context-map-laws", cases: 3})
}

@test {name: "context bind returns contexts and preserves failures", tags: ["contexts", "bind"]}
def u:test_context_bind_surface() {
  "Contextual function returns survive call and earlier failures skip later work.";
  bound = u:context_bind(u:context_success(4), :u:validate_positive_payload);
  u:assert_eq(equal(bound, u:context_success(8)), 1, "context return distorted")?;
  earlier = u:context_failure("earlier");
  u:assert_eq(equal(u:context_bind(earlier, :u:validate_positive_payload), earlier), 1, "failure did not short-circuit")?;
  witness = u:context_counterexample(u:context_success(8), u:context_success(9));
  u:assert_eq(witness.found, 1, "context witness absent")?;
  ok({test: "context-bind-surface", cases: 3})
}

@test {name: "Kleisli composition obeys identity and associativity", tags: ["contexts", "kleisli", "laws"]}
def u:test_kleisli_laws() {
  "Concrete fallible stages obey left/right identity and associativity.";
  input = 4;
  direct = call(:u:validate_positive_payload, [input]);
  left_identity = u:context_bind(call(:u:context_return_called, [input]), :u:validate_positive_payload);
  u:assert_eq(equal(left_identity, direct), 1, "left identity")?;
  right_identity = u:context_bind(direct, :u:context_return_called);
  u:assert_eq(equal(right_identity, direct), 1, "right identity")?;
  left_grouped = u:context_bind(u:context_bind(direct, :u:require_even_payload), :u:add_ten_payload);
  right_grouped = u:kleisli_apply_three(:u:validate_positive_payload, :u:require_even_payload, :u:add_ten_payload, input);
  u:assert_eq(equal(left_grouped, right_grouped), 1, "associativity")?;
  failed = u:kleisli_apply_three(:u:validate_positive_payload, :u:require_even_payload, :u:add_ten_payload, -1);
  u:assert_eq(equal(failed, u:context_failure("not positive")), 1, "failure did not short-circuit")?;
  witness = u:kleisli_law_witness(-1, u:context_failure("not positive"), u:context_success(9));
  u:assert_eq(witness.found, 1, "failure witness absent")?;
  ok({test: "kleisli-laws", cases: 5})
}

@test {name: "independent context application obeys concrete laws", tags: ["contexts", "applicative", "laws"]}
def u:test_independent_context_laws() {
  "Independent contextual functions and values obey identity and composition fixtures.";
  value_context = u:context_success(5);
  identity_result = u:context_apply(u:context_success(:u:identity_context_payload), value_context);
  u:assert_eq(equal(identity_result, value_context), 1, "independent identity")?;
  sequential = u:context_apply(u:context_success(:u:double_payload), u:context_apply(u:context_success(:u:increment_payload), value_context));
  composed = u:context_apply(u:context_success(:u:increment_then_double_context_payload), value_context);
  u:assert_eq(equal(sequential, composed), 1, "independent composition")?;
  paired = u:context_pair(u:context_success(120), u:context_success(0.8));
  u:assert_eq(equal(paired.value, {left: 120, right: 0.8}), 1, "independent product")?;
  failed = u:context_pair(u:context_failure("rows invalid"), u:context_success(0.8));
  u:assert_eq(equal(failed, u:context_failure("rows invalid")), 1, "independent failure")?;
  witness = u:context_counterexample(u:context_failure("rows invalid"), u:context_success({left: 0, right: 0.8}));
  u:assert_eq(witness.found, 1, "broken independent witness")?;
  ok({test: "independent-context-laws", cases: 5})
}

@test {name: "dependent context uses the earlier result", tags: ["contexts", "monad", "dependency"]}
def u:test_dependent_context_pipeline() {
  "A later batching decision consumes the row count produced by the earlier stage.";
  successful = u:kleisli_apply_two(:u:load_row_count, :u:choose_batch_count, 7);
  missing = u:kleisli_apply_two(:u:load_row_count, :u:choose_batch_count, -1);
  u:assert_eq(equal(successful, u:context_success(12)), 1, "dependent success")?;
  u:assert_eq(equal(missing, u:context_failure("dataset missing")), 1, "dependent short circuit")?;
  broken = u:context_success(10);
  witness = u:kleisli_law_witness(-1, missing, broken);
  u:assert_eq(witness.found, 1, "broken dependency witness")?;
  ok({test: "dependent-context-pipeline", cases: 3})
}

u:run_registered_tests()
