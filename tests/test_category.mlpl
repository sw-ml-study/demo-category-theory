# Conformance for executable path laws and counterexample witnesses.
#
# loops: 0

include "lib/category.mlpl";

def u:inc(x) { x + 1 }
def u:also_inc(x) { 1 + x }
def u:double(x) { 2 * x }
def u:plus2(x) { x + 2 }
def u:negate(x) { 0 - x }
def u:inc_double(x) { 2 * (x + 1) }

@test {name: "identity and application", tags: ["laws"]}
def u:test_identity() { "Identity leaves finite inputs unchanged.";
  xs = range(5);
  u:assert_eq(u:paths_equal(:u:id, :u:id, xs), 1, "identity differs")?;
  u:assert_eq(u:apply(:u:inc, 3), 4, "function reference call")?;
  u:assert_eq(u:then_apply(:u:inc, :u:double, 3), 8, "composition order")?;
  ok({test: "identity", cases: 3})
}

@test {name: "path equality returns a witness", tags: ["laws", "witness"]}
def u:test_witness() { "Equal paths pass; unequal paths name the first input.";
  xs = range(4);
  u:assert_eq(u:paths_equal(:u:inc, :u:also_inc, xs), 1, "equal paths rejected")?;
  w = u:path_counterexample(:u:inc, :u:double, xs);
  u:assert_eq(w.found, 1, "missing witness")?;
  u:assert_eq(w.input, 0, "wrong first input")?;
  u:assert_eq(w.left, 1, "wrong left value")?;
  u:assert_eq(w.right, 0, "wrong right value")?;
  ok({test: "witness", cases: 5})
}

@test {name: "commutative square and broken witness", tags: ["laws", "squares"]}
def u:test_square() { "Both routes agree, or the checker names the first split.";
  xs = range(5);
  u:assert_eq(u:square_commutes(:u:inc, :u:double, :u:double, :u:plus2, xs), 1, "lawful square rejected")?;
  broken = u:square_counterexample(:u:inc, :u:double, :u:double, :u:inc, xs);
  u:assert_eq(broken.found, 1, "broken square accepted")?;
  u:assert_eq(broken.input, 0, "wrong witness input")?;
  u:assert_eq(broken.upper, 2, "wrong upper result")?;
  u:assert_eq(broken.lower, 1, "wrong lower result")?;
  ok({test: "square", cases: 5})
}

@test {name: "concrete product universal property", tags: ["products"]}
def u:test_product() { "Both projections force the unique pair.";
  p = u:pair(3, 8);
  u:assert_eq(u:fst(p), 3, "first projection")?;
  u:assert_eq(u:snd(p), 8, "second projection")?;
  lawful = u:product_factor(3, 8, p);
  u:assert_eq(lawful.commutes, 1, "pair does not commute")?;
  u:assert_eq(lawful.unique, 1, "pair not unique")?;
  bad = u:product_factor(3, 8, u:pair(3, 9));
  u:assert_eq(bad.commutes, 0, "wrong pair accepted")?;
  ok({test: "product", cases: 5})
}

@test {name: "concrete coproduct universal property", tags: ["coproducts"]}
def u:test_coproduct() { "Both injections determine case analysis.";
  u:assert_eq(u:copair(u:left_value(3), :u:inc, :u:negate), 4, "left case")?;
  u:assert_eq(u:copair(u:right_value(3), :u:inc, :u:negate), -3, "right case")?;
  law = u:coproduct_agrees(:u:inc, :u:negate, range(3), range(3), [1, 2, 3], [0, -1, -2]);
  u:assert_eq(law.commutes, 1, "case restrictions disagree")?;
  u:assert_eq(law.unique, 1, "case map not uniquely determined")?;
  bad = u:coproduct_agrees(:u:inc, :u:negate, range(3), range(3), [1, 2, 4], [0, -1, -2]);
  u:assert_eq(bad.commutes, 0, "bad case map accepted")?;
  ok({test: "coproduct", cases: 5})
}

@test {name: "arrays obey concrete functor laws", tags: ["functors", "arrays"]}
def u:test_array_functor() { "each preserves identity and composition.";
  v = [1, 2, 3];
  m = [[1, 2], [3, 4]];
  u:assert_eq(u:array_functor_identity(v), 1, "vector identity")?;
  u:assert_eq(u:array_functor_identity(m), 1, "matrix identity")?;
  u:assert_eq(u:array_functor_composition(:u:inc, :u:double, :u:inc_double, v), 1, "composition")?;
  u:assert_eq(equal(shape(u:array_map(:u:inc, m)), shape(m)), 1, "map changed shape")?;
  bad = u:array_map_counterexample(v, [3, 2, 1]);
  u:assert_eq(bad.found, 1, "bad lift accepted")?;
  u:assert_eq(bad.index, 0, "wrong bad-lift witness")?;
  ok({test: "array-functor", cases: 6})
}

u:run_registered_tests()
