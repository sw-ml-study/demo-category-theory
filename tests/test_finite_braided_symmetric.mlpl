# Tests for CT092-CT096 finite braided and symmetric structure.
include "lib/finite_braided_symmetric.mlpl";
@test {name: "hexagon paths braid one value past two", tags: ["CT092", "CT093", "CT094"]}
def u:test_finite_braiding_hexagon() { "Compare direct and componentwise braiding paths and reject a changed endpoint.";
  start_tensor = {left: 2, right: {left: 3, right: 5}};
  direct_path = u:hexagon_direct_braiding_path(start_tensor);
  component_path = u:hexagon_component_braiding_path(start_tensor);
  u:assert_eq(equal(component_path.first, direct_path.endpoint), 0, "distinct intermediate")?;
  u:assert_eq(equal(component_path.endpoint, direct_path.endpoint), 1, "hexagon endpoint")?;
  u:assert_eq(equal(component_path.endpoint, {left: {left: 3, right: 6}, right: 2}), 0, "changed endpoint")?;
  ok({test: "finite-braiding-hexagon", cases: 3})
}
@test {name: "braiding is natural and symmetric in the fixture", tags: ["CT095", "CT096"]}
def u:test_finite_braiding_symmetry() { "Check one naturality square and that braiding twice is identity.";
  u:assert_eq(u:braiding_naturality_square_commutes({left: 8, right: 3}, {left: 8, right: 3}), 1, "naturality")?;
  u:assert_eq(u:symmetry_law_holds({left: 2, right: 3}), 1, "double braid")?;
  ok({test: "finite-braiding-symmetry", cases: 2})
}
u:run_registered_tests()
