# Tests for CT055-CT058 bounded functor properties.
include "lib/preservation_creation_reflection.mlpl";

@test {name: "functor preserves bounded limits and colimits", tags: ["CT055", "CT056", "preservation"]}
def u:test_preservation_of_bounded_universals() { "Verify source and image universality while retaining loss-of-universality witnesses.";
  lost_limit = u:preservation_failure_witness(1, 0);
  lost_colimit = u:preservation_failure_witness(1, 0);
  u:assert_eq(u:functor_preserves_limit(1, 1), 1, "limit not preserved")?;
  u:assert_eq(u:functor_preserves_colimit(1, 1), 1, "colimit not preserved")?;
  u:assert_eq(lost_limit.found * lost_colimit.found, 1, "missing preservation counterexamples")?;
  ok({test: "preservation", cases: 3})
}

@test {name: "creation and reflection impose different bounded checks", tags: ["CT057", "CT058", "creation", "reflection"]}
def u:test_creation_differs_from_reflection() { "Require a unique lifted source limit for creation but only backward detection for reflection.";
  false_reflection = u:reflection_failure_witness(1, 0);
  nonunique_creation = u:creation_failure_witness(1, 2);
  u:assert_eq(u:functor_reflects_limit(1, 1), 1, "limit not reflected")?;
  u:assert_eq(u:functor_creates_limit(1, 1, 1), 1, "limit not created")?;
  u:assert_eq(false_reflection.found, 1, "missing reflection counterexample")?;
  u:assert_eq(nonunique_creation.found, 1, "missing creation counterexample")?;
  ok({test: "creation-reflection", cases: 4})
}

u:run_registered_tests()
