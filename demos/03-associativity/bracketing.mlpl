# Lesson 03 -- associativity of function composition.
# visual: ascii, svg
# loops: 0

include "../../lib/category.mlpl"
include "../../lib/render.mlpl"
u:prolog({title: "LESSON 03 -- COMPOSITION IS ASSOCIATIVE", intro: "Move brackets around three functions without changing the route or result."})
def u:inc(x) { x + 1 }
def u:double(x) { 2 * x }
def u:square(x) { x * x }
def u:left(x) { u:apply(:u:square, u:then_apply(:u:inc, :u:double, x)) }
def u:right(x) { u:then_apply(:u:inc, :u:double, x) * u:then_apply(:u:inc, :u:double, x) }
xs = range(5)
lhs = each(:u:left, xs)
rhs = each(:u:right, xs)
disp([lhs, rhs])
wrote = write_text("out/03-composition-associativity.svg", u:associativity_diagram())
u:epilog_open()
u:explain("out/03-composition-associativity.svg", "Both bracketings follow A to B to C to D; brackets organize evaluation but do not alter the arrows.")
u:takeaway("Composition is associative because both bracketings apply f, then g, then h in exactly that order.")
if equal(lhs, rhs) * is_ok(wrote) { ok("composition associativity holds") } else { err("composition associativity failed") }
