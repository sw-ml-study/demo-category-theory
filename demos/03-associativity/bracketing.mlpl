# Lesson 03 -- associativity of function composition.
# visual: ascii, svg
# loops: 0

include "../../lib/category.mlpl"
include "../../lib/render.mlpl"
u:prolog({title: "LESSON 03 -- COMPOSITION IS ASSOCIATIVE", intro: "Move brackets around three functions without changing the route or result."})
def u:increment(x) { "Serve as the scalar morphism f whose lifted or composed action is being tested.";  x + 1 }
def u:double(x) { "Serve as the scalar morphism g whose lifted or composed action is being tested.";  2 * x }
def u:square(x) { "Serve as the third morphism h in the associativity equation.";  x * x }
def u:left_bracketing_result(x) { "Execute the left-associated side of the composition associativity law.";  u:apply(:u:square, u:then_apply(:u:increment, :u:double, x)) }
def u:right_bracketing_result(x) { "Execute the right-associated side of the composition associativity law.";  u:then_apply(:u:increment, :u:double, x) * u:then_apply(:u:increment, :u:double, x) }
xs = range(5)
lhs = each(:u:left_bracketing_result, xs)
rhs = each(:u:right_bracketing_result, xs)
disp([lhs, rhs])
wrote = write_text("out/03-composition-associativity.svg", u:associativity_diagram())
u:epilog_open()
u:explain("out/03-composition-associativity.svg", "Both bracketings follow A to B to C to D; brackets organize evaluation but do not alter the arrows.")
u:takeaway("Composition is associative because both bracketings apply f, then g, then h in exactly that order.")
if equal(lhs, rhs) * is_ok(wrote) { ok("composition associativity holds") } else { err("composition associativity failed") }
