# Lesson 39 -- finite subobjects, truth classification, and partial maps.
# visual: ascii, svg
# loops: 0
include "../../lib/finite_subobjects.mlpl"
include "../../lib/render.mlpl"
u:prolog({title: "LESSON 39 -- TRUTH MAPS CLASSIFY FINITE SUBOBJECTS", intro: "Inventory the four subsets of a two-point set, classify {0} by truth, and restrict a partial map to that domain."})
membership_rows = [[0, 0], [1, 0], [0, 1], [1, 1]]
complete_inventory = u:two_point_subobject_inventory_is_complete(membership_rows)
classified_subobject = u:characteristic_map_classifies_subobject([1, 0], [1, 0])
wrong_characteristic_map = 1 - u:characteristic_map_classifies_subobject([1, 0], [0, 1])
partial_map_is_well_formed = u:bounded_partial_map_is_well_formed([1, 0], [9])
extra_output_rejected = 1 - u:bounded_partial_map_is_well_formed([1, 0], [9, 8])
disp(membership_rows)
disp([complete_inventory, classified_subobject, wrong_characteristic_map, partial_map_is_well_formed, extra_output_rejected])
wrote = write_text("out/39-finite-subobjects.svg", u:finite_subobjects_visual())
u:epilog_open()
u:explain("out/39-finite-subobjects.svg", "Each Boolean row names a subobject. The characteristic map for {0} sends 0 to true and 1 to false; pulling back true recovers exactly that subset. The partial map stores output 9 only there.")
u:takeaway("In this finite-Set fixture, truth-valued characteristic maps classify subobjects. Partial maps add an explicit domain because sw-MLPL does not type partiality.")
if complete_inventory * classified_subobject * wrong_characteristic_map * partial_map_is_well_formed * extra_output_rejected * is_ok(wrote) { ok("finite subobjects and partial map verified") } else { err("finite subobject invariant failed") }
