# Web Lesson 31 -- bounded indexed products and coproducts.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * A discrete three-object diagram has a finite product as its limit and a
# * tagged finite coproduct as its colimit.
# ***************************************************************************
;
def u:three_object_product(first_leg, second_leg, third_leg) { "Build the unique mediator into a three-object finite product."; [first_leg, second_leg, third_leg] }  # bounded product
def u:three_branch_case_outputs(first_value, second_value, third_value) { "Apply one explicit case rule to three coproduct branches."; [10 + first_value, 20 + second_value, 30 + third_value] }  # bounded case map
legs = [2, 5, 7]  # cone legs
product_mediator = u:three_object_product(2, 5, 7)  # forced tuple
case_outputs = u:three_branch_case_outputs(2, 5, 7)  # forced branch outputs
product_law = equal(product_mediator, legs)  # discrete limit
coproduct_law = equal(case_outputs, [12, 25, 37])  # discrete colimit
bad_product_rejected = 1 - equal([2, 5, 8], legs)  # changed projection
bad_case_rejected = 1 - equal([12, 25, 38], case_outputs)  # changed branch
disp([legs, product_mediator, case_outputs])  # constructions
disp([product_law, coproduct_law, bad_product_rejected, bad_case_rejected])  # laws
# ***************************************************************************
# * THE VISUAL
# * Product projections point into A, B, C; coproduct injections point from
# * A, B, C into one tagged sum.
# ***************************************************************************
def u:bounded_indexed_products_visual() { "Return a directed three-leg product and coproduct visual."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 350\" role=\"img\"><title>bounded indexed products and coproducts</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(115px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(115px)}}</style><rect width=\"900\" height=\"350\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"350\" y=\"25\" width=\"200\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"80\" y=\"145\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"375\" y=\"145\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"670\" y=\"145\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"390\" y1=\"80\" x2=\"200\" y2=\"145\"/><line class=\"arrow\" x1=\"450\" y1=\"80\" x2=\"450\" y2=\"145\"/><line class=\"arrow\" x1=\"510\" y1=\"80\" x2=\"700\" y2=\"145\"/><rect class=\"obj\" x=\"350\" y=\"270\" width=\"200\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"155\" y1=\"200\" x2=\"390\" y2=\"270\"/><line class=\"arrow\" x1=\"450\" y1=\"200\" x2=\"450\" y2=\"270\"/><line class=\"arrow\" x1=\"745\" y1=\"200\" x2=\"510\" y2=\"270\"/><text x=\"450\" y=\"60\" text-anchor=\"middle\">product / limit [2,5,7]</text><text x=\"155\" y=\"178\" text-anchor=\"middle\">A</text><text x=\"450\" y=\"178\" text-anchor=\"middle\">B</text><text x=\"745\" y=\"178\" text-anchor=\"middle\">C</text><text x=\"450\" y=\"305\" text-anchor=\"middle\">coproduct / colimit</text><circle class=\"token\" cx=\"450\" cy=\"70\" r=\"8\"/></svg>" }  # named custom visual
bounded_indexed_products_visual = u:bounded_indexed_products_visual()  # bind visual constant
bounded_indexed_products_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The top tuple is forced by all three projections; the bottom case map is
# * forced by all three tagged injections.
# * THE POINT -- these are indexed (co)limits for a finite discrete diagram;
# * width three does not establish arbitrary or infinite wide families.
# ***************************************************************************
