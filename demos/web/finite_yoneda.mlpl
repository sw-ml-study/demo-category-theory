# Web Lesson 28 -- finite Yoneda in three stages.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * One element of F(A) generates a natural transformation from Hom(A,-),
# * and evaluation at idA recovers that element.
# * PREREQUISITES -- representable Hom(A,-), natural transformations, naturality.
# * CATEGORICAL SETTING -- the walking-arrow category A -f-> B and a finite F.
# * LAW / UNIVERSAL PROPERTY -- Nat(Hom(A,-),F) corresponds to F(A).
# * BOUNDARY -- this finite fixture illustrates one correspondence instance.
# ***************************************************************************
;
def u:functor_action(element) {
  "Map F(A)'s element along f into F(B).";
  if equal(element, 10) {
    20
  } else {
    -1
  }
}  # F(f)
def u:transformation_from_element(element) {
  "Generate both finite transformation components from one element.";
  {at_a: element, at_b: u:functor_action(element)}
}  # Yoneda forward
def u:element_from_transformation(transformation) {
  "Evaluate the A-component at identity A.";
  transformation.at_a
}  # Yoneda inverse
transformation = u:transformation_from_element(10)  # components 10 and 20
recovered_element = u:element_from_transformation(transformation)  # returns 10
regenerated = u:transformation_from_element(recovered_element)  # round trip
naturality = equal(u:functor_action(transformation.at_a), transformation.at_b)  # square commutes
broken_naturality = 1 - equal(u:functor_action(10), 21)  # first witness
disp([10])  # STAGE 1: choose x in F(A)
disp([transformation.at_a, transformation.at_b, naturality])  # STAGE 2: eta_A(idA), eta_B(f), square
disp([recovered_element, equal(regenerated, transformation)])  # STAGE 3: recover x and round trip
disp([20, 21, broken_naturality])  # COUNTEREXAMPLE: expected F(f)(10)=20, actual 21
# ***************************************************************************
# * THE VISUAL
# * Three numbered panels separate choosing x, checking naturality, and recovery.
# ***************************************************************************
def u:finite_yoneda_visual() {
  "Render three progressive stages of the finite Yoneda correspondence.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 960 400\" role=\"img\"><title>finite Yoneda correspondence in three stages</title><desc>Choose 10 in F(A), generate a natural transformation and verify its walking-arrow square, then recover 10 by evaluating at identity A. A dashed 21 breaks naturality.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:3}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:9 6}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(130px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(130px)}}</style><rect width=\"960\" height=\"400\" fill=\"rgb(26,27,38)\"/><text x=\"120\" y=\"28\" text-anchor=\"middle\">1. CHOOSE x</text><rect class=\"obj\" x=\"25\" y=\"55\" width=\"190\" height=\"70\" rx=\"12\"/><text x=\"120\" y=\"82\" text-anchor=\"middle\">x = 10</text><text x=\"120\" y=\"106\" text-anchor=\"middle\">in F(A)</text><circle class=\"token\" cx=\"55\" cy=\"115\" r=\"8\"/><text x=\"520\" y=\"28\" text-anchor=\"middle\">2. GENERATE eta; CHECK NATURALITY</text><rect class=\"obj\" x=\"300\" y=\"55\" width=\"180\" height=\"58\" rx=\"10\"/><rect class=\"obj\" x=\"650\" y=\"55\" width=\"180\" height=\"58\" rx=\"10\"/><rect class=\"obj\" x=\"300\" y=\"205\" width=\"180\" height=\"58\" rx=\"10\"/><rect class=\"obj\" x=\"650\" y=\"205\" width=\"180\" height=\"58\" rx=\"10\"/><text x=\"390\" y=\"90\" text-anchor=\"middle\">Hom(A,A)=[idA]</text><text x=\"740\" y=\"90\" text-anchor=\"middle\">F(A)=[10]</text><text x=\"390\" y=\"240\" text-anchor=\"middle\">Hom(A,B)=[f]</text><text x=\"740\" y=\"240\" text-anchor=\"middle\">F(B)=[20]</text><line class=\"arrow\" x1=\"480\" y1=\"84\" x2=\"650\" y2=\"84\"/><line class=\"arrow\" x1=\"480\" y1=\"234\" x2=\"650\" y2=\"234\"/><line class=\"arrow\" x1=\"390\" y1=\"113\" x2=\"390\" y2=\"205\"/><line class=\"arrow\" x1=\"740\" y1=\"113\" x2=\"740\" y2=\"205\"/><text x=\"565\" y=\"72\" text-anchor=\"middle\">eta_A: idA |-&gt; 10</text><text x=\"565\" y=\"222\" text-anchor=\"middle\">eta_B: f |-&gt; 20</text><text x=\"345\" y=\"162\">postcompose f</text><text x=\"755\" y=\"162\">F(f)</text><path class=\"bad\" d=\"M830 234H905\"/><text x=\"870\" y=\"220\" text-anchor=\"middle\">BROKEN 21</text><text x=\"565\" y=\"288\" text-anchor=\"middle\">both routes send idA to 20: COMMUTES</text><text x=\"480\" y=\"330\" text-anchor=\"middle\">3. RECOVER x BY EVALUATION</text><rect class=\"obj\" x=\"320\" y=\"345\" width=\"320\" height=\"42\" rx=\"10\"/><text x=\"480\" y=\"372\" text-anchor=\"middle\">eta_A(id_A) = 10 = x</text></svg>"
}  # named custom visual
finite_yoneda_visual = u:finite_yoneda_visual()  # bind visual constant
finite_yoneda_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Panel 1 chooses x=10. Panel 2 names all four corners and both routes.
# * Panel 3 evaluates eta_A at id_A and visibly returns the chosen x.
# * THE POINT -- this is the Yoneda correspondence; density is a later extension.
# ***************************************************************************
