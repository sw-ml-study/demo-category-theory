# Web Lesson 10 -- homomorphisms compose.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Identity followed by parity is parity, still preserving modular addition.
# ***************************************************************************
;
id4 = range(4)  # identity homomorphism on Z4
parity = [0, 1, 0, 1]  # homomorphism Z4 to Z2
disp([id4, parity])  # the two composable arrows
# ***************************************************************************
# * THE VISUAL
# * Follow identity, then parity: the composed arrow remains structure-preserving.
# ***************************************************************************
def u:homomorphisms_visual() { "Return the homomorphisms_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 250\" width=\"760\" height=\"250\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(410px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(410px)}}</style><rect width=\"760\" height=\"250\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"45\" y=\"80\" width=\"150\" height=\"80\" rx=\"14\"/><rect class=\"obj\" x=\"305\" y=\"80\" width=\"150\" height=\"80\" rx=\"14\"/><rect class=\"obj\" x=\"565\" y=\"80\" width=\"150\" height=\"80\" rx=\"14\"/><line class=\"arrow\" x1=\"195\" y1=\"120\" x2=\"305\" y2=\"120\"/><line class=\"arrow\" x1=\"455\" y1=\"120\" x2=\"565\" y2=\"120\"/><text x=\"120\" y=\"127\" text-anchor=\"middle\">Z4</text><text x=\"380\" y=\"127\" text-anchor=\"middle\">Z4</text><text x=\"640\" y=\"127\" text-anchor=\"middle\">Z2</text><text x=\"250\" y=\"105\">id</text><text x=\"500\" y=\"105\">parity</text><circle class=\"token\" cx=\"180\" cy=\"145\" r=\"9\"/></svg>" }  # named custom visual
homomorphisms_visual = u:homomorphisms_visual()  # bind visual constant
homomorphisms_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The local MLPL checker verifies preservation; the diagram shows composition.
# * THE POINT -- identity and composition make homomorphisms into morphisms.
# ***************************************************************************
