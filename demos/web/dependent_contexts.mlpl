# Web Lesson 15 -- dependent contextual computation.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * A batching decision cannot run until loading supplies the actual row count.
# ***************************************************************************
;
def u:choose_batches(row_count) { "Choose one batch per ten previously loaded rows."; row_count / 10 }  # dependent stage
loaded_rows = 120  # successful first stage
batch_count = u:choose_batches(loaded_rows)  # later work consumes 120
missing = {tag: "failure", value: 0, message: "dataset missing"}  # first stage failed
broken = {expected: missing, actual: {tag: "success", value: 10, message: ""}, found: 1}  # illicit later result
disp([loaded_rows, batch_count, broken.found])  # 120, 12, and the witness
# ***************************************************************************
# * THE VISUAL
# * Green passes 120 into batching. Red stops before any batch count exists.
# ***************************************************************************
def u:dependent_contexts_visual() { "Return the dependent_contexts_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 280\" width=\"820\" height=\"280\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.failed{stroke:rgb(247,118,142)}.token{fill:rgb(247,118,142);animation:p 4s infinite alternate}@keyframes p{to{transform:translateX(540px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(540px)}}</style><rect width=\"820\" height=\"280\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"30\" y=\"45\" width=\"160\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"330\" y=\"45\" width=\"160\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"630\" y=\"45\" width=\"160\" height=\"60\" rx=\"14\"/><line class=\"arrow\" x1=\"190\" y1=\"75\" x2=\"330\" y2=\"75\"/><line class=\"arrow\" x1=\"490\" y1=\"75\" x2=\"630\" y2=\"75\"/><text x=\"110\" y=\"82\" text-anchor=\"middle\">dataset 7</text><text x=\"410\" y=\"82\" text-anchor=\"middle\">rows 120</text><text x=\"710\" y=\"82\" text-anchor=\"middle\">batches 12</text><rect class=\"obj\" x=\"30\" y=\"180\" width=\"160\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"330\" y=\"180\" width=\"200\" height=\"60\" rx=\"14\"/><line class=\"arrow failed\" x1=\"190\" y1=\"210\" x2=\"330\" y2=\"210\"/><text x=\"110\" y=\"217\" text-anchor=\"middle\">dataset -1</text><text x=\"430\" y=\"217\" text-anchor=\"middle\">failure: missing</text><text x=\"670\" y=\"217\" text-anchor=\"middle\">batching skipped</text><circle class=\"token\" cx=\"170\" cy=\"95\" r=\"9\"/></svg>" }  # named custom visual
dependent_contexts_visual = u:dependent_contexts_visual()  # bind visual constant
dependent_contexts_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The middle value is an input to the last arrow, not an independent branch.
# * THE POINT -- bind sequences work whose later choice needs earlier data.
# ***************************************************************************
