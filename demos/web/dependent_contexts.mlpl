# Web Lesson 15 -- dependent contextual computation.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * A batching decision cannot run until loading supplies the actual row count.
# ***************************************************************************
;
def u:choose_batches(row_count) { "Choose one batch per ten previously loaded rows."; row_count / 10 }  # dependent stage
loaded_rows = 120  # successful first stage
batch_count = u:choose_batches(loaded_rows)  # later work consumes 120
missing = {tag: "failure", value: 0, message: "dataset missing"}  # first stage failed
broken = {expected: missing, actual: {tag: "success", value: 10, message: ""}, found: 1}  # illicit later result
disp([loaded_rows, batch_count, broken.found])  # 120, 12, and the witness
# ***************************************************************************
# * THE VISUAL
# * Green passes 120 into batching. Red stops before any batch count exists.
# ***************************************************************************
"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 280\" width=\"820\" height=\"280\" role=\"img\"><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.failed{stroke:#f7768e}.token{fill:#f7768e;animation:p 4s infinite alternate}@keyframes p{to{transform:translateX(540px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(540px)}}</style><rect width=\"820\" height=\"280\" fill=\"#1a1b26\"/><rect class=\"obj\" x=\"30\" y=\"45\" width=\"160\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"330\" y=\"45\" width=\"160\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"630\" y=\"45\" width=\"160\" height=\"60\" rx=\"14\"/><line class=\"arrow\" x1=\"190\" y1=\"75\" x2=\"330\" y2=\"75\"/><line class=\"arrow\" x1=\"490\" y1=\"75\" x2=\"630\" y2=\"75\"/><text x=\"110\" y=\"82\" text-anchor=\"middle\">dataset 7</text><text x=\"410\" y=\"82\" text-anchor=\"middle\">rows 120</text><text x=\"710\" y=\"82\" text-anchor=\"middle\">batches 12</text><rect class=\"obj\" x=\"30\" y=\"180\" width=\"160\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"330\" y=\"180\" width=\"200\" height=\"60\" rx=\"14\"/><line class=\"arrow failed\" x1=\"190\" y1=\"210\" x2=\"330\" y2=\"210\"/><text x=\"110\" y=\"217\" text-anchor=\"middle\">dataset -1</text><text x=\"430\" y=\"217\" text-anchor=\"middle\">failure: missing</text><text x=\"670\" y=\"217\" text-anchor=\"middle\">batching skipped</text><circle class=\"token\" cx=\"170\" cy=\"95\" r=\"9\"/></svg>"  # dependent success and failure routes
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The middle value is an input to the last arrow, not an independent branch.
# * THE POINT -- bind sequences work whose later choice needs earlier data.
# ***************************************************************************
