# Web Lesson 11 -- lawful reduction regrouping.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Associative addition permits a balanced tree; subtraction does not.
# ***************************************************************************
;
serial_sum = ((8 + 4) + 2) + 1  # left-to-right work
tree_sum = (8 + 4) + (2 + 1)  # independent lower branches
serial_sub = ((8 - 4) - 2) - 1  # equals 1
tree_sub = (8 - 4) - (2 - 1)  # equals 3
disp([serial_sum, tree_sum, serial_sub, tree_sub])  # equality then warning
# ***************************************************************************
# * THE VISUAL
# * The balanced green branches may run together because both sum trees reach 15.
# ***************************************************************************
def u:lawful_reduction_visual() {
  "Render the directed SVG witness for this lesson categorical law.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 270\" width=\"760\" height=\"270\" role=\"img\"><title>lawful reduction regrouping</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(70px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(70px)}}</style><rect width=\"760\" height=\"270\" fill=\"rgb(26,27,38)\"/><text x=\"380\" y=\"28\" text-anchor=\"middle\">(8+4) and (2+1) can execute together</text><rect class=\"obj\" x=\"100\" y=\"65\" width=\"220\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"440\" y=\"65\" width=\"220\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"270\" y=\"190\" width=\"220\" height=\"60\" rx=\"14\"/><text x=\"210\" y=\"107\" text-anchor=\"middle\">8+4 = 12</text><text x=\"550\" y=\"107\" text-anchor=\"middle\">2+1 = 3</text><text x=\"380\" y=\"227\" text-anchor=\"middle\">12+3 = 15</text><line class=\"arrow\" x1=\"210\" y1=\"135\" x2=\"340\" y2=\"190\"/><line class=\"arrow\" x1=\"550\" y1=\"135\" x2=\"420\" y2=\"190\"/><circle class=\"token\" cx=\"210\" cy=\"120\" r=\"9\"/></svg>"
}  # named custom visual
lawful_reduction_visual = u:lawful_reduction_visual()  # bind visual constant
lawful_reduction_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Equal sums license regrouping; unequal subtraction results forbid it.
# * THE POINT -- a mathematical law becomes safe execution freedom.
# ***************************************************************************
