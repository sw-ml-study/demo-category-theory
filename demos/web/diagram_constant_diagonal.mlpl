# Web Lesson 30 -- diagram category, constant diagram, and diagonal functor.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * A composable-pair index shape receives the same object and identity arrow
# * everywhere; transformations between diagrams compose at each node.
# ***************************************************************************
;
def u:apply_three_value_table(function_table, inputs) { "Apply one three-value function table to three explicit inputs."; [take(function_table, 0, take(inputs, 0, 0)), take(function_table, 0, take(inputs, 0, 1)), take(function_table, 0, take(inputs, 0, 2))] }  # finite application
def u:compose_three_value_tables(first_table, second_table) { "Compose two three-value function tables in execution order."; u:apply_three_value_table(second_table, first_table) }  # finite composition
identity_table = [0, 1, 2]  # identity on X
constant_objects = [3, 3, 3]  # diagonal object action
constant_arrows = [identity_table, identity_table, identity_table]  # two arrows and composite
composition_preserved = equal(u:compose_three_value_tables(take(constant_arrows, 0, 0), take(constant_arrows, 0, 1)), take(constant_arrows, 0, 2))  # functor law
component_identity = equal(u:compose_three_value_tables(identity_table, [1, 2, 0]), [1, 2, 0])  # diagram-category identity
broken_composite_rejected = 1 - equal([1, 0, 2], identity_table)  # broken arrow action
disp(constant_objects)  # repeated object codes
disp(constant_arrows)  # repeated identity arrows
disp([composition_preserved, component_identity, broken_composite_rejected])  # laws and witness
# ***************************************************************************
# * THE VISUAL
# * Green arrows are the index-shape arrows; blue arrows are components of a
# * natural transformation between two diagram objects.
# ***************************************************************************
def u:diagram_constant_diagonal_visual() { "Return the directed constant-diagram and pointwise-transformation visual."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 340\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.component{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:3}</style><rect width=\"900\" height=\"340\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"70\" y=\"50\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"375\" y=\"50\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"680\" y=\"50\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"220\" y1=\"77\" x2=\"375\" y2=\"77\"/><line class=\"arrow\" x1=\"525\" y1=\"77\" x2=\"680\" y2=\"77\"/><rect class=\"obj\" x=\"70\" y=\"240\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"375\" y=\"240\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"680\" y=\"240\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"220\" y1=\"267\" x2=\"375\" y2=\"267\"/><line class=\"arrow\" x1=\"525\" y1=\"267\" x2=\"680\" y2=\"267\"/><line class=\"component\" x1=\"145\" y1=\"105\" x2=\"145\" y2=\"240\"/><line class=\"component\" x1=\"450\" y1=\"105\" x2=\"450\" y2=\"240\"/><line class=\"component\" x1=\"755\" y1=\"105\" x2=\"755\" y2=\"240\"/><text x=\"145\" y=\"84\" text-anchor=\"middle\">X</text><text x=\"450\" y=\"84\" text-anchor=\"middle\">X</text><text x=\"755\" y=\"84\" text-anchor=\"middle\">X</text><text x=\"450\" y=\"25\" text-anchor=\"middle\">constant / diagonal diagram</text><text x=\"450\" y=\"325\" text-anchor=\"middle\">components compose pointwise</text></svg>" }  # named custom visual
diagram_constant_diagonal_visual = u:diagram_constant_diagonal_visual()  # bind visual constant
diagram_constant_diagonal_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The same X and identity fill the top diagram. Vertical components connect
# * diagram objects and are composed independently at each node.
# * THE POINT -- diagrams of one shape form a category, and the diagonal
# * functor embeds one object as a constant diagram.
# ***************************************************************************
