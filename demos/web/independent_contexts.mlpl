# Web Lesson 14 -- independent contextual computation.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Two independently validated features converge only after both succeed.
# ***************************************************************************
;
row_count = {tag: "success", value: 120, message: ""}  # first independent result
threshold = {tag: "success", value: 0.8, message: ""}  # second independent result
combined = {tag: "success", value: {left: row_count.value, right: threshold.value}, message: ""}  # product after both
identity_result = row_count.value  # applying identity changes nothing
composed_result = 2 * (row_count.value + 1)  # sequential and composed transforms both reach 242
broken = {expected: "failure", actual: "success with invented zero", found: 1}  # a visible law witness
disp([combined.value.left, combined.value.right, identity_result, composed_result, broken.found])  # executable evidence
# ***************************************************************************
# * THE VISUAL
# * Separate green branches carry 120 and 0.8 into one product record.
# ***************************************************************************
def u:independent_contexts_visual() { "Render the directed SVG witness for this lesson categorical law."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 270\" width=\"820\" height=\"270\" role=\"img\"><title>independent contextual computation</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(330px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(330px)}}</style><rect width=\"820\" height=\"270\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"45\" y=\"45\" width=\"210\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"45\" y=\"165\" width=\"210\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"575\" y=\"100\" width=\"200\" height=\"80\" rx=\"14\"/><line class=\"arrow\" x1=\"255\" y1=\"78\" x2=\"575\" y2=\"125\"/><line class=\"arrow\" x1=\"255\" y1=\"198\" x2=\"575\" y2=\"155\"/><text x=\"150\" y=\"85\" text-anchor=\"middle\">rows 120</text><text x=\"150\" y=\"205\" text-anchor=\"middle\">threshold 0.8</text><text x=\"675\" y=\"145\" text-anchor=\"middle\">product {120, 0.8}</text><circle class=\"token\" cx=\"235\" cy=\"98\" r=\"9\"/></svg>" }  # named custom visual
independent_contexts_visual = u:independent_contexts_visual()  # bind visual constant
independent_contexts_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Neither feature chooses the other; the product waits for both contexts.
# * THE POINT -- Applicative-style structure describes independent effects.
# ***************************************************************************
