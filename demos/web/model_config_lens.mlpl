# Web Lesson 18 -- lawful nested model configuration access.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * A focused learning-rate update preserves every surrounding model field.
# ***************************************************************************
;
def u:get_rate(configuration) { "Read the nested learning rate from a model configuration."; configuration.training.learning_rate }  # getter
def u:set_rate(configuration, learning_rate) { "Rebuild the configuration with only its nested learning rate changed."; {name: configuration.name, training: {learning_rate: learning_rate, batch_size: configuration.training.batch_size}, metadata: configuration.metadata} }  # lawful setter
configuration = {name: "classifier", training: {learning_rate: 0.01, batch_size: 32}, metadata: {version: 3}}  # practical fixture
get_put = u:set_rate(configuration, u:get_rate(configuration))  # original record
put_get = u:get_rate(u:set_rate(configuration, 0.02))  # replacement focus
put_put = u:set_rate(u:set_rate(configuration, 0.02), 0.03)  # last write wins
direct_put = u:set_rate(configuration, 0.03)  # same last write
broken = {name: configuration.name, training: {learning_rate: 0.01, batch_size: 1}, metadata: configuration.metadata}  # sibling corrupted
disp([equal(get_put, configuration), put_get, equal(put_put, direct_put), broken.training.batch_size])  # three laws and witness
# ***************************************************************************
# * THE VISUAL
# * Green changes only rate. Red resets batch size and violates get-put.
# ***************************************************************************
def u:model_config_lens_visual() { "Render the directed SVG witness for this lesson categorical law."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 840 290\" width=\"840\" height=\"290\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{stroke:rgb(247,118,142)}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(440px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(440px)}}</style><rect width=\"840\" height=\"290\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"30\" y=\"45\" width=\"240\" height=\"90\" rx=\"14\"/><rect class=\"obj\" x=\"570\" y=\"45\" width=\"240\" height=\"90\" rx=\"14\"/><line class=\"arrow\" x1=\"270\" y1=\"90\" x2=\"570\" y2=\"90\"/><text x=\"150\" y=\"82\" text-anchor=\"middle\">rate .01, batch 32</text><text x=\"150\" y=\"110\" text-anchor=\"middle\">version 3</text><text x=\"690\" y=\"82\" text-anchor=\"middle\">rate .02, batch 32</text><text x=\"690\" y=\"110\" text-anchor=\"middle\">version 3</text><rect class=\"obj\" x=\"145\" y=\"195\" width=\"220\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"475\" y=\"195\" width=\"220\" height=\"60\" rx=\"14\"/><line class=\"arrow bad\" x1=\"365\" y1=\"225\" x2=\"475\" y2=\"225\"/><text x=\"255\" y=\"232\" text-anchor=\"middle\">expected batch 32</text><text x=\"585\" y=\"232\" text-anchor=\"middle\">broken batch 1</text><circle class=\"token\" cx=\"250\" cy=\"110\" r=\"9\"/></svg>" }  # named custom visual
model_config_lens_visual = u:model_config_lens_visual()  # bind visual constant
model_config_lens_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The focus changes while its surrounding record remains observationally same.
# * THE POINT -- three lens laws make nested access and update predictable.
# ***************************************************************************
