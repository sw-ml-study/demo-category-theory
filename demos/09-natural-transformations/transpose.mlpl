# Lesson 09 -- transpose as a concrete natural transformation.
# visual: ascii, svg
# loops: 0
include "../../lib/category.mlpl"
include "../../lib/render.mlpl"
u:prolog({title: "LESSON 09 -- A WHOLE FAMILY OF COMMUTING SQUARES", intro: "Transpose supplies one component for each matrix shape. Cellwise mapping commutes with every component."})
def u:increment(x) {
  "Serve as the scalar morphism f whose lifted or composed action is being tested.";
  x + 1
}
def u:double(x) {
  "Serve as the scalar morphism g whose lifted or composed action is being tested.";
  2 * x
}
def u:offset_transpose_component(m) {
  "Provide a deliberately non-natural transpose component for the counterexample.";
  each(:u:increment, transpose(m))
}
a = [[1, 2, 3], [4, 5, 6]]
b = [[1, 2], [3, 4], [5, 6]]
map_then_transpose = u:transpose_after_map(:u:increment, a)
transpose_then_map = u:map_after_transpose(:u:increment, a)
witness = u:naturality_counterexample(:u:double, :u:offset_transpose_component, a)
disp(map_then_transpose)
disp(transpose_then_map)
disp([witness.index, witness.expected, witness.actual])
wrote = write_text("out/09-natural-transformation.svg", u:naturality_diagram())
u:epilog_open()
u:explain("out/09-natural-transformation.svg", "Each green square chooses a matrix shape, maps every cell, and transposes. Either order lands at the same transposed matrix. The red square adds one inside its component and splits cell 0 into 3 versus 4.")
u:takeaway("Transpose supplies components between the 2D-array shape contexts before and after axis reversal. These finite matrices verify instances of naturality; they do not prove the law for every matrix or category.")
if u:transpose_natural(:u:increment, a) * u:transpose_natural(:u:double, b) * witness.found * eq(witness.index, 0) * eq(witness.expected, 3) * eq(witness.actual, 4) * is_ok(wrote) {
  ok("transpose naturality verified")
} else {
  err("naturality invariant failed")
}
