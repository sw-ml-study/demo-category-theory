# Lesson 54 -- finite Frobenius, specialness, and bounded spider rewrite.
# visual: ascii, svg
# loops: 0
include "../../lib/finite_frobenius_spiders.mlpl"
include "../../lib/render.mlpl"
u:prolog({title: "LESSON 54 -- MERGE AND SPLIT, THEN FUSE THE CONNECTED GRAPH", intro: "Compare independent Frobenius routes, cancel split-then-merge by specialness, and rewrite one same-boundary connected graph."})
frobenius = u:frobenius_compatibility_holds([0, 0, 1, 1], [0, 0, 1, 1])
broken_frobenius = 1 - u:frobenius_compatibility_holds([0, 0, 1, 1], [0, 1, 1, 1])
specialness = u:special_frobenius_holds([0, 1], [0, 1])
broken_specialness = 1 - u:special_frobenius_holds([0, 0], [0, 1])
spider = u:bounded_spider_rewrite_holds([2, 2], [2, 2], [0, 0, 1, 1], [0, 0, 1, 1])
broken_boundary = 1 - u:bounded_spider_rewrite_holds([2, 2], [1, 2], [0, 0, 1, 1], [0, 0, 1, 1])
broken_endpoint = 1 - u:bounded_spider_rewrite_holds([2, 2], [2, 2], [0, 0, 1, 1], [0, 1, 1, 1])
disp([frobenius, broken_frobenius, specialness, broken_specialness, spider, broken_boundary, broken_endpoint])
wrote = write_text("out/54-frobenius-spiders.svg", u:finite_frobenius_spiders_visual())
u:epilog_open()
u:explain("out/54-frobenius-spiders.svg", "The attributed classical-bit merge/split routes agree, split then merge is identity, and one connected 2-to-2 graph matches one spider node.")
u:takeaway("Frobenius and specialness enable this bounded fusion; one finite rewrite does not prove the general spider theorem.")
if frobenius * broken_frobenius * specialness * broken_specialness * spider * broken_boundary * broken_endpoint * is_ok(wrote) { ok("finite Frobenius spiders verified") } else { err("Frobenius spider failed") }
