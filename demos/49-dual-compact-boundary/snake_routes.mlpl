# Lesson 49 -- dual-object snake identities and compact-closed boundary.
# visual: ascii, svg
# loops: 0
include "../../lib/finite_dual_compact_boundary.mlpl"
include "../../lib/render.mlpl"
u:prolog({title: "LESSON 49 -- CANCEL A DUAL PAIR; AUDIT EVERY OBJECT", intro: "Follow separate identity routes for A and A-star, then expose the missing object-dual evidence required for compact closure."})
pairing_tables = u:evaluation_coevaluation_tables_match([1, 0, 0, 1], [1, 0, 0, 1])
snake_identities = u:dual_object_snake_identities_hold(["A", "A*", "A"], ["A*", "A", "A*"], ["A"], ["A"], ["A*"], ["A*"])
broken_left_snake = 1 - u:dual_object_snake_identities_hold(["A", "A*", "A"], ["A*", "A", "A*"], ["changed-A"], ["A"], ["A*"], ["A*"])
broken_right_snake = 1 - u:dual_object_snake_identities_hold(["A", "A*", "A"], ["A*", "A", "A*"], ["A"], ["A"], ["changed-dual"], ["A*"])
compact_coverage_missing = 1 - u:compact_closed_object_coverage_is_complete([1, 0])
disp([pairing_tables, snake_identities, broken_left_snake, broken_right_snake, compact_coverage_missing])
wrote = write_text("out/49-dual-compact-boundary.svg", u:finite_dual_compact_boundary_visual())
u:epilog_open()
u:explain("out/49-dual-compact-boundary.svg", "Evaluation removes A-star tensor A; coevaluation creates A tensor A-star. The green A route and blue A-star route return different typed identities, while object B still lacks a verified dual.")
u:takeaway("A dual object needs both snake identities. Compact closed is stronger: every object needs such verified dual data.")
if pairing_tables * snake_identities * broken_left_snake * broken_right_snake * compact_coverage_missing * is_ok(wrote) {
  ok("dual object and compact boundary verified")
} else {
  err("dual object boundary failed")
}
