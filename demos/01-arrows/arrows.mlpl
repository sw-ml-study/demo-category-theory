# Lesson 01 -- objects and morphisms as finite values and functions.
# visual: ascii, svg
# loops: 0

include "../../lib/category.mlpl"
include "../../lib/render.mlpl"
u:prolog({title: "LESSON 01 -- ARROWS ARE FUNCTIONS", intro: "Watch double map every visible source value to one target value."})
def u:double(x) { 2 * x }
xs = range(5)
ys = each(:u:double, xs)
disp([xs, ys])
wrote = write_text("out/01-arrows.svg", u:arrow_diagram())
u:epilog_open()
u:explain("out/01-arrows.svg", "The pink token crosses the arrow labelled double. The two boxes are concrete finite sets of numbers.")
u:takeaway("A morphism is direction plus behavior: each visible input has exactly one visible output.")
if equal(ys, [0, 2, 4, 6, 8]) * is_ok(wrote) { ok("arrow mapped every input") } else { err("arrow lesson invariant failed") }
