# Lesson 05 -- products through pairing and projections.
# visual: ascii, svg
# loops: 0
include "../../lib/category.mlpl"
include "../../lib/render.mlpl"
u:prolog({title: "LESSON 05 -- A PRODUCT IS FORCED BY ITS PROJECTIONS", intro: "Pair 3 and 8, project both coordinates, and test a competing pair."})
p = u:pair(3, 8)
good = u:product_factor(3, 8, p)
bad = u:product_factor(3, 8, u:pair(3, 9))
disp([u:first_projection(p), u:second_projection(p), good.unique, bad.unique])
wrote = write_text("out/05-product.svg", u:product_diagram())
u:epilog_open()
u:explain("out/05-product.svg", "The pair at the top has two green projections. Requiring fst=3 and snd=8 leaves no freedom: pair(3,9) visibly misses the second target.")
u:takeaway("A product is not merely two fields; it is the unique mediator determined by both projections.")
if good.commutes * good.unique * (1 - bad.commutes) * is_ok(wrote) {
  ok("product universal property verified")
} else {
  err("product invariant failed")
}
