# lib/finite_dagger_structure.mlpl -- finite dagger laws and dagger-compact coverage.
# loops: 0
def u:dagger_category_laws_hold(identity_dagger, identity_arrow, dagger_composite, reversed_dagger_factors, dagger_twice, original_arrow) { "Check identity preservation, reversed composition order, and dagger involution for one finite typed path."; equal(identity_dagger, identity_arrow) * equal(dagger_composite, reversed_dagger_factors) * equal(dagger_twice, original_arrow) }
def u:cup_cap_are_dagger_compatible(cup_dagger, cap) { "Check that reversing and adjoint-labeling the displayed cup produces the displayed cap."; equal(cup_dagger, cap) }
def u:dagger_compact_coverage_is_complete(object_coverage) { "Require dagger-compatible dual data for every enumerated object before claiming dagger compact structure."; reduce_mul(object_coverage) }
def u:finite_dagger_structure_visual() { "Render a typed process path, its reversed adjoint path, dagger laws, and incomplete dagger-compact coverage."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 620\" role=\"img\"><title>finite dagger structure</title><desc>A path A through f and g to C reverses to C through g dagger and f dagger to A. Dagger reverses composition order and applying it twice restores the path. Cup dagger equals cap for object A, but object B lacks covered dual data.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.other{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:4;fill:none}.bad{stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:10 7;fill:none}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(240px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(240px)}}</style><rect width=\"1100\" height=\"620\" fill=\"rgb(26,27,38)\"/><text x=\"550\" y=\"35\" text-anchor=\"middle\">FORWARD: g AFTER f</text><rect class=\"obj\" x=\"120\" y=\"70\" width=\"110\" height=\"55\" rx=\"9\"/><rect class=\"obj\" x=\"495\" y=\"70\" width=\"110\" height=\"55\" rx=\"9\"/><rect class=\"obj\" x=\"870\" y=\"70\" width=\"110\" height=\"55\" rx=\"9\"/><text x=\"175\" y=\"105\" text-anchor=\"middle\">A</text><text x=\"550\" y=\"105\" text-anchor=\"middle\">B</text><text x=\"925\" y=\"105\" text-anchor=\"middle\">C</text><path class=\"arrow\" d=\"M230 97H495\"/><path class=\"arrow\" d=\"M605 97H870\"/><text x=\"362\" y=\"84\" text-anchor=\"middle\">f</text><text x=\"738\" y=\"84\" text-anchor=\"middle\">g</text><circle class=\"token\" cx=\"245\" cy=\"97\" r=\"7\"/><text x=\"550\" y=\"180\" text-anchor=\"middle\">DAGGER: f† AFTER g† — ORDER REVERSES</text><rect class=\"obj\" x=\"120\" y=\"215\" width=\"110\" height=\"55\" rx=\"9\"/><rect class=\"obj\" x=\"495\" y=\"215\" width=\"110\" height=\"55\" rx=\"9\"/><rect class=\"obj\" x=\"870\" y=\"215\" width=\"110\" height=\"55\" rx=\"9\"/><text x=\"175\" y=\"250\" text-anchor=\"middle\">A</text><text x=\"550\" y=\"250\" text-anchor=\"middle\">B</text><text x=\"925\" y=\"250\" text-anchor=\"middle\">C</text><path class=\"other\" d=\"M870 242H605\"/><path class=\"other\" d=\"M495 242H230\"/><text x=\"738\" y=\"229\" text-anchor=\"middle\">g†</text><text x=\"362\" y=\"229\" text-anchor=\"middle\">f†</text><text x=\"550\" y=\"320\" text-anchor=\"middle\">id† = id   ·   (g∘f)† = f†∘g†   ·   f†† = f</text><text x=\"280\" y=\"390\" text-anchor=\"middle\">DAGGER-COMPACT COMPATIBILITY</text><rect class=\"obj\" x=\"80\" y=\"425\" width=\"400\" height=\"70\" rx=\"10\"/><text x=\"280\" y=\"468\" text-anchor=\"middle\">cup_A† = cap_A  ✓</text><text x=\"820\" y=\"390\" text-anchor=\"middle\">EVERY-OBJECT COVERAGE</text><rect class=\"obj\" x=\"620\" y=\"425\" width=\"180\" height=\"70\" rx=\"10\"/><rect class=\"bad\" x=\"840\" y=\"425\" width=\"180\" height=\"70\" rx=\"10\"/><text x=\"710\" y=\"468\" text-anchor=\"middle\">A ✓</text><text x=\"930\" y=\"468\" text-anchor=\"middle\">B □</text><text x=\"550\" y=\"560\" text-anchor=\"middle\">coverage [1,0] — dagger category fixture, not dagger compact</text><path class=\"bad\" d=\"M350 595H750\"/></svg>" }
