# lib/finite_dependent_constructions.mlpl -- bounded dependent families over a finite base.
# loops: 0
def u:make_flat_finite_family(base_values, flat_fiber_values, fiber_offsets, fiber_sizes) { "Store a finite dependent family as base values plus flat fiber values, offsets, and sizes."; {base: base_values, values: flat_fiber_values, offsets: fiber_offsets, sizes: fiber_sizes} }
def u:dependent_sum_table(family, tagged_base_positions) { "Pair every flat fiber value with its supplied base-position tag to form a bounded dependent sum."; {base_positions: tagged_base_positions, values: family.values} }
def u:dependent_product_choices(candidate_choice_rows) { "Return the explicitly enumerated rows that choose one value from each finite fiber."; candidate_choice_rows }
def u:finite_dependent_sum_is_complete(dependent_sum, expected_base_positions, expected_values) { "Check that a bounded dependent sum contains the expected tags and values."; equal(dependent_sum.base_positions, expected_base_positions) * equal(dependent_sum.values, expected_values) }
def u:finite_dependent_product_is_complete(candidate_choices, expected_choices) { "Check extensionally that all displayed dependent-product choices were enumerated."; equal(candidate_choices, expected_choices) }
def u:local_cartesian_closure_coverage_holds(slice_exponential_checks) { "Require an exponential certificate for every explicitly listed finite slice fixture."; reduce_mul(slice_exponential_checks) }
def u:finite_dependent_constructions_visual() { "Render uneven fibers, their tagged dependent sum, their choice-table dependent product, and missing slice coverage."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1040 500\" role=\"img\"><title>finite dependent sums and products</title><desc>Two uneven fibers sit over a base. Green arrows collect every tagged fiber value into the dependent sum. Blue arrows select one value from each fiber to form two dependent-product choices. A dashed red slice certificate shows that local cartesian closure is not established.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.choice{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:4}.bad{stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(105px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(105px)}}</style><rect width=\"1040\" height=\"500\" fill=\"rgb(26,27,38)\"/><text x=\"260\" y=\"28\" text-anchor=\"middle\">FAMILY OVER B = {cold, warm}</text><rect class=\"obj\" x=\"45\" y=\"55\" width=\"190\" height=\"75\" rx=\"12\"/><rect class=\"obj\" x=\"285\" y=\"55\" width=\"190\" height=\"75\" rx=\"12\"/><text x=\"140\" y=\"82\" text-anchor=\"middle\">fiber cold (size 2)</text><text x=\"140\" y=\"108\" text-anchor=\"middle\">{coat, hat}</text><text x=\"380\" y=\"82\" text-anchor=\"middle\">fiber warm (size 1)</text><text x=\"380\" y=\"108\" text-anchor=\"middle\">{shirt}</text><rect class=\"obj\" x=\"150\" y=\"220\" width=\"220\" height=\"70\" rx=\"12\"/><text x=\"260\" y=\"248\" text-anchor=\"middle\">Σ family</text><text x=\"260\" y=\"272\" text-anchor=\"middle\">all 3 tagged values</text><line class=\"arrow\" x1=\"140\" y1=\"130\" x2=\"220\" y2=\"220\"/><line class=\"arrow\" x1=\"380\" y1=\"130\" x2=\"300\" y2=\"220\"/><circle class=\"token\" cx=\"140\" cy=\"145\" r=\"8\"/><text x=\"780\" y=\"28\" text-anchor=\"middle\">Π family = ONE CHOICE PER FIBER</text><rect class=\"obj\" x=\"590\" y=\"55\" width=\"380\" height=\"105\" rx=\"12\"/><text x=\"780\" y=\"88\" text-anchor=\"middle\">(coat,shirt)</text><text x=\"780\" y=\"116\" text-anchor=\"middle\">(hat,shirt)</text><text x=\"780\" y=\"144\" text-anchor=\"middle\">2 choice rows = 2 × 1</text><line class=\"choice\" x1=\"475\" y1=\"92\" x2=\"590\" y2=\"92\"/><text x=\"520\" y=\"80\" text-anchor=\"middle\">choose</text><line class=\"bad\" x1=\"80\" y1=\"380\" x2=\"960\" y2=\"380\"/><text x=\"520\" y=\"350\" text-anchor=\"middle\">LOCALLY CARTESIAN CLOSED? requires exponentials in EVERY slice</text><text x=\"520\" y=\"420\" text-anchor=\"middle\">coverage [1, 0]: one checked slice + one missing slice ≠ theorem</text><text x=\"520\" y=\"465\" text-anchor=\"middle\">flat storage: values + offsets [0,2] + sizes [2,1]</text></svg>" }
