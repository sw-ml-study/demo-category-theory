# lib/unique_universal_isomorphism.mlpl -- CT054 finite product fixture.
# loops: 0
def u:apply_four_point_map(function_table, inputs) { "Apply a finite function table to four explicit inputs."; [take(function_table, 0, take(inputs, 0, 0)), take(function_table, 0, take(inputs, 0, 1)), take(function_table, 0, take(inputs, 0, 2)), take(function_table, 0, take(inputs, 0, 3))] }
def u:compose_four_point_maps(first_map, second_map) { "Compose two four-point finite function tables."; u:apply_four_point_map(second_map, first_map) }
def u:product_comparison_map() { "Return the comparison map forced by matching both product projections."; [0, 2, 1, 3] }
def u:comparison_preserves_projections(comparison_map) { "Check both projections after mapping from standard pairs to swapped-storage pairs."; equal(u:apply_four_point_map([0, 0, 1, 1], comparison_map), [0, 1, 0, 1]) * equal(u:apply_four_point_map([0, 1, 0, 1], comparison_map), [0, 0, 1, 1]) }
def u:universal_candidates_are_uniquely_isomorphic(forward_map, backward_map) { "Check that forced comparison arrows preserve projections and compose to both identities."; identity_map = [0, 1, 2, 3]; u:comparison_preserves_projections(forward_map) * u:comparison_preserves_projections(backward_map) * equal(u:compose_four_point_maps(forward_map, backward_map), identity_map) * equal(u:compose_four_point_maps(backward_map, forward_map), identity_map) }
def u:unique_universal_failure_witness(candidate_map) { "Report whether a competing comparison arrow fails the required projections."; {found: 1 - u:comparison_preserves_projections(candidate_map), expected: u:product_comparison_map(), actual: candidate_map} }
def u:unique_universal_isomorphism_diagram() { "Return the directed diagram of forced inverse comparison arrows."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 860 330\" role=\"img\"><title>unique universal isomorphism</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:8 6}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(390px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(390px)}}</style><rect width=\"860\" height=\"330\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"85\" y=\"65\" width=\"200\" height=\"70\" rx=\"13\"/><rect class=\"obj\" x=\"575\" y=\"65\" width=\"200\" height=\"70\" rx=\"13\"/><rect class=\"obj\" x=\"330\" y=\"245\" width=\"200\" height=\"55\" rx=\"13\"/><path class=\"arrow\" d=\"M285 82C380 25 480 25 575 82\"/><path class=\"arrow\" d=\"M575 120C480 180 380 180 285 120\"/><line class=\"arrow\" x1=\"230\" y1=\"135\" x2=\"380\" y2=\"245\"/><line class=\"arrow\" x1=\"630\" y1=\"135\" x2=\"480\" y2=\"245\"/><path class=\"bad\" d=\"M285 100L575 100\"/><text x=\"185\" y=\"107\" text-anchor=\"middle\">P = pairs</text><text x=\"675\" y=\"107\" text-anchor=\"middle\">Q = swapped storage</text><text x=\"430\" y=\"42\" text-anchor=\"middle\">forced u</text><text x=\"430\" y=\"190\" text-anchor=\"middle\">forced v; inverse both ways</text><text x=\"430\" y=\"278\" text-anchor=\"middle\">same projections</text><circle class=\"token\" cx=\"225\" cy=\"70\" r=\"8\"/></svg>" }
