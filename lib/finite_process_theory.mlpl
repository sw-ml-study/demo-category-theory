# lib/finite_process_theory.mlpl -- typed state, channel, effect, and classical structure.
# loops: 0
def u:process_boundaries_compose(first_target, second_source, second_target, third_source) {
  "Check both typed handoffs in the displayed state-channel-effect process workflow.";
  equal(first_target, second_source) * equal(second_target, third_source)
}
def u:state_and_effect_directions_hold(state_source, state_target, effect_source, effect_target) {
  "Require a state to point from unit into a system and an effect to point from a system into unit.";
  equal(state_source, ["I"]) * equal(state_target, ["A"]) * equal(effect_source, ["B"]) * equal(effect_target, ["I"])
}
def u:channel_behavior_matches(actual_outputs, expected_outputs) {
  "Compare the finite A-to-B channel output table with its expected behavior.";
  equal(actual_outputs, expected_outputs)
}
def u:classical_structure_obligations_hold(copy_present, delete_present, frobenius_present, specialness_present) {
  "Require copy, delete, Frobenius, and specialness evidence before packaging the attributed bit fixture as classical structure.";
  copy_present * delete_present * frobenius_present * specialness_present
}
def u:finite_process_theory_visual() {
  "Render a directed state-channel-effect process and a separately gated classical copy-delete panel.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1120 620\" role=\"img\"><title>finite process theory and classical structure</title><desc>A state prepares system A from the unit, a channel maps A to B, and an effect consumes B into the unit. A separate attributed classical-bit panel shows copy and delete only when Frobenius and specialness evidence are present.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.other{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:4;fill:none}.bad{stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:10 7;fill:none}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(180px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(180px)}}</style><rect width=\"1120\" height=\"620\" fill=\"rgb(26,27,38)\"/><text x=\"560\" y=\"35\" text-anchor=\"middle\">TYPED PROCESS WORKFLOW</text><rect class=\"obj\" x=\"60\" y=\"105\" width=\"100\" height=\"65\" rx=\"10\"/><rect class=\"obj\" x=\"260\" y=\"105\" width=\"170\" height=\"65\" rx=\"10\"/><rect class=\"obj\" x=\"520\" y=\"105\" width=\"170\" height=\"65\" rx=\"10\"/><rect class=\"obj\" x=\"790\" y=\"105\" width=\"170\" height=\"65\" rx=\"10\"/><rect class=\"obj\" x=\"1020\" y=\"105\" width=\"70\" height=\"65\" rx=\"10\"/><text x=\"110\" y=\"145\" text-anchor=\"middle\">I</text><text x=\"345\" y=\"145\" text-anchor=\"middle\">state: I→A</text><text x=\"605\" y=\"145\" text-anchor=\"middle\">channel: A→B</text><text x=\"875\" y=\"145\" text-anchor=\"middle\">effect: B→I</text><text x=\"1055\" y=\"145\" text-anchor=\"middle\">I</text><path class=\"arrow\" d=\"M160 137H260\"/><path class=\"arrow\" d=\"M430 137H520\"/><path class=\"arrow\" d=\"M690 137H790\"/><path class=\"arrow\" d=\"M960 137H1020\"/><text x=\"475\" y=\"120\" text-anchor=\"middle\">A</text><text x=\"740\" y=\"120\" text-anchor=\"middle\">B</text><circle class=\"token\" cx=\"175\" cy=\"137\" r=\"7\"/><text x=\"560\" y=\"230\" text-anchor=\"middle\">state prepares; channel transforms; effect observes</text><text x=\"560\" y=\"300\" text-anchor=\"middle\">ATTRIBUTED CLASSICAL-BIT STRUCTURE</text><rect class=\"obj\" x=\"120\" y=\"345\" width=\"360\" height=\"150\" rx=\"14\"/><text x=\"300\" y=\"380\" text-anchor=\"middle\">copy δ: bit → bit⊗bit</text><path class=\"other\" d=\"M210 425H290L390 395\"/><path class=\"other\" d=\"M290 425L390 455\"/><text x=\"300\" y=\"480\" text-anchor=\"middle\">delete ε: bit → I</text><rect class=\"obj\" x=\"640\" y=\"345\" width=\"360\" height=\"150\" rx=\"14\"/><text x=\"820\" y=\"385\" text-anchor=\"middle\">required evidence</text><text x=\"820\" y=\"425\" text-anchor=\"middle\">copy ✓  delete ✓</text><text x=\"820\" y=\"465\" text-anchor=\"middle\">Frobenius ✓  specialness ✓</text><rect class=\"bad\" x=\"330\" y=\"535\" width=\"460\" height=\"50\" rx=\"9\"/><text x=\"560\" y=\"567\" text-anchor=\"middle\">missing any obligation blocks classical structure</text><text x=\"560\" y=\"610\" text-anchor=\"middle\">categorical packaging; sibling owns algebra classification</text></svg>"
}
