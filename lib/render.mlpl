# lib/render.mlpl -- shared category-diagram SVG and CLI narration.
#
# Rounded boxes are objects, arrows are functions, and colored tokens retain
# identity along a path. Animations finish on a meaningful static frame and
# are disabled by prefers-reduced-motion.
# loops: 0

def u:concatenate_text(a, b) { "Compute concatenate text for this executable category-theory example.";  decode_bytes(concat(tokenize_bytes(a), tokenize_bytes(b))) }
def u:wrap_svg(body) { "Compute wrap svg for this executable category-theory example.";
  u:concatenate_text("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 260\" width=\"760\" height=\"260\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4;marker-end:url(#a)}.token{fill:#f7768e;animation:travel 3s ease-in-out infinite alternate}@keyframes travel{to{transform:translateX(480px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(480px)}}</style><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"#9ece6a\"/></marker></defs><rect width=\"760\" height=\"260\" fill=\"#1a1b26\"/>", u:concatenate_text(body, "</svg>"))
}
def u:render_object(x, label) { "Compute render object for this executable category-theory example.";  u:concatenate_text(u:concatenate_text("<rect class=\"obj\" x=\"", x), u:concatenate_text("\" y=\"80\" width=\"150\" height=\"90\" rx=\"16\"/><text x=\"", u:concatenate_text(x, u:concatenate_text("\" y=\"125\" text-anchor=\"middle\" dx=\"75\" font-size=\"20\">", u:concatenate_text(label, "</text>"))))) }
def u:base_arrow(label) { "Compute base arrow for this executable category-theory example.";  u:concatenate_text("<line class=\"arrow\" x1=\"230\" y1=\"125\" x2=\"530\" y2=\"125\"/><text x=\"380\" y=\"105\" text-anchor=\"middle\" font-size=\"18\">", u:concatenate_text(label, "</text>")) }
def u:arrow_diagram() { "Compute arrow diagram for this executable category-theory example.";  u:wrap_svg(u:concatenate_text(u:render_object("80", "Numbers"), u:concatenate_text(u:render_object("530", "Numbers"), u:concatenate_text(u:base_arrow("double"), "<circle class=\"token\" cx=\"210\" cy=\"145\" r=\"12\"/><text x=\"80\" y=\"35\" font-size=\"19\">One input keeps its identity while its value changes: 3 -&gt; 6</text>")))) }
def u:identity_diagram() { "Compute identity diagram for this executable category-theory example.";  u:wrap_svg(u:concatenate_text(u:render_object("80", "A"), u:concatenate_text(u:render_object("530", "B"), u:concatenate_text(u:base_arrow("id ; f = f = f ; id"), "<circle class=\"token\" cx=\"210\" cy=\"145\" r=\"12\"/><path d=\"M140 80 C90 20 240 20 190 80\" fill=\"none\" class=\"arrow\"/><text x=\"165\" y=\"28\" text-anchor=\"middle\">id</text>")))) }
def u:associativity_diagram() { "Compute associativity diagram for this executable category-theory example.";  u:wrap_svg("<text x=\"30\" y=\"30\" font-size=\"18\">(f ; g) ; h and f ; (g ; h) visit the same objects and finish together</text><rect class=\"obj\" x=\"35\" y=\"90\" width=\"120\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"220\" y=\"90\" width=\"120\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"405\" y=\"90\" width=\"120\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"590\" y=\"90\" width=\"120\" height=\"70\" rx=\"14\"/><text x=\"95\" y=\"130\" text-anchor=\"middle\">A</text><text x=\"280\" y=\"130\" text-anchor=\"middle\">B</text><text x=\"465\" y=\"130\" text-anchor=\"middle\">C</text><text x=\"650\" y=\"130\" text-anchor=\"middle\">D</text><line class=\"arrow\" x1=\"155\" y1=\"125\" x2=\"220\" y2=\"125\"/><line class=\"arrow\" x1=\"340\" y1=\"125\" x2=\"405\" y2=\"125\"/><line class=\"arrow\" x1=\"525\" y1=\"125\" x2=\"590\" y2=\"125\"/><text x=\"188\" y=\"108\">f</text><text x=\"373\" y=\"108\">g</text><text x=\"558\" y=\"108\">h</text><circle class=\"token\" cx=\"140\" cy=\"145\" r=\"12\"/>") }
def u:associativity_trees_diagram() { "Render two distinct composition trees above their common three-arrow path."; u:wrap_svg("<text x=\"190\" y=\"24\" text-anchor=\"middle\">LEFT: compose(compose(f,g),h)</text><text x=\"570\" y=\"24\" text-anchor=\"middle\">RIGHT: compose(f,compose(g,h))</text><g><rect class=\"obj\" x=\"130\" y=\"45\" width=\"120\" height=\"42\" rx=\"10\"/><text x=\"190\" y=\"72\" text-anchor=\"middle\">compose</text><line class=\"arrow\" x1=\"170\" y1=\"87\" x2=\"115\" y2=\"125\"/><line class=\"arrow\" x1=\"210\" y1=\"87\" x2=\"270\" y2=\"125\"/><rect class=\"obj\" x=\"55\" y=\"125\" width=\"120\" height=\"42\" rx=\"10\"/><text x=\"115\" y=\"152\" text-anchor=\"middle\">compose</text><text x=\"270\" y=\"152\" text-anchor=\"middle\">h</text><text x=\"75\" y=\"205\">f</text><text x=\"145\" y=\"205\">g</text><line class=\"arrow\" x1=\"95\" y1=\"167\" x2=\"75\" y2=\"190\"/><line class=\"arrow\" x1=\"135\" y1=\"167\" x2=\"145\" y2=\"190\"/></g><g><rect class=\"obj\" x=\"510\" y=\"45\" width=\"120\" height=\"42\" rx=\"10\"/><text x=\"570\" y=\"72\" text-anchor=\"middle\">compose</text><line class=\"arrow\" x1=\"550\" y1=\"87\" x2=\"490\" y2=\"125\"/><line class=\"arrow\" x1=\"590\" y1=\"87\" x2=\"650\" y2=\"125\"/><text x=\"490\" y=\"152\" text-anchor=\"middle\">f</text><rect class=\"obj\" x=\"590\" y=\"125\" width=\"120\" height=\"42\" rx=\"10\"/><text x=\"650\" y=\"152\" text-anchor=\"middle\">compose</text><text x=\"620\" y=\"205\">g</text><text x=\"690\" y=\"205\">h</text><line class=\"arrow\" x1=\"630\" y1=\"167\" x2=\"620\" y2=\"190\"/><line class=\"arrow\" x1=\"670\" y1=\"167\" x2=\"690\" y2=\"190\"/></g><text x=\"380\" y=\"232\" text-anchor=\"middle\">BOTH EVALUATE THE SAME PATH</text><text x=\"85\" y=\"258\">A</text><text x=\"270\" y=\"258\">B</text><text x=\"455\" y=\"258\">C</text><text x=\"640\" y=\"258\">D</text><line class=\"arrow\" x1=\"105\" y1=\"252\" x2=\"250\" y2=\"252\"/><line class=\"arrow\" x1=\"290\" y1=\"252\" x2=\"435\" y2=\"252\"/><line class=\"arrow\" x1=\"475\" y1=\"252\" x2=\"620\" y2=\"252\"/><text x=\"178\" y=\"244\">f</text><text x=\"363\" y=\"244\">g</text><text x=\"548\" y=\"244\">h</text><circle class=\"token\" cx=\"100\" cy=\"270\" r=\"10\"/>") }
def u:square_diagram() { "Compute square diagram for this executable category-theory example.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 390\" width=\"900\" height=\"390\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{fill:none;stroke:#7aa2f7;stroke-width:4}.token{fill:#f7768e}.good{fill:none;stroke:#9ece6a;stroke-width:8}.bad{fill:none;stroke:#f7768e;stroke-width:8}.route{fill:none;stroke:none}@media(prefers-reduced-motion:reduce){animateMotion{display:none}.start{display:none}.finish{display:inline}}@media(prefers-reduced-motion:no-preference){.finish{display:none}}</style><rect width=\"900\" height=\"390\" fill=\"#1a1b26\"/><text x=\"225\" y=\"28\" text-anchor=\"middle\" font-size=\"20\">COMMUTES: both routes end at 2</text><text x=\"675\" y=\"28\" text-anchor=\"middle\" font-size=\"20\">BROKEN: 2 != 1 for input 0</text><g id=\"lawful\"><rect class=\"obj\" x=\"55\" y=\"55\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"285\" y=\"55\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"55\" y=\"255\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"285\" y=\"255\" width=\"110\" height=\"65\" rx=\"13\"/><path class=\"arrow\" d=\"M165 87H285M110 120V255M340 120V255M165 287H285\"/><text x=\"225\" y=\"78\">+1</text><text x=\"78\" y=\"190\">x2</text><text x=\"350\" y=\"190\">x2</text><text x=\"225\" y=\"278\">+2</text><path id=\"lu\" class=\"route\" d=\"M110 88H340V287\"/><path id=\"ll\" class=\"route\" d=\"M110 88V287H340\"/><circle class=\"token start\" r=\"10\"><animateMotion dur=\"4s\" repeatCount=\"indefinite\"><mpath href=\"#lu\"/></animateMotion></circle><circle class=\"token start\" r=\"7\"><animateMotion dur=\"4s\" repeatCount=\"indefinite\"><mpath href=\"#ll\"/></animateMotion></circle><circle class=\"good\" cx=\"340\" cy=\"287\" r=\"28\"/><circle class=\"token finish\" cx=\"340\" cy=\"287\" r=\"10\"/></g><g id=\"broken\" transform=\"translate(450 0)\"><rect class=\"obj\" x=\"55\" y=\"55\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"285\" y=\"55\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"55\" y=\"255\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"285\" y=\"255\" width=\"110\" height=\"65\" rx=\"13\"/><path class=\"arrow\" d=\"M165 87H285M110 120V255M340 120V255M165 287H285\"/><text x=\"225\" y=\"78\">+1</text><text x=\"78\" y=\"190\">x2</text><text x=\"350\" y=\"190\">x2</text><text x=\"225\" y=\"278\">+1 (wrong)</text><circle class=\"bad\" cx=\"325\" cy=\"287\" r=\"22\"/><circle class=\"bad\" cx=\"365\" cy=\"287\" r=\"22\"/><text x=\"325\" y=\"292\" text-anchor=\"middle\">2</text><text x=\"365\" y=\"292\" text-anchor=\"middle\">1</text><circle class=\"token\" cx=\"110\" cy=\"88\" r=\"10\"/></g><text x=\"450\" y=\"365\" text-anchor=\"middle\">green halo = equal arrivals; split red halos = concrete witness</text></svg>"
}
def u:product_diagram() { "Compute product diagram for this executable category-theory example.";  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" width=\"760\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{fill:none;stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translate(0,100px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(0,100px)}}</style><rect width=\"760\" height=\"300\" fill=\"#1a1b26\"/><text x=\"380\" y=\"28\" text-anchor=\"middle\" font-size=\"19\">two projections force one pair</text><rect class=\"obj\" x=\"305\" y=\"55\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"90\" y=\"210\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"520\" y=\"210\" width=\"150\" height=\"65\" rx=\"14\"/><path class=\"arrow\" d=\"M330 120L210 210M430 120L550 210\"/><text x=\"255\" y=\"160\">fst = 3</text><text x=\"470\" y=\"160\">snd = 8</text><text x=\"380\" y=\"93\" text-anchor=\"middle\">pair(3,8)</text><text x=\"165\" y=\"247\" text-anchor=\"middle\">3</text><text x=\"595\" y=\"247\" text-anchor=\"middle\">8</text><circle class=\"token\" cx=\"380\" cy=\"105\" r=\"10\"/></svg>" }
def u:coproduct_diagram() { "Compute coproduct diagram for this executable category-theory example.";  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" width=\"760\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{fill:none;stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translate(0,100px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(0,100px)}}</style><rect width=\"760\" height=\"300\" fill=\"#1a1b26\"/><text x=\"380\" y=\"28\" text-anchor=\"middle\" font-size=\"19\">two tagged entrances determine one case map</text><rect class=\"obj\" x=\"90\" y=\"55\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"520\" y=\"55\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"305\" y=\"210\" width=\"150\" height=\"65\" rx=\"14\"/><path class=\"arrow\" d=\"M210 120L350 210M550 120L410 210\"/><text x=\"260\" y=\"160\">left</text><text x=\"485\" y=\"160\">right</text><text x=\"165\" y=\"93\" text-anchor=\"middle\">3 -&gt; 4</text><text x=\"595\" y=\"93\" text-anchor=\"middle\">3 -&gt; -3</text><text x=\"380\" y=\"247\" text-anchor=\"middle\">case(left,right)</text><circle class=\"token\" cx=\"165\" cy=\"105\" r=\"10\"/></svg>" }
def u:functor_diagram() { "Compute functor diagram for this executable category-theory example.";  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 330\" width=\"800\" height=\"330\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(420px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(420px)}}</style><rect width=\"800\" height=\"330\" fill=\"#1a1b26\"/><text x=\"400\" y=\"28\" text-anchor=\"middle\">scalar arrows and lifted array arrows move together</text><rect class=\"obj\" x=\"80\" y=\"55\" width=\"160\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"560\" y=\"55\" width=\"160\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"80\" y=\"220\" width=\"160\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"560\" y=\"220\" width=\"160\" height=\"65\" rx=\"14\"/><line class=\"arrow\" x1=\"240\" y1=\"87\" x2=\"560\" y2=\"87\"/><line class=\"arrow\" x1=\"240\" y1=\"252\" x2=\"560\" y2=\"252\"/><text x=\"400\" y=\"75\" text-anchor=\"middle\">g after f</text><text x=\"400\" y=\"240\" text-anchor=\"middle\">each(g) after each(f)</text><text x=\"160\" y=\"93\" text-anchor=\"middle\">1</text><text x=\"640\" y=\"93\" text-anchor=\"middle\">4</text><text x=\"160\" y=\"258\" text-anchor=\"middle\">[1,2,3]</text><text x=\"640\" y=\"258\" text-anchor=\"middle\">[4,6,8]</text><circle class=\"token\" cx=\"220\" cy=\"105\" r=\"9\"/></svg>" }
def u:shape_diagram() { "Compute shape diagram for this executable category-theory example.";  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 300\" width=\"800\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(420px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(420px)}}</style><rect width=\"800\" height=\"300\" fill=\"#1a1b26\"/><text x=\"400\" y=\"28\" text-anchor=\"middle\">map changes cells, not the 2 x 3 container</text><rect class=\"obj\" x=\"70\" y=\"70\" width=\"210\" height=\"150\" rx=\"14\"/><rect class=\"obj\" x=\"520\" y=\"70\" width=\"210\" height=\"150\" rx=\"14\"/><line class=\"arrow\" x1=\"280\" y1=\"145\" x2=\"520\" y2=\"145\"/><text x=\"400\" y=\"130\" text-anchor=\"middle\">each(+1)</text><text x=\"175\" y=\"125\" text-anchor=\"middle\">1 2 3</text><text x=\"175\" y=\"165\" text-anchor=\"middle\">4 5 6</text><text x=\"625\" y=\"125\" text-anchor=\"middle\">2 3 4</text><text x=\"625\" y=\"165\" text-anchor=\"middle\">5 6 7</text><text x=\"175\" y=\"205\" text-anchor=\"middle\">shape 2 x 3</text><text x=\"625\" y=\"205\" text-anchor=\"middle\">shape 2 x 3</text><circle class=\"token\" cx=\"260\" cy=\"165\" r=\"9\"/></svg>" }
def u:naturality_diagram() { "Compute naturality diagram for this executable category-theory example.";  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 380\" width=\"900\" height=\"380\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{fill:none;stroke:#7aa2f7;stroke-width:4}.token{fill:#f7768e;animation:p 4s infinite alternate}.good{fill:none;stroke:#9ece6a;stroke-width:7}.bad{fill:none;stroke:#f7768e;stroke-width:7}@keyframes p{to{transform:translate(170px,150px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(170px,150px)}}</style><rect width=\"900\" height=\"380\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\" font-size=\"19\">transpose is natural: every cellwise map commutes with the component</text><g><text x=\"220\" y=\"55\" text-anchor=\"middle\">2x3 component</text><rect class=\"obj\" x=\"80\" y=\"75\" width=\"120\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"280\" y=\"75\" width=\"120\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"80\" y=\"255\" width=\"120\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"280\" y=\"255\" width=\"120\" height=\"60\" rx=\"12\"/><path class=\"arrow\" d=\"M200 105H280M140 135V255M340 135V255M200 285H280\"/><text x=\"240\" y=\"95\">each(f)</text><text x=\"95\" y=\"200\">T</text><text x=\"350\" y=\"200\">T</text><circle class=\"good\" cx=\"340\" cy=\"285\" r=\"24\"/><circle class=\"token\" cx=\"140\" cy=\"105\" r=\"9\"/></g><g transform=\"translate(440 0)\"><text x=\"220\" y=\"55\" text-anchor=\"middle\">broken component</text><rect class=\"obj\" x=\"80\" y=\"75\" width=\"120\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"280\" y=\"75\" width=\"120\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"80\" y=\"255\" width=\"120\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"280\" y=\"255\" width=\"120\" height=\"60\" rx=\"12\"/><path class=\"arrow\" d=\"M200 105H280M140 135V255M340 135V255M200 285H280\"/><text x=\"240\" y=\"95\">each(x2)</text><text x=\"80\" y=\"200\">T,+1</text><circle class=\"bad\" cx=\"325\" cy=\"285\" r=\"21\"/><circle class=\"bad\" cx=\"365\" cy=\"285\" r=\"21\"/><text x=\"325\" y=\"291\" text-anchor=\"middle\">3</text><text x=\"365\" y=\"291\" text-anchor=\"middle\">4</text></g><text x=\"450\" y=\"355\" text-anchor=\"middle\">green = naturality; red = first cell differs after one bad component</text></svg>" }
def u:hom_diagram() { "Compute hom diagram for this executable category-theory example.";  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 280\" width=\"800\" height=\"280\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(450px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(450px)}}</style><rect width=\"800\" height=\"280\" fill=\"#1a1b26\"/><text x=\"400\" y=\"30\" text-anchor=\"middle\">identity and composition keep structure-preserving arrows inside the category</text><rect class=\"obj\" x=\"55\" y=\"90\" width=\"160\" height=\"100\" rx=\"14\"/><rect class=\"obj\" x=\"320\" y=\"90\" width=\"160\" height=\"100\" rx=\"14\"/><rect class=\"obj\" x=\"585\" y=\"90\" width=\"160\" height=\"100\" rx=\"14\"/><line class=\"arrow\" x1=\"215\" y1=\"140\" x2=\"320\" y2=\"140\"/><line class=\"arrow\" x1=\"480\" y1=\"140\" x2=\"585\" y2=\"140\"/><text x=\"135\" y=\"145\" text-anchor=\"middle\">Z4</text><text x=\"400\" y=\"145\" text-anchor=\"middle\">Z4</text><text x=\"665\" y=\"145\" text-anchor=\"middle\">Z2</text><text x=\"267\" y=\"125\">id</text><text x=\"532\" y=\"125\">parity</text><circle class=\"token\" cx=\"195\" cy=\"165\" r=\"10\"/></svg>" }
def u:reduction_diagram() { "Compute reduction diagram for this executable category-theory example.";  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 850 330\" width=\"850\" height=\"330\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(80px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(80px)}}</style><rect width=\"850\" height=\"330\" fill=\"#1a1b26\"/><text x=\"425\" y=\"28\" text-anchor=\"middle\">associativity turns a serial fold into a parallel tree</text><g><text x=\"210\" y=\"60\" text-anchor=\"middle\">serial: (((8+4)+2)+1) = 15</text><rect class=\"obj\" x=\"55\" y=\"90\" width=\"310\" height=\"150\" rx=\"14\"/><text x=\"210\" y=\"150\" text-anchor=\"middle\">8 + 4 -&gt; 12 -&gt; 14 -&gt; 15</text><line class=\"arrow\" x1=\"100\" y1=\"190\" x2=\"320\" y2=\"190\"/></g><g><text x=\"640\" y=\"60\" text-anchor=\"middle\">parallel: (8+4) + (2+1) = 15</text><rect class=\"obj\" x=\"485\" y=\"90\" width=\"310\" height=\"150\" rx=\"14\"/><text x=\"565\" y=\"145\">8+4=12</text><text x=\"685\" y=\"145\">2+1=3</text><text x=\"640\" y=\"210\" text-anchor=\"middle\">12+3=15</text><line class=\"arrow\" x1=\"565\" y1=\"160\" x2=\"625\" y2=\"200\"/><line class=\"arrow\" x1=\"715\" y1=\"160\" x2=\"655\" y2=\"200\"/><circle class=\"token\" cx=\"565\" cy=\"120\" r=\"9\"/></g><text x=\"425\" y=\"290\" text-anchor=\"middle\">subtraction warns why the law matters: serial 1, regrouped 3</text></svg>" }
def u:context_map_diagram() { "Render success and failure tracks for contextual mapping."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 300\" width=\"820\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.failed{stroke:#f7768e}.token{fill:#f7768e;animation:contextTravel 3s infinite alternate}@keyframes contextTravel{to{transform:translateX(430px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(430px)}}</style><rect width=\"820\" height=\"300\" fill=\"#1a1b26\"/><text x=\"410\" y=\"28\" text-anchor=\"middle\">context map transforms success and preserves failure</text><rect class=\"obj\" x=\"55\" y=\"65\" width=\"170\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"595\" y=\"65\" width=\"170\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"225\" y1=\"100\" x2=\"595\" y2=\"100\"/><text x=\"140\" y=\"107\" text-anchor=\"middle\">success 3</text><text x=\"680\" y=\"107\" text-anchor=\"middle\">success 4</text><text x=\"410\" y=\"87\" text-anchor=\"middle\">map increment</text><rect class=\"obj\" x=\"55\" y=\"190\" width=\"170\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"595\" y=\"190\" width=\"170\" height=\"70\" rx=\"14\"/><line class=\"arrow failed\" x1=\"225\" y1=\"225\" x2=\"595\" y2=\"225\"/><text x=\"140\" y=\"232\" text-anchor=\"middle\">failure: bad</text><text x=\"680\" y=\"232\" text-anchor=\"middle\">failure: bad</text><text x=\"410\" y=\"212\" text-anchor=\"middle\">payload skipped</text><circle class=\"token\" cx=\"205\" cy=\"120\" r=\"9\"/></svg>" }
def u:kleisli_pipeline_diagram() { "Render successful and short-circuited fallible pipelines."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 330\" width=\"900\" height=\"330\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.failed{stroke:#f7768e}.token{fill:#f7768e;animation:pipelineTravel 4s infinite alternate}@keyframes pipelineTravel{to{transform:translateX(600px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(600px)}}</style><rect width=\"900\" height=\"330\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\">Kleisli composition connects stages that may fail</text><g><rect class=\"obj\" x=\"40\" y=\"65\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"300\" y=\"65\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"560\" y=\"65\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"760\" y=\"65\" width=\"110\" height=\"65\" rx=\"14\"/><line class=\"arrow\" x1=\"190\" y1=\"97\" x2=\"300\" y2=\"97\"/><line class=\"arrow\" x1=\"450\" y1=\"97\" x2=\"560\" y2=\"97\"/><line class=\"arrow\" x1=\"710\" y1=\"97\" x2=\"760\" y2=\"97\"/><text x=\"115\" y=\"104\" text-anchor=\"middle\">input 4</text><text x=\"375\" y=\"104\" text-anchor=\"middle\">positive: 8</text><text x=\"635\" y=\"104\" text-anchor=\"middle\">even: 4</text><text x=\"815\" y=\"104\" text-anchor=\"middle\">+10: 14</text></g><g><rect class=\"obj\" x=\"40\" y=\"205\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"300\" y=\"205\" width=\"150\" height=\"65\" rx=\"14\"/><line class=\"arrow failed\" x1=\"190\" y1=\"237\" x2=\"300\" y2=\"237\"/><text x=\"115\" y=\"244\" text-anchor=\"middle\">input -1</text><text x=\"375\" y=\"244\" text-anchor=\"middle\">failure: positive</text><text x=\"600\" y=\"244\" text-anchor=\"middle\" fill=\"#f7768e\">later stages do not run</text></g><circle class=\"token\" cx=\"170\" cy=\"117\" r=\"9\"/></svg>" }
def u:independent_context_diagram() { "Render two independent contextual computations converging into one product."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 860 300\" width=\"860\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:join 3s infinite alternate}@keyframes join{to{transform:translateX(350px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(350px)}}</style><rect width=\"860\" height=\"300\" fill=\"#1a1b26\"/><text x=\"430\" y=\"28\" text-anchor=\"middle\">independent results combine only after both contexts succeed</text><rect class=\"obj\" x=\"55\" y=\"65\" width=\"220\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"55\" y=\"185\" width=\"220\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"590\" y=\"115\" width=\"220\" height=\"90\" rx=\"14\"/><line class=\"arrow\" x1=\"275\" y1=\"100\" x2=\"590\" y2=\"145\"/><line class=\"arrow\" x1=\"275\" y1=\"220\" x2=\"590\" y2=\"175\"/><text x=\"165\" y=\"107\" text-anchor=\"middle\">row count: success 120</text><text x=\"165\" y=\"227\" text-anchor=\"middle\">threshold: success 0.8</text><text x=\"700\" y=\"155\" text-anchor=\"middle\">product</text><text x=\"700\" y=\"182\" text-anchor=\"middle\">{120, 0.8}</text><circle class=\"token\" cx=\"255\" cy=\"120\" r=\"9\"/></svg>" }
def u:dependent_context_diagram() { "Render a contextual computation whose later decision requires the earlier result."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 860 300\" width=\"860\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.failed{stroke:#f7768e}.token{fill:#f7768e;animation:depend 4s infinite alternate}@keyframes depend{to{transform:translateX(570px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(570px)}}</style><rect width=\"860\" height=\"300\" fill=\"#1a1b26\"/><text x=\"430\" y=\"28\" text-anchor=\"middle\">bind passes the earlier row count into the later batching decision</text><rect class=\"obj\" x=\"35\" y=\"60\" width=\"170\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"335\" y=\"60\" width=\"190\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"655\" y=\"60\" width=\"170\" height=\"65\" rx=\"14\"/><line class=\"arrow\" x1=\"205\" y1=\"92\" x2=\"335\" y2=\"92\"/><line class=\"arrow\" x1=\"525\" y1=\"92\" x2=\"655\" y2=\"92\"/><text x=\"120\" y=\"99\" text-anchor=\"middle\">dataset 7</text><text x=\"430\" y=\"99\" text-anchor=\"middle\">rows 120</text><text x=\"740\" y=\"99\" text-anchor=\"middle\">batches 12</text><rect class=\"obj\" x=\"35\" y=\"195\" width=\"170\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"335\" y=\"195\" width=\"220\" height=\"65\" rx=\"14\"/><line class=\"arrow failed\" x1=\"205\" y1=\"227\" x2=\"335\" y2=\"227\"/><text x=\"120\" y=\"234\" text-anchor=\"middle\">dataset -1</text><text x=\"445\" y=\"234\" text-anchor=\"middle\">failure: missing</text><text x=\"700\" y=\"234\" text-anchor=\"middle\">no batch decision</text><circle class=\"token\" cx=\"185\" cy=\"112\" r=\"9\"/></svg>" }
def u:fold_fusion_diagram() { "Render mapped values converging through a fused finite fold."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 860 300\" width=\"860\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:fold 3s infinite alternate}@keyframes fold{to{transform:translateX(500px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(500px)}}</style><rect width=\"860\" height=\"300\" fill=\"#1a1b26\"/><text x=\"430\" y=\"28\" text-anchor=\"middle\">linear map fuses with finite additive consumption</text><rect class=\"obj\" x=\"40\" y=\"65\" width=\"190\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"335\" y=\"65\" width=\"190\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"650\" y=\"65\" width=\"170\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"230\" y1=\"100\" x2=\"335\" y2=\"100\"/><line class=\"arrow\" x1=\"525\" y1=\"100\" x2=\"650\" y2=\"100\"/><text x=\"135\" y=\"107\" text-anchor=\"middle\">[2,4,6,8]</text><text x=\"430\" y=\"107\" text-anchor=\"middle\">double each</text><text x=\"735\" y=\"107\" text-anchor=\"middle\">sum = 40</text><rect class=\"obj\" x=\"250\" y=\"205\" width=\"360\" height=\"60\" rx=\"14\"/><text x=\"430\" y=\"242\" text-anchor=\"middle\">2 * sum([2,4,6,8]) = 40</text><circle class=\"token\" cx=\"210\" cy=\"120\" r=\"9\"/></svg>" }
def u:bounded_unfold_diagram() { "Render a seed expanding into a bounded sequence and regenerating from recovered parameters."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 860 300\" width=\"860\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:unfold 3s infinite alternate}@keyframes unfold{to{transform:translateX(510px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(510px)}}</style><rect width=\"860\" height=\"300\" fill=\"#1a1b26\"/><text x=\"430\" y=\"28\" text-anchor=\"middle\">bounded unfold grows a finite sequence from explicit parameters</text><rect class=\"obj\" x=\"45\" y=\"60\" width=\"190\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"625\" y=\"60\" width=\"190\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"235\" y1=\"95\" x2=\"625\" y2=\"95\"/><text x=\"140\" y=\"102\" text-anchor=\"middle\">seed 3, step 2</text><text x=\"720\" y=\"102\" text-anchor=\"middle\">[3,5,7,9]</text><text x=\"430\" y=\"82\" text-anchor=\"middle\">count 4</text><rect class=\"obj\" x=\"180\" y=\"205\" width=\"220\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"505\" y=\"205\" width=\"220\" height=\"60\" rx=\"14\"/><line class=\"arrow bad\" x1=\"400\" y1=\"235\" x2=\"505\" y2=\"235\"/><text x=\"290\" y=\"242\" text-anchor=\"middle\">irregular [3,5,8,9]</text><text x=\"615\" y=\"242\" text-anchor=\"middle\">regenerates [3,5,7,9]</text><circle class=\"token\" cx=\"215\" cy=\"115\" r=\"9\"/></svg>" }
def u:model_config_lens_diagram() { "Render lawful focus/update paths and one sibling-corrupting broken setter."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 330\" width=\"900\" height=\"330\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:lens 3s infinite alternate}@keyframes lens{to{transform:translateX(480px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(480px)}}</style><rect width=\"900\" height=\"330\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\">a lawful lens changes one focus and preserves its surroundings</text><rect class=\"obj\" x=\"35\" y=\"60\" width=\"250\" height=\"100\" rx=\"14\"/><rect class=\"obj\" x=\"615\" y=\"60\" width=\"250\" height=\"100\" rx=\"14\"/><line class=\"arrow\" x1=\"285\" y1=\"110\" x2=\"615\" y2=\"110\"/><text x=\"160\" y=\"95\" text-anchor=\"middle\">rate 0.01</text><text x=\"160\" y=\"125\" text-anchor=\"middle\">batch 32, version 3</text><text x=\"740\" y=\"95\" text-anchor=\"middle\">rate 0.02</text><text x=\"740\" y=\"125\" text-anchor=\"middle\">batch 32, version 3</text><text x=\"450\" y=\"92\" text-anchor=\"middle\">set focus</text><rect class=\"obj\" x=\"170\" y=\"220\" width=\"240\" height=\"75\" rx=\"14\"/><rect class=\"obj\" x=\"530\" y=\"220\" width=\"240\" height=\"75\" rx=\"14\"/><line class=\"arrow bad\" x1=\"410\" y1=\"257\" x2=\"530\" y2=\"257\"/><text x=\"290\" y=\"265\" text-anchor=\"middle\">get-put expects batch 32</text><text x=\"650\" y=\"265\" text-anchor=\"middle\">broken setter resets batch 1</text><circle class=\"token\" cx=\"265\" cy=\"130\" r=\"9\"/></svg>" }
def u:diagonal_product_adjunction_diagram() { "Render the diagonal/product triangle and a bad counit counterexample."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 340\" width=\"900\" height=\"340\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:triangle 4s infinite alternate}@keyframes triangle{to{transform:translateX(560px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(560px)}}</style><rect width=\"900\" height=\"340\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\">diagonal duplication is left adjoint to product</text><rect class=\"obj\" x=\"35\" y=\"60\" width=\"170\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"345\" y=\"60\" width=\"210\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"695\" y=\"60\" width=\"170\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"205\" y1=\"95\" x2=\"345\" y2=\"95\"/><line class=\"arrow\" x1=\"555\" y1=\"95\" x2=\"695\" y2=\"95\"/><text x=\"120\" y=\"102\" text-anchor=\"middle\">product (3,5)</text><text x=\"450\" y=\"88\" text-anchor=\"middle\">((3,5),(3,5))</text><text x=\"450\" y=\"113\" text-anchor=\"middle\">unit: duplicate</text><text x=\"780\" y=\"102\" text-anchor=\"middle\">counit: (3,5)</text><rect class=\"obj\" x=\"170\" y=\"225\" width=\"240\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"530\" y=\"225\" width=\"200\" height=\"70\" rx=\"14\"/><line class=\"arrow bad\" x1=\"410\" y1=\"260\" x2=\"530\" y2=\"260\"/><text x=\"290\" y=\"267\" text-anchor=\"middle\">bad counit selects left twice</text><text x=\"630\" y=\"267\" text-anchor=\"middle\">actual (3,3)</text><circle class=\"token\" cx=\"185\" cy=\"115\" r=\"9\"/></svg>" }
def u:opposite_duality_diagram() { "Render a finite category beside its arrow-reversed opposite and reversed path order."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 320\" width=\"900\" height=\"320\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:reverse 4s infinite alternate}@keyframes reverse{to{transform:translateX(220px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(220px)}}</style><rect width=\"900\" height=\"320\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\">the opposite category reverses arrows and composition order</text><g><text x=\"220\" y=\"65\" text-anchor=\"middle\">C: A -f-&gt; B -g-&gt; C</text><rect class=\"obj\" x=\"45\" y=\"95\" width=\"100\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"190\" y=\"95\" width=\"100\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"335\" y=\"95\" width=\"100\" height=\"65\" rx=\"14\"/><line class=\"arrow\" x1=\"145\" y1=\"127\" x2=\"190\" y2=\"127\"/><line class=\"arrow\" x1=\"290\" y1=\"127\" x2=\"335\" y2=\"127\"/></g><g transform=\"translate(450 0)\"><text x=\"220\" y=\"65\" text-anchor=\"middle\">C op: C -g op-&gt; B -f op-&gt; A</text><rect class=\"obj\" x=\"45\" y=\"95\" width=\"100\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"190\" y=\"95\" width=\"100\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"335\" y=\"95\" width=\"100\" height=\"65\" rx=\"14\"/><line class=\"arrow\" x1=\"145\" y1=\"127\" x2=\"190\" y2=\"127\"/><line class=\"arrow\" x1=\"290\" y1=\"127\" x2=\"335\" y2=\"127\"/></g><text x=\"450\" y=\"235\" text-anchor=\"middle\">transpose twice restores every arrow; [f,g,h] becomes [h,g,f]</text><circle class=\"token\" cx=\"95\" cy=\"147\" r=\"9\"/></svg>" }
def u:universal_endpoints_diagram() { "Render initial and terminal unique arrows plus a pointed-category zero object."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 340\" width=\"900\" height=\"340\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:endpoint 3s infinite alternate}@keyframes endpoint{to{transform:translateX(180px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(180px)}}</style><rect width=\"900\" height=\"340\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\">universal endpoints are defined by unique arrows</text><rect class=\"obj\" x=\"45\" y=\"65\" width=\"150\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"330\" y=\"65\" width=\"150\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"705\" y=\"65\" width=\"150\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"195\" y1=\"100\" x2=\"330\" y2=\"100\"/><line class=\"arrow\" x1=\"480\" y1=\"100\" x2=\"705\" y2=\"100\"/><text x=\"120\" y=\"107\" text-anchor=\"middle\">empty: initial</text><text x=\"405\" y=\"107\" text-anchor=\"middle\">any finite X</text><text x=\"780\" y=\"107\" text-anchor=\"middle\">singleton: terminal</text><rect class=\"obj\" x=\"150\" y=\"220\" width=\"190\" height=\"75\" rx=\"14\"/><rect class=\"obj\" x=\"560\" y=\"220\" width=\"190\" height=\"75\" rx=\"14\"/><line class=\"arrow\" x1=\"340\" y1=\"245\" x2=\"560\" y2=\"245\"/><line class=\"arrow bad\" x1=\"560\" y1=\"275\" x2=\"340\" y2=\"275\"/><text x=\"245\" y=\"264\" text-anchor=\"middle\">zero object 0</text><text x=\"655\" y=\"264\" text-anchor=\"middle\">pointed object A</text><text x=\"450\" y=\"320\" text-anchor=\"middle\">0 is both initial and terminal; ordinary FinSet has no zero object</text><circle class=\"token\" cx=\"175\" cy=\"120\" r=\"9\"/></svg>" }
def u:equalizer_diagram() { "Render parallel arrows narrowing to their largest agreeing input subset."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 880 320\" width=\"880\" height=\"320\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:eqz 3s infinite alternate}@keyframes eqz{to{transform:translateX(410px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(410px)}}</style><rect width=\"880\" height=\"320\" fill=\"#1a1b26\"/><text x=\"440\" y=\"28\" text-anchor=\"middle\">equalizer keeps exactly the inputs where parallel arrows agree</text><rect class=\"obj\" x=\"40\" y=\"80\" width=\"160\" height=\"75\" rx=\"14\"/><rect class=\"obj\" x=\"350\" y=\"80\" width=\"190\" height=\"75\" rx=\"14\"/><rect class=\"obj\" x=\"690\" y=\"80\" width=\"150\" height=\"75\" rx=\"14\"/><line class=\"arrow\" x1=\"200\" y1=\"117\" x2=\"350\" y2=\"117\"/><line class=\"arrow\" x1=\"540\" y1=\"100\" x2=\"690\" y2=\"100\"/><line class=\"arrow\" x1=\"540\" y1=\"135\" x2=\"690\" y2=\"135\"/><text x=\"120\" y=\"124\" text-anchor=\"middle\">E = [0,2]</text><text x=\"445\" y=\"124\" text-anchor=\"middle\">A = [0,1,2,3]</text><text x=\"765\" y=\"124\" text-anchor=\"middle\">B</text><text x=\"615\" y=\"88\">f</text><text x=\"615\" y=\"153\">g</text><rect class=\"obj\" x=\"250\" y=\"225\" width=\"380\" height=\"60\" rx=\"14\"/><line class=\"arrow bad\" x1=\"440\" y1=\"205\" x2=\"440\" y2=\"225\"/><text x=\"440\" y=\"262\" text-anchor=\"middle\">bad mediator includes 1 where f(1) != g(1)</text><circle class=\"token\" cx=\"180\" cy=\"137\" r=\"9\"/></svg>" }
def u:coequalizer_diagram() { "Render parallel arrows forcing output values into one quotient class."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 880 320\" width=\"880\" height=\"320\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:coeq 3s infinite alternate}@keyframes coeq{to{transform:translateX(410px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(410px)}}</style><rect width=\"880\" height=\"320\" fill=\"#1a1b26\"/><text x=\"440\" y=\"28\" text-anchor=\"middle\">coequalizer merges exactly the outputs forced equal by parallel arrows</text><rect class=\"obj\" x=\"40\" y=\"80\" width=\"150\" height=\"75\" rx=\"14\"/><rect class=\"obj\" x=\"340\" y=\"80\" width=\"190\" height=\"75\" rx=\"14\"/><rect class=\"obj\" x=\"690\" y=\"80\" width=\"150\" height=\"75\" rx=\"14\"/><line class=\"arrow\" x1=\"190\" y1=\"100\" x2=\"340\" y2=\"100\"/><line class=\"arrow\" x1=\"190\" y1=\"135\" x2=\"340\" y2=\"135\"/><line class=\"arrow\" x1=\"530\" y1=\"117\" x2=\"690\" y2=\"117\"/><text x=\"115\" y=\"124\" text-anchor=\"middle\">A = [0,1]</text><text x=\"435\" y=\"124\" text-anchor=\"middle\">B = [0,1,2]</text><text x=\"765\" y=\"124\" text-anchor=\"middle\">Q = one class</text><rect class=\"obj\" x=\"245\" y=\"225\" width=\"390\" height=\"60\" rx=\"14\"/><line class=\"arrow bad\" x1=\"440\" y1=\"205\" x2=\"440\" y2=\"225\"/><text x=\"440\" y=\"262\" text-anchor=\"middle\">bad map [7,8,7] separates a forced pair</text><circle class=\"token\" cx=\"170\" cy=\"155\" r=\"9\"/></svg>" }
def u:pullback_diagram() { "Render a keyed join as a commuting pullback square."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 300\" width=\"820\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translate(260px,120px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(260px,120px)}}</style><rect width=\"820\" height=\"300\" fill=\"#1a1b26\"/><text x=\"410\" y=\"28\" text-anchor=\"middle\">pullback joins rows whose projected keys agree</text><rect class=\"obj\" x=\"70\" y=\"55\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"570\" y=\"55\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"70\" y=\"205\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"570\" y=\"205\" width=\"180\" height=\"65\" rx=\"12\"/><line class=\"arrow\" x1=\"250\" y1=\"87\" x2=\"570\" y2=\"87\"/><line class=\"arrow\" x1=\"160\" y1=\"120\" x2=\"160\" y2=\"205\"/><line class=\"arrow\" x1=\"660\" y1=\"120\" x2=\"660\" y2=\"205\"/><line class=\"arrow bad\" x1=\"250\" y1=\"237\" x2=\"570\" y2=\"237\"/><text x=\"160\" y=\"94\" text-anchor=\"middle\">join pairs</text><text x=\"660\" y=\"94\" text-anchor=\"middle\">right rows</text><text x=\"160\" y=\"244\" text-anchor=\"middle\">left rows</text><text x=\"660\" y=\"244\" text-anchor=\"middle\">keys [10,20]</text><circle class=\"token\" cx=\"140\" cy=\"100\" r=\"9\"/></svg>" }
def u:pushout_diagram() { "Render two tagged schemas merging along a shared interface."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 300\" width=\"820\" height=\"300\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translate(260px,120px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(260px,120px)}}</style><rect width=\"820\" height=\"300\" fill=\"#1a1b26\"/><text x=\"410\" y=\"28\" text-anchor=\"middle\">pushout merges schemas along their shared interface</text><rect class=\"obj\" x=\"70\" y=\"55\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"570\" y=\"55\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"70\" y=\"205\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"570\" y=\"205\" width=\"180\" height=\"65\" rx=\"12\"/><line class=\"arrow\" x1=\"250\" y1=\"87\" x2=\"570\" y2=\"87\"/><line class=\"arrow\" x1=\"160\" y1=\"120\" x2=\"160\" y2=\"205\"/><line class=\"arrow\" x1=\"660\" y1=\"120\" x2=\"660\" y2=\"205\"/><line class=\"arrow bad\" x1=\"250\" y1=\"237\" x2=\"570\" y2=\"237\"/><text x=\"160\" y=\"94\" text-anchor=\"middle\">shared interface</text><text x=\"660\" y=\"94\" text-anchor=\"middle\">right schema</text><text x=\"160\" y=\"244\" text-anchor=\"middle\">left schema</text><text x=\"660\" y=\"244\" text-anchor=\"middle\">merged classes</text><circle class=\"token\" cx=\"140\" cy=\"100\" r=\"9\"/></svg>" }
def u:finite_limits_colimits_diagram() { "Render a cone and cocone beside their bounded universal factorization counts."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 350\" width=\"900\" height=\"350\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"#9ece6a\"/></marker></defs><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4;marker-end:url(#a)}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(95px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(95px)}}</style><rect width=\"900\" height=\"350\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\">terminal cone = finite limit; initial cocone = finite colimit</text><g><text x=\"225\" y=\"60\" text-anchor=\"middle\">CONE: legs point into the diagram</text><rect class=\"obj\" x=\"165\" y=\"75\" width=\"120\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"65\" y=\"225\" width=\"120\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"285\" y=\"225\" width=\"120\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"190\" y1=\"130\" x2=\"145\" y2=\"225\"/><line class=\"arrow\" x1=\"260\" y1=\"130\" x2=\"325\" y2=\"225\"/><line class=\"arrow\" x1=\"185\" y1=\"252\" x2=\"285\" y2=\"252\"/><text x=\"225\" y=\"108\" text-anchor=\"middle\">apex</text><text x=\"125\" y=\"258\" text-anchor=\"middle\">X</text><text x=\"345\" y=\"258\" text-anchor=\"middle\">Y</text><text x=\"225\" y=\"315\" text-anchor=\"middle\">factor counts [1,1,1]</text></g><g transform=\"translate(450 0)\"><text x=\"225\" y=\"60\" text-anchor=\"middle\">COCONE: legs point out of the diagram</text><rect class=\"obj\" x=\"65\" y=\"75\" width=\"120\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"285\" y=\"75\" width=\"120\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"165\" y=\"225\" width=\"120\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"185\" y1=\"102\" x2=\"285\" y2=\"102\"/><line class=\"arrow\" x1=\"145\" y1=\"130\" x2=\"190\" y2=\"225\"/><line class=\"arrow\" x1=\"325\" y1=\"130\" x2=\"260\" y2=\"225\"/><text x=\"125\" y=\"108\" text-anchor=\"middle\">X</text><text x=\"345\" y=\"108\" text-anchor=\"middle\">Y</text><text x=\"225\" y=\"258\" text-anchor=\"middle\">apex</text><text x=\"225\" y=\"315\" text-anchor=\"middle\">factor counts [1,1,1]</text></g><circle class=\"token\" cx=\"225\" cy=\"125\" r=\"9\"/></svg>" }
def u:representable_hom_diagram() { "Render covariant and contravariant hom actions meeting at the walking arrow f."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 320\" width=\"900\" height=\"320\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"#9ece6a\"/></marker></defs><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4;marker-end:url(#a)}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(260px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(260px)}}</style><rect width=\"900\" height=\"320\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\">representables turn composition into hom-set motion</text><rect class=\"obj\" x=\"45\" y=\"70\" width=\"190\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"355\" y=\"70\" width=\"190\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"665\" y=\"70\" width=\"190\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"235\" y1=\"105\" x2=\"355\" y2=\"105\"/><line class=\"arrow\" x1=\"665\" y1=\"105\" x2=\"545\" y2=\"105\"/><text x=\"140\" y=\"112\" text-anchor=\"middle\">Hom(A,A) = [idA]</text><text x=\"450\" y=\"112\" text-anchor=\"middle\">Hom(A,B) = [f]</text><text x=\"760\" y=\"112\" text-anchor=\"middle\">Hom(B,B) = [idB]</text><text x=\"295\" y=\"88\" text-anchor=\"middle\">postcompose f</text><text x=\"605\" y=\"88\" text-anchor=\"middle\">precompose f</text><rect class=\"obj\" x=\"220\" y=\"215\" width=\"460\" height=\"65\" rx=\"14\"/><text x=\"450\" y=\"243\" text-anchor=\"middle\">identity is universal element</text><text x=\"450\" y=\"266\" text-anchor=\"middle\">selected f factors through exactly one arrow: f</text><circle class=\"token\" cx=\"215\" cy=\"125\" r=\"9\"/></svg>" }
def u:finite_yoneda_diagram() { "Render the finite Yoneda round trip and its two-object category of elements."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 340\" width=\"900\" height=\"340\" role=\"img\"><title>render</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and text labels distinguish failures without relying on color.</desc><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"#9ece6a\"/></marker></defs><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4;marker-end:url(#a)}.bad{stroke:#f7768e}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(250px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(250px)}}</style><rect width=\"900\" height=\"340\" fill=\"#1a1b26\"/><text x=\"450\" y=\"28\" text-anchor=\"middle\">one element determines one natural transformation</text><rect class=\"obj\" x=\"40\" y=\"65\" width=\"190\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"355\" y=\"65\" width=\"190\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"670\" y=\"65\" width=\"190\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"230\" y1=\"100\" x2=\"355\" y2=\"100\"/><line class=\"arrow\" x1=\"545\" y1=\"100\" x2=\"670\" y2=\"100\"/><text x=\"135\" y=\"107\" text-anchor=\"middle\">element 10 in F(A)</text><text x=\"450\" y=\"92\" text-anchor=\"middle\">eta: idA-&gt;10</text><text x=\"450\" y=\"116\" text-anchor=\"middle\">eta: f-&gt;20</text><text x=\"765\" y=\"107\" text-anchor=\"middle\">evaluate at idA: 10</text><rect class=\"obj\" x=\"140\" y=\"225\" width=\"220\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"540\" y=\"225\" width=\"220\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"360\" y1=\"260\" x2=\"540\" y2=\"260\"/><text x=\"250\" y=\"267\" text-anchor=\"middle\">(A,10)</text><text x=\"650\" y=\"267\" text-anchor=\"middle\">(B,20)</text><text x=\"450\" y=\"245\" text-anchor=\"middle\">element arrow over f</text><circle class=\"token\" cx=\"210\" cy=\"120\" r=\"9\"/></svg>" }
def u:prolog(s) { "Compute prolog for this executable category-theory example.";  print(""); print(s.title); print(s.intro); print("") }
def u:epilog_open() { "Compute epilog open for this executable category-theory example.";  print(""); print("HOW TO READ THE RESULT") }
def u:explain(path, words) { "Compute explain for this executable category-theory example.";  print(path); print(words) }
def u:takeaway(words) { "Compute takeaway for this executable category-theory example.";  print("THE POINT"); print(words) }
