# lib/render.mlpl -- shared category-diagram SVG and CLI narration.
#
# Rounded boxes are objects, arrows are functions, and colored tokens retain
# identity along a path. Animations finish on a meaningful static frame and
# are disabled by prefers-reduced-motion.
# loops: 0

def u:cat(a, b) { decode_bytes(concat(tokenize_bytes(a), tokenize_bytes(b))) }
def u:svg(body) {
  u:cat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 260\" width=\"760\" height=\"260\" role=\"img\"><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4;marker-end:url(#a)}.token{fill:#f7768e;animation:travel 3s ease-in-out infinite alternate}@keyframes travel{to{transform:translateX(480px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(480px)}}</style><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"#9ece6a\"/></marker></defs><rect width=\"760\" height=\"260\" fill=\"#1a1b26\"/>", u:cat(body, "</svg>"))
}
def u:object(x, label) { u:cat(u:cat("<rect class=\"obj\" x=\"", x), u:cat("\" y=\"80\" width=\"150\" height=\"90\" rx=\"16\"/><text x=\"", u:cat(x, u:cat("\" y=\"125\" text-anchor=\"middle\" dx=\"75\" font-size=\"20\">", u:cat(label, "</text>"))))) }
def u:base_arrow(label) { u:cat("<line class=\"arrow\" x1=\"230\" y1=\"125\" x2=\"530\" y2=\"125\"/><text x=\"380\" y=\"105\" text-anchor=\"middle\" font-size=\"18\">", u:cat(label, "</text>")) }
def u:arrow_diagram() { u:svg(u:cat(u:object("80", "Numbers"), u:cat(u:object("530", "Numbers"), u:cat(u:base_arrow("double"), "<circle class=\"token\" cx=\"210\" cy=\"145\" r=\"12\"/><text x=\"80\" y=\"35\" font-size=\"19\">One input keeps its identity while its value changes: 3 -&gt; 6</text>")))) }
def u:identity_diagram() { u:svg(u:cat(u:object("80", "A"), u:cat(u:object("530", "B"), u:cat(u:base_arrow("id ; f = f = f ; id"), "<circle class=\"token\" cx=\"210\" cy=\"145\" r=\"12\"/><path d=\"M140 80 C90 20 240 20 190 80\" fill=\"none\" class=\"arrow\"/><text x=\"165\" y=\"28\" text-anchor=\"middle\">id</text>")))) }
def u:associativity_diagram() { u:svg("<text x=\"30\" y=\"30\" font-size=\"18\">(f ; g) ; h and f ; (g ; h) visit the same objects and finish together</text><rect class=\"obj\" x=\"35\" y=\"90\" width=\"120\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"220\" y=\"90\" width=\"120\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"405\" y=\"90\" width=\"120\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"590\" y=\"90\" width=\"120\" height=\"70\" rx=\"14\"/><text x=\"95\" y=\"130\" text-anchor=\"middle\">A</text><text x=\"280\" y=\"130\" text-anchor=\"middle\">B</text><text x=\"465\" y=\"130\" text-anchor=\"middle\">C</text><text x=\"650\" y=\"130\" text-anchor=\"middle\">D</text><line class=\"arrow\" x1=\"155\" y1=\"125\" x2=\"220\" y2=\"125\"/><line class=\"arrow\" x1=\"340\" y1=\"125\" x2=\"405\" y2=\"125\"/><line class=\"arrow\" x1=\"525\" y1=\"125\" x2=\"590\" y2=\"125\"/><text x=\"188\" y=\"108\">f</text><text x=\"373\" y=\"108\">g</text><text x=\"558\" y=\"108\">h</text><circle class=\"token\" cx=\"140\" cy=\"145\" r=\"12\"/>") }
def u:square_diagram() {
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 390\" width=\"900\" height=\"390\" role=\"img\"><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{fill:none;stroke:#7aa2f7;stroke-width:4}.token{fill:#f7768e}.good{fill:none;stroke:#9ece6a;stroke-width:8}.bad{fill:none;stroke:#f7768e;stroke-width:8}.route{fill:none;stroke:none}@media(prefers-reduced-motion:reduce){animateMotion{display:none}.start{display:none}.finish{display:inline}}@media(prefers-reduced-motion:no-preference){.finish{display:none}}</style><rect width=\"900\" height=\"390\" fill=\"#1a1b26\"/><text x=\"225\" y=\"28\" text-anchor=\"middle\" font-size=\"20\">COMMUTES: both routes end at 2</text><text x=\"675\" y=\"28\" text-anchor=\"middle\" font-size=\"20\">BROKEN: 2 != 1 for input 0</text><g id=\"lawful\"><rect class=\"obj\" x=\"55\" y=\"55\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"285\" y=\"55\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"55\" y=\"255\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"285\" y=\"255\" width=\"110\" height=\"65\" rx=\"13\"/><path class=\"arrow\" d=\"M165 87H285M110 120V255M340 120V255M165 287H285\"/><text x=\"225\" y=\"78\">+1</text><text x=\"78\" y=\"190\">x2</text><text x=\"350\" y=\"190\">x2</text><text x=\"225\" y=\"278\">+2</text><path id=\"lu\" class=\"route\" d=\"M110 88H340V287\"/><path id=\"ll\" class=\"route\" d=\"M110 88V287H340\"/><circle class=\"token start\" r=\"10\"><animateMotion dur=\"4s\" repeatCount=\"indefinite\"><mpath href=\"#lu\"/></animateMotion></circle><circle class=\"token start\" r=\"7\"><animateMotion dur=\"4s\" repeatCount=\"indefinite\"><mpath href=\"#ll\"/></animateMotion></circle><circle class=\"good\" cx=\"340\" cy=\"287\" r=\"28\"/><circle class=\"token finish\" cx=\"340\" cy=\"287\" r=\"10\"/></g><g id=\"broken\" transform=\"translate(450 0)\"><rect class=\"obj\" x=\"55\" y=\"55\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"285\" y=\"55\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"55\" y=\"255\" width=\"110\" height=\"65\" rx=\"13\"/><rect class=\"obj\" x=\"285\" y=\"255\" width=\"110\" height=\"65\" rx=\"13\"/><path class=\"arrow\" d=\"M165 87H285M110 120V255M340 120V255M165 287H285\"/><text x=\"225\" y=\"78\">+1</text><text x=\"78\" y=\"190\">x2</text><text x=\"350\" y=\"190\">x2</text><text x=\"225\" y=\"278\">+1 (wrong)</text><circle class=\"bad\" cx=\"325\" cy=\"287\" r=\"22\"/><circle class=\"bad\" cx=\"365\" cy=\"287\" r=\"22\"/><text x=\"325\" y=\"292\" text-anchor=\"middle\">2</text><text x=\"365\" y=\"292\" text-anchor=\"middle\">1</text><circle class=\"token\" cx=\"110\" cy=\"88\" r=\"10\"/></g><text x=\"450\" y=\"365\" text-anchor=\"middle\">green halo = equal arrivals; split red halos = concrete witness</text></svg>"
}
def u:product_diagram() { "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" width=\"760\" height=\"300\" role=\"img\"><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{fill:none;stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translate(0,100px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(0,100px)}}</style><rect width=\"760\" height=\"300\" fill=\"#1a1b26\"/><text x=\"380\" y=\"28\" text-anchor=\"middle\" font-size=\"19\">two projections force one pair</text><rect class=\"obj\" x=\"305\" y=\"55\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"90\" y=\"210\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"520\" y=\"210\" width=\"150\" height=\"65\" rx=\"14\"/><path class=\"arrow\" d=\"M330 120L210 210M430 120L550 210\"/><text x=\"255\" y=\"160\">fst = 3</text><text x=\"470\" y=\"160\">snd = 8</text><text x=\"380\" y=\"93\" text-anchor=\"middle\">pair(3,8)</text><text x=\"165\" y=\"247\" text-anchor=\"middle\">3</text><text x=\"595\" y=\"247\" text-anchor=\"middle\">8</text><circle class=\"token\" cx=\"380\" cy=\"105\" r=\"10\"/></svg>" }
def u:coproduct_diagram() { "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 300\" width=\"760\" height=\"300\" role=\"img\"><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{fill:none;stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translate(0,100px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(0,100px)}}</style><rect width=\"760\" height=\"300\" fill=\"#1a1b26\"/><text x=\"380\" y=\"28\" text-anchor=\"middle\" font-size=\"19\">two tagged entrances determine one case map</text><rect class=\"obj\" x=\"90\" y=\"55\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"520\" y=\"55\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"305\" y=\"210\" width=\"150\" height=\"65\" rx=\"14\"/><path class=\"arrow\" d=\"M210 120L350 210M550 120L410 210\"/><text x=\"260\" y=\"160\">left</text><text x=\"485\" y=\"160\">right</text><text x=\"165\" y=\"93\" text-anchor=\"middle\">3 -&gt; 4</text><text x=\"595\" y=\"93\" text-anchor=\"middle\">3 -&gt; -3</text><text x=\"380\" y=\"247\" text-anchor=\"middle\">case(left,right)</text><circle class=\"token\" cx=\"165\" cy=\"105\" r=\"10\"/></svg>" }
def u:functor_diagram() { "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 330\" width=\"800\" height=\"330\" role=\"img\"><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(420px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(420px)}}</style><rect width=\"800\" height=\"330\" fill=\"#1a1b26\"/><text x=\"400\" y=\"28\" text-anchor=\"middle\">scalar arrows and lifted array arrows move together</text><rect class=\"obj\" x=\"80\" y=\"55\" width=\"160\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"560\" y=\"55\" width=\"160\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"80\" y=\"220\" width=\"160\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"560\" y=\"220\" width=\"160\" height=\"65\" rx=\"14\"/><line class=\"arrow\" x1=\"240\" y1=\"87\" x2=\"560\" y2=\"87\"/><line class=\"arrow\" x1=\"240\" y1=\"252\" x2=\"560\" y2=\"252\"/><text x=\"400\" y=\"75\" text-anchor=\"middle\">g after f</text><text x=\"400\" y=\"240\" text-anchor=\"middle\">each(g) after each(f)</text><text x=\"160\" y=\"93\" text-anchor=\"middle\">1</text><text x=\"640\" y=\"93\" text-anchor=\"middle\">4</text><text x=\"160\" y=\"258\" text-anchor=\"middle\">[1,2,3]</text><text x=\"640\" y=\"258\" text-anchor=\"middle\">[4,6,8]</text><circle class=\"token\" cx=\"220\" cy=\"105\" r=\"9\"/></svg>" }
def u:shape_diagram() { "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 300\" width=\"800\" height=\"300\" role=\"img\"><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(420px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(420px)}}</style><rect width=\"800\" height=\"300\" fill=\"#1a1b26\"/><text x=\"400\" y=\"28\" text-anchor=\"middle\">map changes cells, not the 2 x 3 container</text><rect class=\"obj\" x=\"70\" y=\"70\" width=\"210\" height=\"150\" rx=\"14\"/><rect class=\"obj\" x=\"520\" y=\"70\" width=\"210\" height=\"150\" rx=\"14\"/><line class=\"arrow\" x1=\"280\" y1=\"145\" x2=\"520\" y2=\"145\"/><text x=\"400\" y=\"130\" text-anchor=\"middle\">each(+1)</text><text x=\"175\" y=\"125\" text-anchor=\"middle\">1 2 3</text><text x=\"175\" y=\"165\" text-anchor=\"middle\">4 5 6</text><text x=\"625\" y=\"125\" text-anchor=\"middle\">2 3 4</text><text x=\"625\" y=\"165\" text-anchor=\"middle\">5 6 7</text><text x=\"175\" y=\"205\" text-anchor=\"middle\">shape 2 x 3</text><text x=\"625\" y=\"205\" text-anchor=\"middle\">shape 2 x 3</text><circle class=\"token\" cx=\"260\" cy=\"165\" r=\"9\"/></svg>" }
def u:prolog(s) { print(""); print(s.title); print(s.intro); print("") }
def u:epilog_open() { print(""); print("HOW TO READ THE RESULT") }
def u:explain(path, words) { print(path); print(words) }
def u:takeaway(words) { print("THE POINT"); print(words) }
