# lib/finite_diagram_functors.mlpl -- CT049-CT051 finite diagram fixture.
# loops: 0
def u:apply_three_value_table(function_table, inputs) { "Apply one three-value function table to three explicit inputs."; [take(function_table, 0, take(inputs, 0, 0)), take(function_table, 0, take(inputs, 0, 1)), take(function_table, 0, take(inputs, 0, 2))] }
def u:compose_three_value_tables(first_table, second_table) { "Compose two three-value function tables in execution order."; u:apply_three_value_table(second_table, first_table) }
def u:constant_diagram_on_three_points(object_code) { "Copy one object code and its identity arrow across the walking composable-pair shape."; {objects: fill([3], object_code), first_arrow: [0, 1, 2], second_arrow: [0, 1, 2], composite_arrow: [0, 1, 2]} }
def u:constant_diagram_preserves_category_laws(diagram) { "Check identity and composition for a constant diagram over three-value carriers."; identity_table = [0, 1, 2]; equal(diagram.first_arrow, identity_table) * equal(diagram.second_arrow, identity_table) * equal(diagram.composite_arrow, u:compose_three_value_tables(diagram.first_arrow, diagram.second_arrow)) }
def u:compose_diagram_transformation_components(first_components, second_components) { "Compose three pointwise natural-transformation component tables."; [u:compose_three_value_tables(take(first_components, 0, 0), take(second_components, 0, 0)), u:compose_three_value_tables(take(first_components, 0, 1), take(second_components, 0, 1)), u:compose_three_value_tables(take(first_components, 0, 2), take(second_components, 0, 2))] }
def u:diagram_transformations_form_category(identity_components, first_components, second_components) { "Check pointwise left identity, right identity, and composition for finite diagram transformations."; composed = u:compose_diagram_transformation_components(first_components, second_components); equal(u:compose_diagram_transformation_components(identity_components, first_components), first_components) * equal(u:compose_diagram_transformation_components(first_components, identity_components), first_components) * equal(composed, u:compose_diagram_transformation_components(first_components, second_components)) }
def u:broken_constant_diagram_witness(diagram) { "Report a constant-diagram arrow that fails to preserve the index composite."; {found: 1 - u:constant_diagram_preserves_category_laws(diagram), expected: [0, 1, 2], actual: diagram.composite_arrow} }
def u:finite_diagram_functors_visual() { "Return a directed constant-diagram and pointwise-transformation visual."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 340\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.component{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:3}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:7 6}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(500px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(500px)}}</style><rect width=\"900\" height=\"340\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"70\" y=\"50\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"375\" y=\"50\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"680\" y=\"50\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"220\" y1=\"77\" x2=\"375\" y2=\"77\"/><line class=\"arrow\" x1=\"525\" y1=\"77\" x2=\"680\" y2=\"77\"/><rect class=\"obj\" x=\"70\" y=\"240\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"375\" y=\"240\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"680\" y=\"240\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"220\" y1=\"267\" x2=\"375\" y2=\"267\"/><line class=\"arrow\" x1=\"525\" y1=\"267\" x2=\"680\" y2=\"267\"/><line class=\"component\" x1=\"145\" y1=\"105\" x2=\"145\" y2=\"240\"/><line class=\"component\" x1=\"450\" y1=\"105\" x2=\"450\" y2=\"240\"/><line class=\"component\" x1=\"755\" y1=\"105\" x2=\"755\" y2=\"240\"/><path class=\"bad\" d=\"M220 92C380 180 520 180 680 92\"/><text x=\"145\" y=\"84\" text-anchor=\"middle\">X</text><text x=\"450\" y=\"84\" text-anchor=\"middle\">X</text><text x=\"755\" y=\"84\" text-anchor=\"middle\">X</text><text x=\"450\" y=\"25\" text-anchor=\"middle\">constant / diagonal diagram</text><text x=\"450\" y=\"325\" text-anchor=\"middle\">components compose pointwise</text><circle class=\"token\" cx=\"195\" cy=\"62\" r=\"8\"/></svg>" }
