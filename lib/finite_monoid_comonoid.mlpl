# lib/finite_monoid_comonoid.mlpl -- internal multiplication and comultiplication diagrams.
# loops: 0
def u:internal_monoid_diagrams_hold(left_associative, right_associative, left_unit, right_unit, values) {
  "Check displayed multiplication associativity and both unit diagrams as morphism equalities.";
  equal(left_associative, right_associative) * equal(left_unit, values) * equal(right_unit, values)
}
def u:internal_comonoid_diagrams_hold(left_coassociative, right_coassociative, left_counit, right_counit, values) {
  "Check displayed comultiplication coassociativity and both counit diagrams as morphism equalities.";
  equal(left_coassociative, right_coassociative) * equal(left_counit, values) * equal(right_counit, values)
}
def u:finite_monoid_comonoid_visual() {
  "Render multiplication merging tensor wires and diagonal comultiplication splitting them, with dual failures.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1040 470\" role=\"img\"><title>internal monoid and comonoid objects</title><desc>On the left, two tensor inputs merge through multiplication and the unit enters the object. On the right, comultiplication splits one input into two and counit removes a branch. Green diagrams commute; dashed red results separately break multiplication and comultiplication.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(120px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(120px)}}</style><rect width=\"1040\" height=\"470\" fill=\"rgb(26,27,38)\"/><text x=\"250\" y=\"30\" text-anchor=\"middle\">MONOID OBJECT: MERGE</text><rect class=\"obj\" x=\"55\" y=\"80\" width=\"170\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"300\" y=\"210\" width=\"150\" height=\"60\" rx=\"12\"/><text x=\"140\" y=\"117\" text-anchor=\"middle\">M⊗M</text><text x=\"375\" y=\"247\" text-anchor=\"middle\">M</text><path class=\"arrow\" d=\"M225 110L330 210\"/><text x=\"285\" y=\"145\">μ</text><path class=\"arrow\" d=\"M80 240H300\"/><text x=\"160\" y=\"225\">η: I→M</text><text x=\"790\" y=\"30\" text-anchor=\"middle\">COMONOID OBJECT: SPLIT</text><rect class=\"obj\" x=\"590\" y=\"210\" width=\"150\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"815\" y=\"80\" width=\"170\" height=\"60\" rx=\"12\"/><text x=\"665\" y=\"247\" text-anchor=\"middle\">C</text><text x=\"900\" y=\"117\" text-anchor=\"middle\">C⊗C</text><path class=\"arrow\" d=\"M740 220L850 140\"/><text x=\"785\" y=\"170\">δ</text><path class=\"arrow\" d=\"M740 250H960\"/><text x=\"825\" y=\"235\">ε: C→I</text><text x=\"520\" y=\"330\" text-anchor=\"middle\">ASSOCIATIVITY ⇄ COASSOCIATIVITY; UNIT ⇄ COUNIT</text><line class=\"bad\" x1=\"140\" y1=\"380\" x2=\"390\" y2=\"420\"/><line class=\"bad\" x1=\"900\" y1=\"380\" x2=\"650\" y2=\"420\"/><text x=\"520\" y=\"452\" text-anchor=\"middle\">separate changed routes fail the dual diagrams</text><circle class=\"token\" cx=\"215\" cy=\"120\" r=\"8\"/></svg>"
}
