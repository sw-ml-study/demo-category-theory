# lib/finite_dual_compact_boundary.mlpl -- dual-object snake laws and compact coverage.
# loops: 0
def u:dual_object_snake_identities_hold(left_snake_intermediate, right_snake_intermediate, left_snake_result, left_identity, right_snake_result, right_identity) {
  "Check two visibly distinct dual-object snake routes, each against the identity on its own object.";
  (1 - equal(left_snake_intermediate, right_snake_intermediate)) * equal(left_snake_result, left_identity) * equal(right_snake_result, right_identity)
}
def u:evaluation_coevaluation_tables_match(dual_evaluation_table, dual_coevaluation_table) {
  "Check the bounded self-dual fixture uses matching finite evaluation and coevaluation pairings.";
  equal(dual_evaluation_table, dual_coevaluation_table)
}
def u:compact_closed_object_coverage_is_complete(object_dual_evidence) {
  "Require a verified dual for every enumerated object before claiming compact closed structure.";
  reduce_mul(object_dual_evidence)
}
def u:finite_dual_compact_boundary_visual() {
  "Render directed evaluation and coevaluation, two typed snake routes, and incomplete compact-closed coverage.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1120 650\" role=\"img\"><title>dual object and compact closed boundary</title><desc>Evaluation points from A star tensor A to the unit, while coevaluation points from the unit to A tensor A star. Separate left and right snake routes return A and A star. A second object lacks verified dual evidence, so compact closed structure is not claimed.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.other{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:4;fill:none}.bad{stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:10 7;fill:none}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(185px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(185px)}}</style><rect width=\"1120\" height=\"650\" fill=\"rgb(26,27,38)\"/><text x=\"280\" y=\"35\" text-anchor=\"middle\">EVALUATION REMOVES A DUAL PAIR</text><rect class=\"obj\" x=\"60\" y=\"70\" width=\"210\" height=\"60\" rx=\"10\"/><rect class=\"obj\" x=\"410\" y=\"70\" width=\"90\" height=\"60\" rx=\"10\"/><text x=\"165\" y=\"107\" text-anchor=\"middle\">A* ⊗ A</text><text x=\"455\" y=\"107\" text-anchor=\"middle\">I</text><path class=\"arrow\" d=\"M270 100H410\"/><text x=\"340\" y=\"87\" text-anchor=\"middle\">evaluation</text><circle class=\"token\" cx=\"280\" cy=\"100\" r=\"7\"/><text x=\"840\" y=\"35\" text-anchor=\"middle\">COEVALUATION CREATES A DUAL PAIR</text><rect class=\"obj\" x=\"620\" y=\"70\" width=\"90\" height=\"60\" rx=\"10\"/><rect class=\"obj\" x=\"850\" y=\"70\" width=\"210\" height=\"60\" rx=\"10\"/><text x=\"665\" y=\"107\" text-anchor=\"middle\">I</text><text x=\"955\" y=\"107\" text-anchor=\"middle\">A ⊗ A*</text><path class=\"other\" d=\"M710 100H850\"/><text x=\"780\" y=\"87\" text-anchor=\"middle\">coevaluation</text><text x=\"280\" y=\"190\" text-anchor=\"middle\">LEFT SNAKE — OBJECT A</text><rect class=\"obj\" x=\"55\" y=\"220\" width=\"90\" height=\"55\" rx=\"9\"/><rect class=\"obj\" x=\"220\" y=\"220\" width=\"245\" height=\"55\" rx=\"9\"/><rect class=\"obj\" x=\"500\" y=\"220\" width=\"70\" height=\"55\" rx=\"9\"/><text x=\"100\" y=\"255\" text-anchor=\"middle\">A</text><text x=\"342\" y=\"255\" text-anchor=\"middle\">A⊗(A*⊗A)</text><text x=\"535\" y=\"255\" text-anchor=\"middle\">A</text><path class=\"arrow\" d=\"M145 247H220\"/><path class=\"arrow\" d=\"M465 247H500\"/><text x=\"840\" y=\"190\" text-anchor=\"middle\">RIGHT SNAKE — DUAL OBJECT A*</text><rect class=\"obj\" x=\"620\" y=\"220\" width=\"90\" height=\"55\" rx=\"9\"/><rect class=\"obj\" x=\"760\" y=\"220\" width=\"245\" height=\"55\" rx=\"9\"/><rect class=\"obj\" x=\"1040\" y=\"220\" width=\"70\" height=\"55\" rx=\"9\"/><text x=\"665\" y=\"255\" text-anchor=\"middle\">A*</text><text x=\"882\" y=\"255\" text-anchor=\"middle\">(A*⊗A)⊗A*</text><text x=\"1075\" y=\"255\" text-anchor=\"middle\">A*</text><path class=\"other\" d=\"M710 247H760\"/><path class=\"other\" d=\"M1005 247H1040\"/><text x=\"560\" y=\"335\" text-anchor=\"middle\">each composite is its typed identity; the intermediate routes are not duplicates</text><text x=\"560\" y=\"405\" text-anchor=\"middle\">COMPACT CLOSED REQUIRES A VERIFIED DUAL FOR EVERY OBJECT</text><rect class=\"obj\" x=\"250\" y=\"455\" width=\"230\" height=\"70\" rx=\"10\"/><rect class=\"bad\" x=\"640\" y=\"455\" width=\"230\" height=\"70\" rx=\"10\"/><text x=\"365\" y=\"497\" text-anchor=\"middle\">✓ object A has A*</text><text x=\"755\" y=\"497\" text-anchor=\"middle\">□ object B dual absent</text><text x=\"560\" y=\"590\" text-anchor=\"middle\">coverage [1,0] — one dual object, not a compact closed category</text><text x=\"560\" y=\"630\" text-anchor=\"middle\">string-diagram topology begins in the next saga</text></svg>"
}
