# lib/finite_trace_feedback.mlpl -- finite feedback closure and traced coverage.
# loops: 0
def u:feedback_ports_are_compatible(feedback_output_type, feedback_input_type) { "Check that the designated feedback output and input ports have the same type before closing the wire."; equal(feedback_output_type, feedback_input_type) }
def u:trace_matches_explicit_feedback(explicit_feedback_endpoint, traced_endpoint) { "Compare the endpoint obtained by explicit finite feedback execution with the endpoint of the closed trace."; equal(explicit_feedback_endpoint, traced_endpoint) }
def u:traced_law_coverage_is_complete(enumerated_law_evidence) { "Require every enumerated trace-law fixture before making the bounded traced-monoidal claim."; reduce_mul(enumerated_law_evidence) }
def u:finite_trace_feedback_visual() { "Render an open typed process, its closed feedback edge, traced external boundary, and incomplete law coverage."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1120 650\" role=\"img\"><title>finite trace and feedback</title><desc>An open process has external A input and B output plus U feedback input and output. Closing the U output back to the U input creates a trace while leaving A to B as the external boundary. Explicit feedback and trace both reach 8. One missing law fixture prevents a traced monoidal category claim.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.port{fill:rgb(224,175,104);stroke:rgb(26,27,38);stroke-width:2}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.feedback{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:5;fill:none}.bad{stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:10 7;fill:none}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(150px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(150px)}}</style><rect width=\"1120\" height=\"650\" fill=\"rgb(26,27,38)\"/><text x=\"270\" y=\"35\" text-anchor=\"middle\">STAGE 1 — OPEN PROCESS</text><rect class=\"obj\" x=\"145\" y=\"105\" width=\"250\" height=\"150\" rx=\"14\"/><text x=\"270\" y=\"185\" text-anchor=\"middle\">p : A⊗U → B⊗U</text><circle class=\"port\" cx=\"145\" cy=\"145\" r=\"9\"/><circle class=\"port\" cx=\"145\" cy=\"220\" r=\"9\"/><circle class=\"port\" cx=\"395\" cy=\"145\" r=\"9\"/><circle class=\"port\" cx=\"395\" cy=\"220\" r=\"9\"/><text x=\"105\" y=\"150\" text-anchor=\"middle\">A in</text><text x=\"105\" y=\"225\" text-anchor=\"middle\">U in</text><text x=\"435\" y=\"150\">B out</text><text x=\"435\" y=\"225\">U out</text><path class=\"arrow\" d=\"M45 145H136\"/><path class=\"arrow\" d=\"M404 145H500\"/><text x=\"830\" y=\"35\" text-anchor=\"middle\">STAGE 2 — CLOSE ONLY U</text><rect class=\"obj\" x=\"705\" y=\"105\" width=\"250\" height=\"150\" rx=\"14\"/><text x=\"830\" y=\"185\" text-anchor=\"middle\">trace-U(p) : A → B</text><circle class=\"port\" cx=\"705\" cy=\"145\" r=\"9\"/><circle class=\"port\" cx=\"705\" cy=\"220\" r=\"9\"/><circle class=\"port\" cx=\"955\" cy=\"145\" r=\"9\"/><circle class=\"port\" cx=\"955\" cy=\"220\" r=\"9\"/><path class=\"arrow\" d=\"M605 145H696\"/><path class=\"arrow\" d=\"M964 145H1060\"/><path class=\"feedback\" d=\"M964 220C1040 220 1040 320 830 320C620 320 620 220 696 220\"/><text x=\"830\" y=\"305\" text-anchor=\"middle\">feedback edge U out → U in</text><text x=\"580\" y=\"375\" text-anchor=\"middle\">external boundary remains A → B</text><circle class=\"token\" cx=\"720\" cy=\"145\" r=\"7\"/><text x=\"580\" y=\"430\" text-anchor=\"middle\">STAGE 3 — EXECUTE BOTH READINGS</text><rect class=\"obj\" x=\"170\" y=\"465\" width=\"280\" height=\"60\" rx=\"10\"/><rect class=\"obj\" x=\"670\" y=\"465\" width=\"280\" height=\"60\" rx=\"10\"/><text x=\"310\" y=\"503\" text-anchor=\"middle\">explicit feedback → 8</text><text x=\"810\" y=\"503\" text-anchor=\"middle\">trace endpoint → 8</text><path class=\"arrow\" d=\"M450 495H670\"/><text x=\"560\" y=\"480\" text-anchor=\"middle\">equal</text><text x=\"580\" y=\"565\" text-anchor=\"middle\">TRACE-LAW COVERAGE [1,1,0]</text><rect class=\"bad\" x=\"360\" y=\"585\" width=\"400\" height=\"45\" rx=\"8\"/><text x=\"560\" y=\"615\" text-anchor=\"middle\">naturality ✓  vanishing ✓  sliding □</text></svg>" }
