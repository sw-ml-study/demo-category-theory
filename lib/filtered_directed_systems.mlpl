# lib/filtered_directed_systems.mlpl -- finite evidence for filtered and directed systems.
# loops: 0

def u:finite_category_is_filtered(common_successor_checks, parallel_pair_checks) {
  "Check bounded witnesses for common successors and coequalization of parallel arrows.";
  reduce_mul(common_successor_checks) * reduce_mul(parallel_pair_checks)
}
def u:finite_preorder_is_directed(common_upper_bound_checks) {
  "Check that every tested pair in a bounded preorder has a common upper bound.";
  reduce_mul(common_upper_bound_checks)
}
def u:bounded_filtered_cocone_is_compatible(transition_then_cocone, cocone_from_source) {
  "Compare the two cocone routes at every transition in a finite filtered diagram.";
  reduce_mul(eq(transition_then_cocone, cocone_from_source))
}
def u:bounded_inverse_system_tuple_is_compatible(restricted_later_values, earlier_values) {
  "Check compatibility of a tuple across every displayed reverse bonding map.";
  reduce_mul(eq(restricted_later_values, earlier_values))
}
def u:bounded_direct_system_labels_are_compatible(mapped_labels, later_labels) {
  "Check that forward bonding maps preserve the displayed quotient labels.";
  reduce_mul(eq(mapped_labels, later_labels))
}
def u:observed_prefix_stabilizes(previous_stage, final_stage) {
  "Report equality of the last two observed finite stages without predicting later stages.";
  reduce_mul(eq(previous_stage, final_stage))
}
def u:filtered_directed_systems_visual() {
  "Render finite filtered witnesses, forward and reverse systems, and the explicit infinite-claim boundary.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 980 450\" role=\"img\"><title>bounded filtered and directed systems</title><desc>A finite filtered category has common-successor and parallel-arrow witnesses. A forward direct system and reverse inverse system show compatible finite data. A dashed warning says an observed stable prefix does not prove an infinite limit.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.reverse{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:4}.bad{stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(190px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(190px)}}</style><rect width=\"980\" height=\"450\" fill=\"rgb(26,27,38)\"/><text x=\"245\" y=\"28\" text-anchor=\"middle\">1 FILTERED FIXTURE</text><rect class=\"obj\" x=\"45\" y=\"60\" width=\"100\" height=\"52\" rx=\"10\"/><rect class=\"obj\" x=\"250\" y=\"60\" width=\"100\" height=\"52\" rx=\"10\"/><rect class=\"obj\" x=\"155\" y=\"155\" width=\"100\" height=\"52\" rx=\"10\"/><text x=\"95\" y=\"92\" text-anchor=\"middle\">i</text><text x=\"300\" y=\"92\" text-anchor=\"middle\">j</text><text x=\"205\" y=\"187\" text-anchor=\"middle\">k</text><line class=\"arrow\" x1=\"115\" y1=\"112\" x2=\"175\" y2=\"155\"/><line class=\"arrow\" x1=\"280\" y1=\"112\" x2=\"235\" y2=\"155\"/><text x=\"245\" y=\"235\" text-anchor=\"middle\">common successor; parallel arrows coequalize</text><text x=\"730\" y=\"28\" text-anchor=\"middle\">2 DIRECT SYSTEM: FORWARD</text><rect class=\"obj\" x=\"535\" y=\"65\" width=\"90\" height=\"48\" rx=\"10\"/><rect class=\"obj\" x=\"700\" y=\"65\" width=\"90\" height=\"48\" rx=\"10\"/><rect class=\"obj\" x=\"865\" y=\"65\" width=\"90\" height=\"48\" rx=\"10\"/><text x=\"580\" y=\"95\" text-anchor=\"middle\">D0</text><text x=\"745\" y=\"95\" text-anchor=\"middle\">D1</text><text x=\"910\" y=\"95\" text-anchor=\"middle\">D2</text><line class=\"arrow\" x1=\"625\" y1=\"89\" x2=\"700\" y2=\"89\"/><line class=\"arrow\" x1=\"790\" y1=\"89\" x2=\"865\" y2=\"89\"/><text x=\"730\" y=\"145\" text-anchor=\"middle\">compatible labels form a bounded direct colimit</text><text x=\"730\" y=\"190\" text-anchor=\"middle\">3 INVERSE SYSTEM: REVERSE</text><rect class=\"obj\" x=\"535\" y=\"215\" width=\"90\" height=\"48\" rx=\"10\"/><rect class=\"obj\" x=\"700\" y=\"215\" width=\"90\" height=\"48\" rx=\"10\"/><rect class=\"obj\" x=\"865\" y=\"215\" width=\"90\" height=\"48\" rx=\"10\"/><text x=\"580\" y=\"245\" text-anchor=\"middle\">X0</text><text x=\"745\" y=\"245\" text-anchor=\"middle\">X1</text><text x=\"910\" y=\"245\" text-anchor=\"middle\">X2</text><line class=\"reverse\" x1=\"700\" y1=\"239\" x2=\"625\" y2=\"239\"/><line class=\"reverse\" x1=\"865\" y1=\"239\" x2=\"790\" y2=\"239\"/><text x=\"730\" y=\"295\" text-anchor=\"middle\">compatible tuples form a bounded inverse limit</text><path class=\"bad\" d=\"M135 350H845\"/><text x=\"490\" y=\"337\" text-anchor=\"middle\">BOUNDARY: last two stages equal</text><text x=\"490\" y=\"382\" text-anchor=\"middle\">DOES NOT IMPLY all future stages stabilize</text><line class=\"bad\" x1=\"350\" y1=\"395\" x2=\"630\" y2=\"330\"/><circle class=\"token\" cx=\"550\" cy=\"105\" r=\"8\"/><text x=\"490\" y=\"430\" text-anchor=\"middle\">finite executable evidence only</text></svg>"
}
