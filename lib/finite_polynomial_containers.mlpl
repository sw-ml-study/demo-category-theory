# lib/finite_polynomial_containers.mlpl -- one bounded polynomial functor and container.
# loops: 0
def u:make_finite_container(shape_codes, positions_per_shape) {
  "Describe a bounded container by finite shape codes and the number of payload positions for each shape.";
  {shapes: shape_codes, arities: positions_per_shape}
}
def u:interpret_container_value(container, shape_code, payload_values) {
  "Interpret one container value as a chosen shape paired with payloads for exactly its positions.";
  {container: container, shape: shape_code, payloads: payload_values}
}
def u:container_payload_arity_holds(container_value) {
  "Check that a container value supplies exactly the number of payloads required by its chosen shape.";
  expected_arity = take(container_value.container.arities, 0, container_value.shape);
  actual_arity = take(shape(container_value.payloads), 0, 0);
  equal(actual_arity, expected_arity)
}
def u:polynomial_payload_map_laws_hold(original_payloads, identity_mapped_payloads, composed_payloads, sequential_payloads) {
  "Check identity and composition for the displayed polynomial payload mapping action.";
  equal(identity_mapped_payloads, original_payloads) * equal(composed_payloads, sequential_payloads)
}
def u:finite_polynomial_container_visual() {
  "Render the shapes of 1 plus X squared, one pair-shaped value, payload mapping, and a malformed arity witness.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1040 480\" role=\"img\"><title>finite polynomial functor and container</title><desc>The polynomial one plus X squared has an empty shape with zero positions and a pair shape with two positions. A green arrow maps payloads while preserving the pair shape. A dashed red box has only one payload and fails its arity.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{fill:rgb(31,35,53);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(315px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(315px)}}</style><rect width=\"1040\" height=\"480\" fill=\"rgb(26,27,38)\"/><text x=\"520\" y=\"30\" text-anchor=\"middle\">P(X) = 1 + X²</text><rect class=\"obj\" x=\"55\" y=\"65\" width=\"210\" height=\"90\" rx=\"12\"/><text x=\"160\" y=\"98\" text-anchor=\"middle\">shape empty</text><text x=\"160\" y=\"128\" text-anchor=\"middle\">0 positions → ()</text><rect class=\"obj\" x=\"315\" y=\"65\" width=\"210\" height=\"90\" rx=\"12\"/><text x=\"420\" y=\"98\" text-anchor=\"middle\">shape pair</text><text x=\"420\" y=\"128\" text-anchor=\"middle\">2 positions → (7,9)</text><text x=\"790\" y=\"75\" text-anchor=\"middle\">CONTAINER = SHAPES + POSITIONS</text><text x=\"790\" y=\"110\" text-anchor=\"middle\">shapes [empty,pair]</text><text x=\"790\" y=\"140\" text-anchor=\"middle\">arities [0,2]</text><rect class=\"obj\" x=\"120\" y=\"245\" width=\"230\" height=\"75\" rx=\"12\"/><rect class=\"obj\" x=\"630\" y=\"245\" width=\"230\" height=\"75\" rx=\"12\"/><text x=\"235\" y=\"277\" text-anchor=\"middle\">pair (7,9)</text><text x=\"235\" y=\"302\" text-anchor=\"middle\">shape unchanged</text><text x=\"745\" y=\"277\" text-anchor=\"middle\">pair (8,10)</text><text x=\"745\" y=\"302\" text-anchor=\"middle\">map (+1) over positions</text><line class=\"arrow\" x1=\"350\" y1=\"282\" x2=\"630\" y2=\"282\"/><text x=\"490\" y=\"267\" text-anchor=\"middle\">P(map)</text><circle class=\"token\" cx=\"330\" cy=\"300\" r=\"8\"/><rect class=\"bad\" x=\"350\" y=\"375\" width=\"340\" height=\"65\" rx=\"12\"/><text x=\"520\" y=\"402\" text-anchor=\"middle\">COUNTEREXAMPLE: pair (7)</text><text x=\"520\" y=\"427\" text-anchor=\"middle\">1 payload ≠ 2 positions</text></svg>"
}
