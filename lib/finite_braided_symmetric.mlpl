# lib/finite_braided_symmetric.mlpl -- bounded braiding, hexagon, and symmetry.
# loops: 0
def u:braid_tensor_pair(tensor_pair) { "Swap the left and right payloads of one finite tensor pair."; {left: tensor_pair.right, right: tensor_pair.left} }
def u:hexagon_direct_braiding_path(start_tensor) { "Braid A past the composite B tensor C in one displayed hexagon edge."; {endpoint: {left: start_tensor.right, right: start_tensor.left}} }
def u:hexagon_component_braiding_path(start_tensor) { "Braid A past B and C separately through the long displayed hexagon route."; first = {left: {left: start_tensor.left, right: start_tensor.right.left}, right: start_tensor.right.right}; second = {left: {left: first.left.right, right: first.left.left}, right: first.right}; third = {left: second.left.left, right: {left: second.left.right, right: second.right}}; fourth = {left: third.left, right: {left: third.right.right, right: third.right.left}}; endpoint = {left: {left: fourth.left, right: fourth.right.left}, right: fourth.right.right}; {first: first, second: second, third: third, fourth: fourth, endpoint: endpoint} }
def u:braiding_naturality_square_commutes(map_then_braid, braid_then_opposite_maps) { "Compare both routes around one finite braiding naturality square."; equal(map_then_braid, braid_then_opposite_maps) }
def u:symmetry_law_holds(tensor_pair) { "Check that applying the displayed braiding twice restores the starting tensor pair."; equal(u:braid_tensor_pair(u:braid_tensor_pair(tensor_pair)), tensor_pair) }
def u:finite_braided_symmetric_visual() { "Render direct and componentwise hexagon routes, double-swap symmetry, and a changed endpoint."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1080 500\" role=\"img\"><title>finite braided and symmetric coherence</title><desc>A green direct braiding moves A past the composite B tensor C. A blue route moves A past B and C separately through different intermediate nestings. Both reach B tensor C tensor A. A double swap returns a pair, while a dashed changed endpoint fails.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.route{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:4;fill:none}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(650px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(650px)}}</style><rect width=\"1080\" height=\"500\" fill=\"rgb(26,27,38)\"/><text x=\"540\" y=\"30\" text-anchor=\"middle\">HEXAGON: BRAID A PAST B⊗C</text><rect class=\"obj\" x=\"55\" y=\"90\" width=\"220\" height=\"70\" rx=\"12\"/><text x=\"165\" y=\"132\" text-anchor=\"middle\">A⊗(B⊗C)</text><rect class=\"obj\" x=\"805\" y=\"90\" width=\"220\" height=\"70\" rx=\"12\"/><text x=\"915\" y=\"132\" text-anchor=\"middle\">(B⊗C)⊗A</text><path class=\"arrow\" d=\"M275 110H805\"/><text x=\"540\" y=\"98\" text-anchor=\"middle\">direct braid c(A,B⊗C)</text><rect class=\"obj\" x=\"250\" y=\"245\" width=\"180\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"650\" y=\"245\" width=\"180\" height=\"60\" rx=\"12\"/><text x=\"340\" y=\"282\" text-anchor=\"middle\">(B⊗A)⊗C</text><text x=\"740\" y=\"282\" text-anchor=\"middle\">B⊗(C⊗A)</text><path class=\"route\" d=\"M210 160L285 245\"/><path class=\"route\" d=\"M430 275H650\"/><path class=\"route\" d=\"M795 245L870 160\"/><circle class=\"token\" cx=\"265\" cy=\"125\" r=\"8\"/><text x=\"540\" y=\"350\" text-anchor=\"middle\">SYMMETRY: c(B,A) ∘ c(A,B) = id</text><path class=\"arrow\" d=\"M280 395H510\"/><path class=\"arrow\" d=\"M570 395H800\"/><text x=\"205\" y=\"402\" text-anchor=\"middle\">(2,3)</text><text x=\"540\" y=\"402\" text-anchor=\"middle\">(3,2)</text><text x=\"875\" y=\"402\" text-anchor=\"middle\">(2,3)</text><line class=\"bad\" x1=\"805\" y1=\"190\" x2=\"980\" y2=\"245\"/><text x=\"900\" y=\"285\" text-anchor=\"middle\">changed C fails</text><text x=\"540\" y=\"470\" text-anchor=\"middle\">distinct intermediate permutations, one coherent endpoint</text></svg>" }
