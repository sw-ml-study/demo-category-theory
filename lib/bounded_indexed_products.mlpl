# lib/bounded_indexed_products.mlpl -- CT045-CT048 discrete three-object fixture.
# loops: 0
def u:three_object_product(first_leg, second_leg, third_leg) { "Build the unique mediator into a three-object finite product."; [first_leg, second_leg, third_leg] }
def u:three_object_product_is_universal(candidate, legs) { "Check whether all three projections force the proposed product mediator."; equal(candidate, legs) }
def u:three_object_coproduct_injections(first_value, second_value, third_value) { "Build three numerically tagged injections into a bounded coproduct."; [[0, first_value], [1, second_value], [2, third_value]] }
def u:three_object_coproduct_case_outputs(tagged_values) { "Apply one explicit case rule to each of three tagged coproduct branches."; [10 + take(take(tagged_values, 0, 0), 0, 1), 20 + take(take(tagged_values, 0, 1), 0, 1), 30 + take(take(tagged_values, 0, 2), 0, 1)] }
def u:three_object_coproduct_is_universal(actual_outputs, forced_outputs) { "Check whether branch restrictions force one bounded coproduct case map."; equal(actual_outputs, forced_outputs) }
def u:bounded_discrete_limit_and_colimit_laws(product_candidate, product_legs, case_outputs, forced_outputs) { "Check product-limit and coproduct-colimit laws for one three-object discrete diagram."; u:three_object_product_is_universal(product_candidate, product_legs) * u:three_object_coproduct_is_universal(case_outputs, forced_outputs) }
def u:bounded_indexed_products_visual() { "Return a directed three-leg product and coproduct visual."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 350\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:7 6}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(115px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(115px)}}</style><rect width=\"900\" height=\"350\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"350\" y=\"25\" width=\"200\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"80\" y=\"145\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"375\" y=\"145\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"670\" y=\"145\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"390\" y1=\"80\" x2=\"200\" y2=\"145\"/><line class=\"arrow\" x1=\"450\" y1=\"80\" x2=\"450\" y2=\"145\"/><line class=\"arrow\" x1=\"510\" y1=\"80\" x2=\"700\" y2=\"145\"/><rect class=\"obj\" x=\"350\" y=\"270\" width=\"200\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"155\" y1=\"200\" x2=\"390\" y2=\"270\"/><line class=\"arrow\" x1=\"450\" y1=\"200\" x2=\"450\" y2=\"270\"/><line class=\"arrow\" x1=\"745\" y1=\"200\" x2=\"510\" y2=\"270\"/><text x=\"450\" y=\"60\" text-anchor=\"middle\">product / limit [2,5,7]</text><text x=\"155\" y=\"178\" text-anchor=\"middle\">A</text><text x=\"450\" y=\"178\" text-anchor=\"middle\">B</text><text x=\"745\" y=\"178\" text-anchor=\"middle\">C</text><text x=\"450\" y=\"305\" text-anchor=\"middle\">coproduct / colimit</text><circle class=\"token\" cx=\"450\" cy=\"70\" r=\"8\"/></svg>" }
