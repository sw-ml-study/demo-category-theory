# lib/finite_exponentials.mlpl -- two-point exponential and evaluation.
# loops: 0
def u:evaluate_two_point_function(function_rows, function_code, input_value) {
  "Evaluate one enumerated A-to-B function selected from the finite exponential object.";
  take(take(function_rows, 0, function_code), 0, input_value)
}
def u:two_point_exponential_is_complete(function_rows) {
  "Check that the bounded exponential lists the four binary function tables in canonical order.";
  equal(function_rows, [[0, 0], [0, 1], [1, 0], [1, 1]])
}
def u:evaluation_table_is_correct(function_rows, evaluation_outputs) {
  "Check evaluation over all eight function-and-input pairs in canonical order.";
  equal(evaluation_outputs, [u:evaluate_two_point_function(function_rows, 0, 0), u:evaluate_two_point_function(function_rows, 0, 1), u:evaluate_two_point_function(function_rows, 1, 0), u:evaluate_two_point_function(function_rows, 1, 1), u:evaluate_two_point_function(function_rows, 2, 0), u:evaluate_two_point_function(function_rows, 2, 1), u:evaluate_two_point_function(function_rows, 3, 0), u:evaluate_two_point_function(function_rows, 3, 1)])
}
def u:curry_binary_product_table(product_function_table) {
  "Reshape a function on two binary product rows into two A-to-B function rows indexed by X.";
  [[take(product_function_table, 0, 0), take(product_function_table, 0, 1)], [take(product_function_table, 0, 2), take(product_function_table, 0, 3)]]
}
def u:uncurry_binary_function_rows(curried_function_rows) {
  "Flatten two A-to-B rows into the canonical X-times-A product-input order.";
  [take(take(curried_function_rows, 0, 0), 0, 0), take(take(curried_function_rows, 0, 0), 0, 1), take(take(curried_function_rows, 0, 1), 0, 0), take(take(curried_function_rows, 0, 1), 0, 1)]
}
def u:finite_beta_law_holds(product_function_table) {
  "Check that uncurrying the curry of a bounded product function restores that function.";
  equal(u:uncurry_binary_function_rows(u:curry_binary_product_table(product_function_table)), product_function_table)
}
def u:finite_eta_law_holds(curried_function_rows) {
  "Check that currying the uncurry of bounded function rows restores those rows.";
  equal(u:curry_binary_product_table(u:uncurry_binary_function_rows(curried_function_rows)), curried_function_rows)
}
def u:bounded_pair_has_internal_hom(product_exists, exponential_is_complete, evaluation_is_correct, curry_laws_hold) {
  "Check product and exponential evidence for one displayed finite object pair.";
  product_exists * exponential_is_complete * evaluation_is_correct * curry_laws_hold
}
def u:global_element_selects_internal_hom_row(function_rows, selected_row_code) {
  "Interpret a singleton-to-internal-hom map by returning its selected function row.";
  take(function_rows, 0, selected_row_code)
}
def u:displayed_pairs_support_cartesian_closure(pair_certificates) {
  "Check cartesian-closed evidence only across the explicitly displayed finite object pairs.";
  reduce_mul(pair_certificates)
}
def u:cartesian_closed_boundary_visual() {
  "Render pair-level internal hom evidence, a singleton global element, and the missing category-wide coverage boundary.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 960 420\" role=\"img\"><title>internal hom global elements and cartesian closed boundary</title><desc>One finite object pair has a product and internal hom with evaluation. A singleton arrow selects one function row as a global element. A dashed missing pair prevents a category-wide cartesian closed conclusion.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(230px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(230px)}}</style><rect width=\"960\" height=\"420\" fill=\"rgb(26,27,38)\"/><text x=\"250\" y=\"28\" text-anchor=\"middle\">ONE PAIR: INTERNAL HOM</text><rect class=\"obj\" x=\"45\" y=\"60\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"310\" y=\"60\" width=\"180\" height=\"65\" rx=\"12\"/><text x=\"135\" y=\"98\" text-anchor=\"middle\">B^A = 4 rows</text><text x=\"400\" y=\"98\" text-anchor=\"middle\">ev + curry laws</text><line class=\"arrow\" x1=\"225\" y1=\"92\" x2=\"310\" y2=\"92\"/><text x=\"250\" y=\"170\" text-anchor=\"middle\">pair certificate = PASS</text><text x=\"720\" y=\"28\" text-anchor=\"middle\">GLOBAL ELEMENT</text><rect class=\"obj\" x=\"550\" y=\"60\" width=\"120\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"790\" y=\"60\" width=\"130\" height=\"65\" rx=\"12\"/><text x=\"610\" y=\"98\" text-anchor=\"middle\">1 = {*}</text><text x=\"855\" y=\"98\" text-anchor=\"middle\">f2 [1,0]</text><line class=\"arrow\" x1=\"670\" y1=\"92\" x2=\"790\" y2=\"92\"/><circle class=\"token\" cx=\"660\" cy=\"115\" r=\"8\"/><text x=\"720\" y=\"170\" text-anchor=\"middle\">1 → B^A selects one element</text><text x=\"480\" y=\"245\" text-anchor=\"middle\">CARTESIAN CLOSED means EVERY object pair has this structure</text><rect class=\"obj\" x=\"110\" y=\"280\" width=\"210\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"640\" y=\"280\" width=\"210\" height=\"60\" rx=\"12\"/><text x=\"215\" y=\"316\" text-anchor=\"middle\">displayed pair ✓</text><text x=\"745\" y=\"316\" text-anchor=\"middle\">unverified pair ?</text><path class=\"bad\" d=\"M320 310H640\"/><text x=\"480\" y=\"375\" text-anchor=\"middle\">COUNTEREXAMPLE TO THE INFERENCE: coverage [1,0]</text><text x=\"480\" y=\"405\" text-anchor=\"middle\">finite evidence is not a category-wide theorem</text></svg>"
}
def u:finite_currying_visual() {
  "Render product-table currying and the opposite beta and eta round trips.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 960 420\" role=\"img\"><title>finite currying uncurrying beta and eta</title><desc>A flat function table on X times A reshapes into two rows in B to the A. Beta starts at the flat table and returns there. Eta starts at the function rows and returns there. A dashed swapped entry breaks the round trip.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(390px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(390px)}}</style><rect width=\"960\" height=\"420\" fill=\"rgb(26,27,38)\"/><text x=\"480\" y=\"30\" text-anchor=\"middle\">SAME DATA, TWO FUNCTION SHAPES</text><rect class=\"obj\" x=\"65\" y=\"70\" width=\"280\" height=\"90\" rx=\"14\"/><rect class=\"obj\" x=\"615\" y=\"70\" width=\"280\" height=\"90\" rx=\"14\"/><text x=\"205\" y=\"105\" text-anchor=\"middle\">h : X×A → B</text><text x=\"205\" y=\"140\" text-anchor=\"middle\">[0,1,1,0]</text><text x=\"755\" y=\"105\" text-anchor=\"middle\">curry(h) : X → B^A</text><text x=\"755\" y=\"140\" text-anchor=\"middle\">[[0,1],[1,0]]</text><line class=\"arrow\" x1=\"345\" y1=\"95\" x2=\"615\" y2=\"95\"/><line class=\"arrow\" x1=\"615\" y1=\"140\" x2=\"345\" y2=\"140\"/><text x=\"480\" y=\"82\" text-anchor=\"middle\">curry</text><text x=\"480\" y=\"158\" text-anchor=\"middle\">uncurry</text><circle class=\"token\" cx=\"330\" cy=\"115\" r=\"8\"/><text x=\"240\" y=\"225\" text-anchor=\"middle\">BETA starts with h</text><text x=\"240\" y=\"258\" text-anchor=\"middle\">uncurry(curry(h)) = h</text><text x=\"720\" y=\"225\" text-anchor=\"middle\">ETA starts with k</text><text x=\"720\" y=\"258\" text-anchor=\"middle\">curry(uncurry(k)) = k</text><text x=\"480\" y=\"315\" text-anchor=\"middle\">COUNTEREXAMPLE: swap one output during reshape</text><path class=\"bad\" d=\"M245 345H715\"/><text x=\"480\" y=\"390\" text-anchor=\"middle\">fixed 2×2 tables; no generic callable curry</text></svg>"
}
def u:finite_exponentials_visual() {
  "Render four function rows as B-to-the-A and evaluation from a selected function-input pair.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 920 390\" role=\"img\"><title>finite exponential object and evaluation</title><desc>The exponential B to the A contains all four functions from the two-point A to the two-point B. A selected function row and input travel through evaluation to the correct output. A dashed path shows a wrong-row counterexample.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(310px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(310px)}}</style><rect width=\"920\" height=\"390\" fill=\"rgb(26,27,38)\"/><text x=\"220\" y=\"28\" text-anchor=\"middle\">B^A = ALL FUNCTIONS A → B</text><rect class=\"obj\" x=\"45\" y=\"50\" width=\"350\" height=\"210\" rx=\"14\"/><text x=\"220\" y=\"88\" text-anchor=\"middle\">f0 [0,0] constant 0</text><text x=\"220\" y=\"128\" text-anchor=\"middle\">f1 [0,1] identity</text><text x=\"220\" y=\"168\" text-anchor=\"middle\">f2 [1,0] negate</text><text x=\"220\" y=\"208\" text-anchor=\"middle\">f3 [1,1] constant 1</text><text x=\"220\" y=\"245\" text-anchor=\"middle\">4 = 2^2 rows</text><text x=\"665\" y=\"28\" text-anchor=\"middle\">EVALUATION ev: B^A × A → B</text><rect class=\"obj\" x=\"490\" y=\"75\" width=\"190\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"770\" y=\"75\" width=\"105\" height=\"70\" rx=\"14\"/><text x=\"585\" y=\"117\" text-anchor=\"middle\">(f2, input 0)</text><text x=\"822\" y=\"117\" text-anchor=\"middle\">output 1</text><line class=\"arrow\" x1=\"680\" y1=\"110\" x2=\"770\" y2=\"110\"/><text x=\"725\" y=\"95\" text-anchor=\"middle\">ev</text><circle class=\"token\" cx=\"505\" cy=\"135\" r=\"8\"/><text x=\"460\" y=\"300\" text-anchor=\"middle\">COUNTEREXAMPLE: choose f1 instead of f2</text><path class=\"bad\" d=\"M250 325H670\"/><text x=\"720\" y=\"332\">gets 0, not 1</text><text x=\"460\" y=\"375\" text-anchor=\"middle\">finite Set fixture; not exponentials in every category</text></svg>"
}
