# lib/finite_slices.mlpl -- bounded slice and coslice objects and morphisms.
# loops: 0
def u:make_slice_object(domain_values, base_values, map_to_base) { "Build one finite object over a fixed base for a bounded slice category."; {domain: domain_values, base: base_values, map_to_base: map_to_base} }
def u:make_coslice_object(base_values, codomain_values, map_from_base) { "Build one finite object under a fixed base for a bounded coslice category."; {base: base_values, codomain: codomain_values, map_from_base: map_from_base} }
def u:slice_morphism_triangle_commutes(via_target_to_base, directly_to_base) { "Check that a bounded morphism between objects over the base commutes with their structure maps."; equal(via_target_to_base, directly_to_base) }
def u:coslice_morphism_triangle_commutes(via_source_from_base, directly_from_base) { "Check that a bounded morphism between objects under the base commutes with their structure maps."; equal(via_source_from_base, directly_from_base) }
def u:bounded_triangle_category_laws_hold(identity_checks, composite_check) { "Check displayed identity triangles and one displayed composite triangle."; reduce_mul(identity_checks) * composite_check }
def u:finite_slices_visual() { "Render slice arrows toward a base, coslice arrows away from it, and broken triangles."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 980 430\" role=\"img\"><title>finite slice and coslice categories</title><desc>The slice triangle has objects pointing to a fixed base. The coslice triangle has arrows pointing from the fixed base. Green triangles commute and dashed edges show a changed route that fails.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translate(100px,125px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(100px,125px)}}</style><rect width=\"980\" height=\"430\" fill=\"rgb(26,27,38)\"/><text x=\"245\" y=\"28\" text-anchor=\"middle\">SLICE C/B: OBJECTS OVER B</text><rect class=\"obj\" x=\"55\" y=\"55\" width=\"140\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"300\" y=\"55\" width=\"140\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"175\" y=\"220\" width=\"140\" height=\"60\" rx=\"12\"/><text x=\"125\" y=\"92\" text-anchor=\"middle\">X → B</text><text x=\"370\" y=\"92\" text-anchor=\"middle\">Y → B</text><text x=\"245\" y=\"257\" text-anchor=\"middle\">fixed B</text><line class=\"arrow\" x1=\"195\" y1=\"85\" x2=\"300\" y2=\"85\"/><line class=\"arrow\" x1=\"125\" y1=\"115\" x2=\"210\" y2=\"220\"/><line class=\"arrow\" x1=\"370\" y1=\"115\" x2=\"280\" y2=\"220\"/><text x=\"735\" y=\"28\" text-anchor=\"middle\">COSLICE B/C: OBJECTS UNDER B</text><rect class=\"obj\" x=\"545\" y=\"55\" width=\"140\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"790\" y=\"55\" width=\"140\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"665\" y=\"220\" width=\"140\" height=\"60\" rx=\"12\"/><text x=\"615\" y=\"92\" text-anchor=\"middle\">B → X</text><text x=\"860\" y=\"92\" text-anchor=\"middle\">B → Y</text><text x=\"735\" y=\"257\" text-anchor=\"middle\">fixed B</text><line class=\"arrow\" x1=\"685\" y1=\"85\" x2=\"790\" y2=\"85\"/><line class=\"arrow\" x1=\"700\" y1=\"220\" x2=\"625\" y2=\"115\"/><line class=\"arrow\" x1=\"770\" y1=\"220\" x2=\"850\" y2=\"115\"/><circle class=\"token\" cx=\"120\" cy=\"100\" r=\"8\"/><text x=\"490\" y=\"330\" text-anchor=\"middle\">IDENTITIES AND COMPOSITES MUST KEEP THE TRIANGLE COMMUTING</text><path class=\"bad\" d=\"M250 365H730\"/><text x=\"490\" y=\"405\" text-anchor=\"middle\">COUNTEREXAMPLE: changed base route [1,0] ≠ [0,1]</text></svg>" }
