# lib/finite_frobenius_spiders.mlpl -- attributed finite Frobenius and spider rewrites.
# loops: 0
def u:frobenius_compatibility_holds(merge_then_split_route, split_then_parallel_merge_route) {
  "Compare two independently constructed finite merge/split routes for the Frobenius compatibility equation.";
  equal(merge_then_split_route, split_then_parallel_merge_route)
}
def u:special_frobenius_holds(comultiply_then_multiply, identity_results) {
  "Check that multiplication after comultiplication is the identity on the attributed finite fixture.";
  equal(comultiply_then_multiply, identity_results)
}
def u:bounded_spider_rewrite_holds(many_node_boundary, one_node_boundary, many_node_endpoint, one_node_endpoint) {
  "Require equal typed boundaries and endpoint tables for one connected many-node to one-node spider rewrite.";
  equal(many_node_boundary, one_node_boundary) * equal(many_node_endpoint, one_node_endpoint)
}
def u:finite_frobenius_spiders_visual() {
  "Render Frobenius routes, specialness, and one bounded same-boundary spider rewrite.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1120 660\" role=\"img\"><title>finite Frobenius and spider rewrites</title><desc>Two directed merge and split graphs have the same endpoint table, multiplication after comultiplication is identity, and one connected multi-node graph has the same typed boundary and endpoint as a single spider. This bounded fixture is not the general spider theorem.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.node{fill:rgb(224,175,104);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.other{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:4;fill:none}.bad{stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:10 7;fill:none}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(135px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(135px)}}</style><rect class=\"obj\" x=\"0\" y=\"0\" width=\"0\" height=\"0\"/><rect width=\"1120\" height=\"660\" fill=\"rgb(26,27,38)\"/><text x=\"280\" y=\"35\" text-anchor=\"middle\">FROBENIUS ROUTE 1</text><text x=\"840\" y=\"35\" text-anchor=\"middle\">FROBENIUS ROUTE 2</text><text x=\"60\" y=\"105\">bit in 1</text><text x=\"60\" y=\"185\">bit in 2</text><path class=\"arrow\" d=\"M130 100H230\"/><path class=\"arrow\" d=\"M130 180H230\"/><circle class=\"node\" cx=\"250\" cy=\"140\" r=\"24\"/><text x=\"250\" y=\"146\" text-anchor=\"middle\">μ</text><path class=\"arrow\" d=\"M274 140H385\"/><circle class=\"node\" cx=\"410\" cy=\"140\" r=\"24\"/><text x=\"410\" y=\"146\" text-anchor=\"middle\">δ</text><path class=\"arrow\" d=\"M430 130L510 95\"/><path class=\"arrow\" d=\"M430 150L510 190\"/><circle class=\"token\" cx=\"290\" cy=\"140\" r=\"7\"/><text x=\"620\" y=\"105\">bit in 1</text><text x=\"620\" y=\"185\">bit in 2</text><path class=\"other\" d=\"M690 100H770\"/><path class=\"other\" d=\"M690 180H770\"/><circle class=\"node\" cx=\"795\" cy=\"100\" r=\"24\"/><circle class=\"node\" cx=\"795\" cy=\"180\" r=\"24\"/><text x=\"795\" y=\"106\" text-anchor=\"middle\">δ</text><text x=\"795\" y=\"186\" text-anchor=\"middle\">μ</text><path class=\"other\" d=\"M819 100H1020\"/><path class=\"other\" d=\"M819 180H1020\"/><text x=\"560\" y=\"255\" text-anchor=\"middle\">independent routes → endpoint [0,0,1,1]</text><text x=\"280\" y=\"315\" text-anchor=\"middle\">SPECIALNESS</text><path class=\"arrow\" d=\"M80 370H200\"/><circle class=\"node\" cx=\"225\" cy=\"370\" r=\"24\"/><text x=\"225\" y=\"376\" text-anchor=\"middle\">δ</text><path class=\"arrow\" d=\"M249 370H350\"/><circle class=\"node\" cx=\"375\" cy=\"370\" r=\"24\"/><text x=\"375\" y=\"376\" text-anchor=\"middle\">μ</text><path class=\"arrow\" d=\"M399 370H510\"/><text x=\"280\" y=\"420\" text-anchor=\"middle\">μ∘δ = id on [0,1]</text><text x=\"840\" y=\"315\" text-anchor=\"middle\">BOUNDED SPIDER REWRITE</text><circle class=\"node\" cx=\"700\" cy=\"370\" r=\"24\"/><circle class=\"node\" cx=\"810\" cy=\"370\" r=\"24\"/><path class=\"other\" d=\"M724 370H786\"/><text x=\"700\" y=\"376\" text-anchor=\"middle\">δ</text><text x=\"810\" y=\"376\" text-anchor=\"middle\">μ</text><text x=\"875\" y=\"376\">=</text><circle class=\"node\" cx=\"970\" cy=\"370\" r=\"38\"/><text x=\"970\" y=\"376\" text-anchor=\"middle\">spider</text><text x=\"840\" y=\"440\" text-anchor=\"middle\">same boundary 2→2; same endpoint table</text><rect class=\"bad\" x=\"250\" y=\"500\" width=\"620\" height=\"70\" rx=\"10\"/><text x=\"560\" y=\"542\" text-anchor=\"middle\">changed route, identity, boundary, or endpoint is rejected</text><text x=\"560\" y=\"625\" text-anchor=\"middle\">one classical-bit fixture ≠ general spider theorem</text></svg>"
}
