# lib/preservation_creation_reflection.mlpl -- bounded before/after universal checks.
# loops: 0

def u:functor_preserves_limit(source_is_limit, image_is_limit) {
  "Check that a known bounded source limit remains a limit after the functor acts.";
  source_is_limit * image_is_limit
}
def u:functor_preserves_colimit(source_is_colimit, image_is_colimit) {
  "Check dually that a known bounded source colimit remains a colimit after the functor acts.";
  source_is_colimit * image_is_colimit
}
def u:functor_reflects_limit(image_is_limit, source_is_limit) {
  "Check that bounded universality detected in the image was already present in the source.";
  image_is_limit * source_is_limit
}
def u:functor_creates_limit(target_is_limit, lifted_source_is_limit, lift_count) {
  "Check that a target limit has exactly one lifted source cone and that lift is universal.";
  target_is_limit * lifted_source_is_limit * eq(lift_count, 1)
}
def u:preservation_failure_witness(source_is_universal, image_is_universal) {
  "Expose a universal source cone whose image is not universal.";
  {found: source_is_universal * (1 - image_is_universal), source: source_is_universal, image: image_is_universal}
}
def u:reflection_failure_witness(image_is_limit, source_is_limit) {
  "Expose an image limit whose original source cone is not universal.";
  {found: image_is_limit * (1 - source_is_limit), source: source_is_limit, image: image_is_limit}
}
def u:creation_failure_witness(target_is_limit, lift_count) {
  "Expose a target limit without a unique source lift.";
  {found: target_is_limit * (1 - eq(lift_count, 1)), lift_count: lift_count}
}
def u:preservation_creation_reflection_visual() {
  "Render four bounded before/after checks with distinct failure witnesses.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 960 420\" role=\"img\"><title>preservation creation and reflection are different functor properties</title><desc>Four labeled panels compare bounded universal cones before and after a functor. Dashed paths show loss of universality, false reflection, and nonunique lifting.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(210px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(210px)}}</style><rect width=\"960\" height=\"420\" fill=\"rgb(26,27,38)\"/><text x=\"240\" y=\"28\" text-anchor=\"middle\">PRESERVES LIMIT</text><rect class=\"obj\" x=\"45\" y=\"55\" width=\"170\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"300\" y=\"55\" width=\"170\" height=\"55\" rx=\"10\"/><text x=\"130\" y=\"88\" text-anchor=\"middle\">source LIMIT</text><text x=\"385\" y=\"88\" text-anchor=\"middle\">image LIMIT</text><line class=\"arrow\" x1=\"215\" y1=\"82\" x2=\"300\" y2=\"82\"/><text x=\"258\" y=\"70\">F</text><text x=\"720\" y=\"28\" text-anchor=\"middle\">PRESERVES COLIMIT (DUAL)</text><rect class=\"obj\" x=\"525\" y=\"55\" width=\"170\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"780\" y=\"55\" width=\"150\" height=\"55\" rx=\"10\"/><text x=\"610\" y=\"88\" text-anchor=\"middle\">source COLIMIT</text><text x=\"855\" y=\"88\" text-anchor=\"middle\">image COLIMIT</text><line class=\"arrow\" x1=\"695\" y1=\"82\" x2=\"780\" y2=\"82\"/><text x=\"738\" y=\"70\">F</text><text x=\"240\" y=\"165\" text-anchor=\"middle\">REFLECTS LIMIT: detect backward</text><rect class=\"obj\" x=\"45\" y=\"190\" width=\"170\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"300\" y=\"190\" width=\"170\" height=\"55\" rx=\"10\"/><text x=\"130\" y=\"223\" text-anchor=\"middle\">source LIMIT</text><text x=\"385\" y=\"223\" text-anchor=\"middle\">image LIMIT</text><line class=\"arrow\" x1=\"300\" y1=\"217\" x2=\"215\" y2=\"217\"/><text x=\"258\" y=\"205\">infer</text><text x=\"720\" y=\"165\" text-anchor=\"middle\">CREATES LIMIT: uniquely lift</text><rect class=\"obj\" x=\"525\" y=\"190\" width=\"170\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"780\" y=\"190\" width=\"150\" height=\"55\" rx=\"10\"/><text x=\"610\" y=\"223\" text-anchor=\"middle\">unique source lift</text><text x=\"855\" y=\"223\" text-anchor=\"middle\">target LIMIT</text><line class=\"arrow\" x1=\"780\" y1=\"217\" x2=\"695\" y2=\"217\"/><text x=\"738\" y=\"205\">lift</text><text x=\"480\" y=\"292\" text-anchor=\"middle\">COUNTEREXAMPLES KEEP THE WORDS DISTINCT</text><path class=\"bad\" d=\"M100 330H280\"/><text x=\"190\" y=\"320\" text-anchor=\"middle\">lost universality</text><path class=\"bad\" d=\"M390 330H570\"/><text x=\"480\" y=\"320\" text-anchor=\"middle\">image limit; source not</text><path class=\"bad\" d=\"M680 330H860\"/><text x=\"770\" y=\"320\" text-anchor=\"middle\">2 lifts: not created</text><circle class=\"token\" cx=\"90\" cy=\"98\" r=\"8\"/><text x=\"480\" y=\"390\" text-anchor=\"middle\">bounded certificates: [source, image, unique lifts]</text></svg>"
}
