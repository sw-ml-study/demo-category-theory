# lib/finite_group_module_boundary.mlpl -- group-object packaging and module-fixture boundary.
# loops: 0
def u:group_object_inverse_diagram_holds(left_inverse_results, right_inverse_results, identity_results) {
  "Check that the displayed inverse morphism reaches the unit through multiplication on both sides.";
  equal(left_inverse_results, identity_results) * equal(right_inverse_results, identity_results)
}
def u:module_action_fixture_is_complete(scalar_action_present, scalar_associativity_present, scalar_unit_present, additive_compatibility_present) {
  "Require all four displayed data obligations before claiming a finite module-object fixture.";
  scalar_action_present * scalar_associativity_present * scalar_unit_present * additive_compatibility_present
}
def u:finite_group_module_boundary_visual() {
  "Render a Z2 group-object inverse diagram beside the missing module-action fixture obligations.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1060 480\" role=\"img\"><title>group object and module fixture boundary</title><desc>The left panel packages the attributed Z2 multiplication, unit, and inverse as internal arrows whose two inverse routes reach the unit. The right panel lists four required module-action data obligations; all are dashed and absent, so no module object is claimed.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.bad{stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:10 7;fill:none}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(190px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(190px)}}</style><rect width=\"1060\" height=\"480\" fill=\"rgb(26,27,38)\"/><text x=\"260\" y=\"30\" text-anchor=\"middle\">CT099 GROUP OBJECT: Z₂ FIXTURE</text><rect class=\"obj\" x=\"55\" y=\"80\" width=\"150\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"335\" y=\"80\" width=\"150\" height=\"60\" rx=\"12\"/><text x=\"130\" y=\"117\" text-anchor=\"middle\">G</text><text x=\"410\" y=\"117\" text-anchor=\"middle\">G</text><path class=\"arrow\" d=\"M205 100H335\"/><text x=\"270\" y=\"88\" text-anchor=\"middle\">inverse i</text><path class=\"arrow\" d=\"M130 140C160 255 350 255 410 140\"/><text x=\"270\" y=\"250\" text-anchor=\"middle\">μ(id⊗i)=ηε=μ(i⊗id)</text><circle class=\"token\" cx=\"195\" cy=\"110\" r=\"8\"/><text x=\"260\" y=\"300\" text-anchor=\"middle\">inverse outputs [0,0] on both sides</text><text x=\"795\" y=\"30\" text-anchor=\"middle\">CT100 MODULE OBJECT: NOT YET CLAIMED</text><rect class=\"bad\" x=\"585\" y=\"75\" width=\"420\" height=\"250\" rx=\"14\"/><text x=\"795\" y=\"115\" text-anchor=\"middle\">missing stable attributed fixture:</text><text x=\"795\" y=\"160\" text-anchor=\"middle\">□ scalar action R⊗M → M</text><text x=\"795\" y=\"200\" text-anchor=\"middle\">□ scalar associativity</text><text x=\"795\" y=\"240\" text-anchor=\"middle\">□ scalar unit</text><text x=\"795\" y=\"280\" text-anchor=\"middle\">□ additive compatibility</text><line class=\"bad\" x1=\"560\" y1=\"370\" x2=\"1020\" y2=\"370\"/><text x=\"530\" y=\"430\" text-anchor=\"middle\">scope evidence, not runtime syntax, gates the module lesson</text></svg>"
}
