# lib/finite_limits_colimits.mlpl -- cones, cocones, and bounded universality.
# loops: 0

def u:apply_two_point_table(table, inputs) { "Apply one finite function table to two explicit inputs."; [take(table, 0, take(inputs, 0, 0)), take(table, 0, take(inputs, 0, 1))] }
def u:apply_three_point_table(table, inputs) { "Apply one finite function table to three explicit inputs."; [take(table, 0, take(inputs, 0, 0)), take(table, 0, take(inputs, 0, 1)), take(table, 0, take(inputs, 0, 2))] }
def u:cone_routes(diagram_arrow, leg_to_source, leg_to_target) { "Compare the two routes from a cone apex into a one-arrow finite diagram."; through_source = u:apply_two_point_table(diagram_arrow, leg_to_source); {commutes: equal(through_source, leg_to_target), through_source: through_source, direct_target: leg_to_target} }
def u:cocone_routes(diagram_arrow, leg_from_source, leg_from_target) { "Compare the two routes from a one-arrow finite diagram into a cocone apex."; through_target = u:apply_three_point_table(leg_from_target, diagram_arrow); {commutes: equal(through_target, leg_from_source), direct_source: leg_from_source, through_target: through_target} }
def u:terminal_cone_from_factor_counts(candidate_codes, factor_counts) { "Select the coded terminal cone when every bounded candidate has one mediator into it."; {code: take(candidate_codes, 0, 0), universal: equal(factor_counts, fill([3], 1)), factor_counts: factor_counts} }
def u:initial_cocone_from_factor_counts(candidate_codes, factor_counts) { "Select the coded initial cocone when it has one mediator into every bounded candidate."; {code: take(candidate_codes, 0, 0), universal: equal(factor_counts, fill([3], 1)), factor_counts: factor_counts} }
def u:finite_limit_shape_codes() { "Code product, equalizer, and pullback as the three previously executed finite-limit shapes."; [1, 2, 3] }
def u:finite_colimit_shape_codes() { "Code coproduct, coequalizer, and pushout as the three previously executed finite-colimit shapes."; [4, 5, 6] }
def u:bounded_universality_witness(concept, factor_counts) { "Retain a counterexample when a bounded cone or cocone lacks unique factorization."; {found: 1 - equal(factor_counts, fill([3], 1)), concept: concept, factor_counts: factor_counts} }
def u:chain_cone_routes(first_arrow, second_arrow, leg_to_first, leg_to_middle, leg_to_last) { "Check both compatibility equations for a cone into a two-arrow finite chain."; first_route = u:apply_two_point_table(first_arrow, leg_to_first); second_route = u:apply_two_point_table(second_arrow, leg_to_middle); {commutes: equal(first_route, leg_to_middle) * equal(second_route, leg_to_last), first_route: first_route, second_route: second_route} }
def u:chain_cocone_routes(first_arrow, second_arrow, leg_from_first, leg_from_middle, leg_from_last) { "Check both compatibility equations for a cocone out of a two-arrow finite chain."; through_middle = u:apply_two_point_table(leg_from_middle, first_arrow); through_last = u:apply_two_point_table(leg_from_last, second_arrow); {commutes: equal(through_middle, leg_from_first) * equal(through_last, leg_from_middle), through_middle: through_middle, through_last: through_last} }
def u:bounded_chain_cone_is_limit(routes, mediator_counts) { "Check compatibility and unique mediation for a bounded chain limit cone."; routes.commutes * equal(mediator_counts, fill([3], 1)) }
def u:bounded_chain_cocone_is_colimit(routes, mediator_counts) { "Check compatibility and unique mediation for a bounded chain colimit cocone."; routes.commutes * equal(mediator_counts, fill([3], 1)) }
def u:generalized_bounded_cones_visual() { "Return a directed two-arrow diagram with cone and cocone apexes."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 360\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.leg{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:3}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(275px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(275px)}}</style><rect width=\"900\" height=\"360\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"80\" y=\"155\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"375\" y=\"155\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"670\" y=\"155\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"230\" y1=\"182\" x2=\"375\" y2=\"182\"/><line class=\"arrow\" x1=\"525\" y1=\"182\" x2=\"670\" y2=\"182\"/><rect class=\"obj\" x=\"375\" y=\"25\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"leg\" x1=\"410\" y1=\"80\" x2=\"190\" y2=\"155\"/><line class=\"leg\" x1=\"450\" y1=\"80\" x2=\"450\" y2=\"155\"/><line class=\"leg\" x1=\"490\" y1=\"80\" x2=\"710\" y2=\"155\"/><rect class=\"obj\" x=\"375\" y=\"280\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"leg\" x1=\"155\" y1=\"210\" x2=\"410\" y2=\"280\"/><line class=\"leg\" x1=\"450\" y1=\"210\" x2=\"450\" y2=\"280\"/><line class=\"leg\" x1=\"745\" y1=\"210\" x2=\"490\" y2=\"280\"/><text x=\"450\" y=\"58\" text-anchor=\"middle\">limit cone</text><text x=\"155\" y=\"188\" text-anchor=\"middle\">A</text><text x=\"450\" y=\"188\" text-anchor=\"middle\">B</text><text x=\"745\" y=\"188\" text-anchor=\"middle\">C</text><text x=\"450\" y=\"313\" text-anchor=\"middle\">colimit cocone</text><circle class=\"token\" cx=\"185\" cy=\"165\" r=\"8\"/></svg>" }
