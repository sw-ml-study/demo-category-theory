# lib/finite_monoidal_functors.mlpl -- directed monoidal comparison maps and coverage.
# loops: 0
def u:monoidal_functor_coherence_holds(tensor_route_left, tensor_route_right, unit_route_left, unit_route_right) { "Check the tensor and unit coherence endpoints for one finite monoidal-functor fixture."; equal(tensor_route_left, tensor_route_right) * equal(unit_route_left, unit_route_right) }
def u:strong_monoidal_comparisons_are_inverse(forward_then_reverse, source_identity, reverse_then_forward, target_identity) { "Require both composites of the strong tensor comparison maps to be the appropriate identities."; equal(forward_then_reverse, source_identity) * equal(reverse_then_forward, target_identity) }
def u:monoidal_natural_transformation_is_compatible(naturality_route_left, naturality_route_right, tensor_route_left, tensor_route_right, unit_route_left, unit_route_right) { "Check naturality together with the tensor and unit compatibility diagrams for one finite transformation."; equal(naturality_route_left, naturality_route_right) * equal(tensor_route_left, tensor_route_right) * equal(unit_route_left, unit_route_right) }
def u:closed_monoidal_pair_coverage_is_complete(pair_evidence) { "Require evidence for every enumerated object pair before calling the finite fixture closed monoidal."; reduce_mul(pair_evidence) }
def u:finite_monoidal_functors_visual() { "Render opposite lax and oplax comparisons, invertible strong comparisons, a compatibility square, and incomplete closedness coverage."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1100 650\" role=\"img\"><title>monoidal functor comparison maps</title><desc>Lax and oplax tensor comparisons point in opposite directions. Strong comparisons point both ways and pass inverse checks. A monoidal natural transformation square commutes. Closedness is not claimed because one required object pair lacks evidence.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.reverse{marker-end:url(\\23 arrowhead);stroke:rgb(224,175,104);stroke-width:4;fill:none}.bad{stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:10 7;fill:none}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(205px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(205px)}}</style><rect width=\"1100\" height=\"650\" fill=\"rgb(26,27,38)\"/><text x=\"275\" y=\"35\" text-anchor=\"middle\">LAX: F(A)⊗F(B) → F(A⊗B)</text><rect class=\"obj\" x=\"45\" y=\"65\" width=\"190\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"320\" y=\"65\" width=\"190\" height=\"55\" rx=\"10\"/><text x=\"140\" y=\"99\" text-anchor=\"middle\">F(A)⊗F(B)</text><text x=\"415\" y=\"99\" text-anchor=\"middle\">F(A⊗B)</text><path class=\"arrow\" d=\"M235 92H320\"/><circle class=\"token\" cx=\"245\" cy=\"92\" r=\"7\"/><text x=\"825\" y=\"35\" text-anchor=\"middle\">OPLAX: F(A⊗B) → F(A)⊗F(B)</text><rect class=\"obj\" x=\"595\" y=\"65\" width=\"190\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"870\" y=\"65\" width=\"190\" height=\"55\" rx=\"10\"/><text x=\"690\" y=\"99\" text-anchor=\"middle\">F(A⊗B)</text><text x=\"965\" y=\"99\" text-anchor=\"middle\">F(A)⊗F(B)</text><path class=\"reverse\" d=\"M785 92H870\"/><text x=\"275\" y=\"175\" text-anchor=\"middle\">STRONG = BOTH MAPS + BOTH INVERSE COMPOSITES</text><path class=\"arrow\" d=\"M145 230H405\"/><path class=\"reverse\" d=\"M405 260H145\"/><text x=\"275\" y=\"220\" text-anchor=\"middle\">comparison</text><text x=\"275\" y=\"290\" text-anchor=\"middle\">inverse comparison</text><text x=\"825\" y=\"175\" text-anchor=\"middle\">MONOIDAL NATURAL TRANSFORMATION</text><rect class=\"obj\" x=\"620\" y=\"205\" width=\"150\" height=\"50\" rx=\"8\"/><rect class=\"obj\" x=\"900\" y=\"205\" width=\"150\" height=\"50\" rx=\"8\"/><rect class=\"obj\" x=\"620\" y=\"335\" width=\"150\" height=\"50\" rx=\"8\"/><rect class=\"obj\" x=\"900\" y=\"335\" width=\"150\" height=\"50\" rx=\"8\"/><text x=\"695\" y=\"237\" text-anchor=\"middle\">F(A)⊗F(B)</text><text x=\"975\" y=\"237\" text-anchor=\"middle\">G(A)⊗G(B)</text><text x=\"695\" y=\"367\" text-anchor=\"middle\">F(A⊗B)</text><text x=\"975\" y=\"367\" text-anchor=\"middle\">G(A⊗B)</text><path class=\"arrow\" d=\"M770 230H900\"/><path class=\"arrow\" d=\"M770 360H900\"/><path class=\"arrow\" d=\"M695 255V335\"/><path class=\"arrow\" d=\"M975 255V335\"/><text x=\"825\" y=\"420\" text-anchor=\"middle\">both routes = [A,B]</text><text x=\"550\" y=\"480\" text-anchor=\"middle\">CLOSED MONOIDAL REQUIRES EVERY ENUMERATED PAIR</text><rect class=\"obj\" x=\"250\" y=\"515\" width=\"230\" height=\"65\" rx=\"10\"/><rect class=\"bad\" x=\"620\" y=\"515\" width=\"230\" height=\"65\" rx=\"10\"/><text x=\"365\" y=\"555\" text-anchor=\"middle\">✓ pair (A,A)</text><text x=\"735\" y=\"555\" text-anchor=\"middle\">□ pair (A,B)</text><text x=\"550\" y=\"625\" text-anchor=\"middle\">coverage [1,0] — boundary, not a closedness claim</text></svg>" }
