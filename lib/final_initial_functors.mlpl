# lib/final_initial_functors.mlpl -- bounded comma-category evidence for finality and initiality.
# loops: 0

def u:bounded_functor_is_final(comma_categories_are_nonempty, comma_categories_are_connected) { "Check nonemptiness and connectedness of every displayed comma category c down to u."; reduce_mul(comma_categories_are_nonempty) * reduce_mul(comma_categories_are_connected) }
def u:bounded_functor_is_initial(comma_categories_are_nonempty, comma_categories_are_connected) { "Check nonemptiness and connectedness of every displayed comma category u down to c."; reduce_mul(comma_categories_are_nonempty) * reduce_mul(comma_categories_are_connected) }
def u:bounded_final_functor_preserves_colimit_value(source_colimit_value, restricted_colimit_value) { "Compare colimit values for one finite diagram and its restriction along a bounded final functor."; eq(source_colimit_value, restricted_colimit_value) }
def u:bounded_initial_functor_preserves_limit_value(source_limit_value, restricted_limit_value) { "Compare limit values for one finite diagram and its restriction along a bounded initial functor."; eq(source_limit_value, restricted_limit_value) }
def u:final_initial_functors_visual() { "Render the opposite comma orientations for bounded final and initial functor witnesses."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 980 430\" role=\"img\"><title>final and initial functors use opposite comma categories</title><desc>The left panel shows c down to u for finality and preservation of a displayed colimit. The right panel shows u down to c for initiality and preservation of a displayed limit. A dashed crossed warning rejects swapping the comma orientations.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(105px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(105px)}}</style><rect width=\"980\" height=\"430\" fill=\"rgb(26,27,38)\"/><text x=\"245\" y=\"30\" text-anchor=\"middle\">FINAL FUNCTOR u: D → C</text><rect class=\"obj\" x=\"65\" y=\"60\" width=\"150\" height=\"58\" rx=\"10\"/><rect class=\"obj\" x=\"285\" y=\"60\" width=\"150\" height=\"58\" rx=\"10\"/><text x=\"140\" y=\"95\" text-anchor=\"middle\">c in C</text><text x=\"360\" y=\"95\" text-anchor=\"middle\">u(d) in C</text><line class=\"arrow\" x1=\"215\" y1=\"89\" x2=\"285\" y2=\"89\"/><text x=\"250\" y=\"75\" text-anchor=\"middle\">c ↓ u</text><text x=\"245\" y=\"150\" text-anchor=\"middle\">nonempty + connected</text><rect class=\"obj\" x=\"125\" y=\"185\" width=\"240\" height=\"58\" rx=\"10\"/><text x=\"245\" y=\"220\" text-anchor=\"middle\">same finite COLIMIT</text><text x=\"735\" y=\"30\" text-anchor=\"middle\">INITIAL FUNCTOR u: D → C</text><rect class=\"obj\" x=\"545\" y=\"60\" width=\"150\" height=\"58\" rx=\"10\"/><rect class=\"obj\" x=\"765\" y=\"60\" width=\"150\" height=\"58\" rx=\"10\"/><text x=\"620\" y=\"95\" text-anchor=\"middle\">u(d) in C</text><text x=\"840\" y=\"95\" text-anchor=\"middle\">c in C</text><line class=\"arrow\" x1=\"695\" y1=\"89\" x2=\"765\" y2=\"89\"/><text x=\"730\" y=\"75\" text-anchor=\"middle\">u ↓ c</text><text x=\"735\" y=\"150\" text-anchor=\"middle\">nonempty + connected</text><rect class=\"obj\" x=\"615\" y=\"185\" width=\"240\" height=\"58\" rx=\"10\"/><text x=\"735\" y=\"220\" text-anchor=\"middle\">same finite LIMIT</text><text x=\"490\" y=\"290\" text-anchor=\"middle\">COUNTEREXAMPLE: comma direction is not interchangeable</text><path class=\"bad\" d=\"M285 330H695\"/><line class=\"bad\" x1=\"410\" y1=\"365\" x2=\"570\" y2=\"310\"/><text x=\"490\" y=\"395\" text-anchor=\"middle\">bounded witnesses for displayed objects only</text><circle class=\"token\" cx=\"140\" cy=\"105\" r=\"8\"/></svg>" }
