# lib/finite_subobjects.mlpl -- bounded subobjects, truth classification, and partial maps.
# loops: 0
def u:two_point_subobject_inventory_is_complete(membership_rows) { "Check the canonical inventory of all four membership predicates on a two-point set."; equal(membership_rows, [[0, 0], [1, 0], [0, 1], [1, 1]]) }
def u:characteristic_map_classifies_subobject(subobject_membership, characteristic_map) { "Check the finite truth-classification pullback by comparing membership with its characteristic map."; equal(subobject_membership, characteristic_map) }
def u:bounded_partial_map_is_well_formed(domain_membership, defined_outputs) { "Check that a partial map stores one output for each true position in its bounded domain subobject."; eq(reduce_add(domain_membership), take(shape(defined_outputs), 0, 0)) }
def u:finite_subobjects_visual() { "Render four subobjects, truth classification, and a domain-restricted partial map."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 980 440\" role=\"img\"><title>finite subobjects characteristic maps and partial maps</title><desc>Four membership rows enumerate the subobjects of a two-point set. One row maps into the two-valued truth object and pulls truth back to the subobject. A partial map is defined only on that chosen domain. A dashed mismatched characteristic row fails.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(190px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(190px)}}</style><rect width=\"980\" height=\"440\" fill=\"rgb(26,27,38)\"/><text x=\"210\" y=\"28\" text-anchor=\"middle\">SUBOBJECTS OF X={0,1}</text><rect class=\"obj\" x=\"40\" y=\"55\" width=\"340\" height=\"190\" rx=\"14\"/><text x=\"210\" y=\"92\" text-anchor=\"middle\">[0,0] empty</text><text x=\"210\" y=\"130\" text-anchor=\"middle\">[1,0] {0}</text><text x=\"210\" y=\"168\" text-anchor=\"middle\">[0,1] {1}</text><text x=\"210\" y=\"206\" text-anchor=\"middle\">[1,1] whole X</text><text x=\"700\" y=\"28\" text-anchor=\"middle\">CLASSIFY {0} WITH Ω={false,true}</text><rect class=\"obj\" x=\"480\" y=\"65\" width=\"150\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"790\" y=\"65\" width=\"140\" height=\"65\" rx=\"12\"/><text x=\"555\" y=\"103\" text-anchor=\"middle\">X [0,1]</text><text x=\"860\" y=\"103\" text-anchor=\"middle\">Ω [0,1]</text><line class=\"arrow\" x1=\"630\" y1=\"97\" x2=\"790\" y2=\"97\"/><text x=\"710\" y=\"82\" text-anchor=\"middle\">χ=[1,0]</text><circle class=\"token\" cx=\"620\" cy=\"120\" r=\"8\"/><text x=\"700\" y=\"165\" text-anchor=\"middle\">truth pullback recovers {0}</text><text x=\"245\" y=\"300\" text-anchor=\"middle\">PARTIAL MAP</text><rect class=\"obj\" x=\"65\" y=\"325\" width=\"200\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"365\" y=\"325\" width=\"150\" height=\"65\" rx=\"12\"/><text x=\"165\" y=\"363\" text-anchor=\"middle\">domain {0}</text><text x=\"440\" y=\"363\" text-anchor=\"middle\">output 9</text><line class=\"arrow\" x1=\"265\" y1=\"357\" x2=\"365\" y2=\"357\"/><text x=\"740\" y=\"285\" text-anchor=\"middle\">COUNTEREXAMPLE</text><path class=\"bad\" d=\"M590 335H885\"/><text x=\"740\" y=\"325\" text-anchor=\"middle\">χ=[0,1] classifies {1}, not {0}</text><text x=\"490\" y=\"425\" text-anchor=\"middle\">finite Set encoding; no static mono or partial-map type</text></svg>" }
