drawing_coordinates_after_move = [[20, 100], [120, 30], [220, 100]]
sequential_then_tensor_results = [2, 4]
tensor_then_sequential_results = [2, 4]
left_snake_endpoint = ["A"]
right_snake_endpoint = ["A*"]
feedback_route = [0, 1, 0, 1]
trace_route = [0, 1, 0, 1]
forward_process_path = ["prepare", "transform", "measure"]
reversed_process_path = ["measure*", "transform*", "prepare*"]
reversed_twice_process_path = ["prepare", "transform", "measure"]
frobenius_left_results = [0, 0, 1, 1]
frobenius_right_results = [0, 0, 1, 1]
special_composite_results = [0, 1]
identity_results = [0, 1]
many_node_spider_results = [0, 0, 1, 1]
one_node_spider_results = [0, 0, 1, 1]
ok({probe: "string-diagram-processes", typed_sequential_connection: u:port_connection_is_typed(first_box_outputs, second_box_inputs), semantic_isotopy_candidate: u:diagram_semantics_ignore_embedding(semantic_edges_before_move, semantic_edges_after_move), embedding_metadata_is_distinct: 1 - equal(drawing_coordinates_before_move, drawing_coordinates_after_move), interchange: u:interchange_rewrite_holds(sequential_then_tensor_results, tensor_then_sequential_results), cups_caps_snakes: u:cup_cap_snake_connectivity_holds(left_snake_endpoint, ["A"], right_snake_endpoint, ["A*"]), trace_feedback: u:trace_feedback_route_holds(feedback_route, trace_route), dagger_path: reversed_process_path, dagger_involutive: u:dagger_reversal_is_involutive(forward_process_path, reversed_twice_process_path), frobenius_special_spider: u:frobenius_spider_rewrites_hold(frobenius_left_results, frobenius_right_results, special_composite_results, identity_results, many_node_spider_results, one_node_spider_results), process_fixture: u:process_fixture_is_complete(1, 1, 1, 1)})
