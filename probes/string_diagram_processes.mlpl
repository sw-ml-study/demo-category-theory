# Probe: executable finite representations for CT110-CT129.
# visual: ascii
# loops: 0
def u:port_connection_is_typed(output_port_types, input_port_types) { "Check that sequentially connected finite diagram ports have matching types."; equal(output_port_types, input_port_types) }
def u:diagram_semantics_ignore_embedding(first_connectivity, second_connectivity) { "Compare semantic connectivity while deliberately ignoring separate drawing coordinates."; equal(first_connectivity, second_connectivity) }
def u:interchange_rewrite_holds(sequential_then_tensor, tensor_then_sequential) { "Check the finite interchange rewrite by comparing independently assembled endpoint tables."; equal(sequential_then_tensor, tensor_then_sequential) }
def u:cup_cap_snake_connectivity_holds(left_snake_endpoint, left_identity, right_snake_endpoint, right_identity) { "Check both finite cup-cap snake connectivity routes against their typed identities."; equal(left_snake_endpoint, left_identity) * equal(right_snake_endpoint, right_identity) }
def u:trace_feedback_route_holds(open_feedback_route, closed_trace_route) { "Compare an explicitly wired finite feedback route with its trace result."; equal(open_feedback_route, closed_trace_route) }
def u:dagger_reversal_is_involutive(original_path, reversed_twice_path) { "Check that reversing the displayed finite process path twice restores it."; equal(original_path, reversed_twice_path) }
def u:frobenius_spider_rewrites_hold(frobenius_left, frobenius_right, special_composite, identity_results, many_node_spider, one_node_spider) { "Check finite Frobenius, specialness, and same-boundary spider rewrite tables separately."; equal(frobenius_left, frobenius_right) * equal(special_composite, identity_results) * equal(many_node_spider, one_node_spider) }
def u:process_fixture_is_complete(state_present, effect_present, channel_present, classical_copy_delete_present) { "Require state, effect, channel, and classical copy-delete data before making the bounded process-theory claim."; state_present * effect_present * channel_present * classical_copy_delete_present }

