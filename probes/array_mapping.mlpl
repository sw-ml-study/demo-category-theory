# Probe: each over vectors and matrices in sw-MLPL 0.20.0.
# visual: ascii
# loops: 0
def u:id(x) { x }
def u:inc(x) { x + 1 }
def u:double(x) { 2 * x }
v = [1, 2, 3]
m = [[1, 2], [3, 4]]
vector_id = each(:u:id, v)
matrix_id = each(:u:id, m)
vector_composed = each(:u:double, each(:u:inc, v))
matrix_mapped = each(:u:inc, m)
ok({probe: "array-mapping", vector_id: vector_id, matrix_id: matrix_id, vector_composed: vector_composed, matrix_mapped: matrix_mapped, matrix_shape: shape(matrix_mapped)})
