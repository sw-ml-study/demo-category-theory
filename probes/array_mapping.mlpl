# Probe: each over vectors and matrices in sw-MLPL 0.20.0.
# visual: ascii
# loops: 0
def u:identity(x) {
  "Compute identity for this executable category-theory example.";
  x
}
def u:increment(x) {
  "Compute increment for this executable category-theory example.";
  x + 1
}
def u:double(x) {
  "Compute double for this executable category-theory example.";
  2 * x
}
v = [1, 2, 3]
m = [[1, 2], [3, 4]]
vector_id = each(:u:identity, v)
matrix_id = each(:u:identity, m)
vector_composed = each(:u:double, each(:u:increment, v))
matrix_mapped = each(:u:increment, m)
ok({probe: "array-mapping", vector_id: vector_id, matrix_id: matrix_id, vector_composed: vector_composed, matrix_mapped: matrix_mapped, matrix_shape: shape(matrix_mapped)})
