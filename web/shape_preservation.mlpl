# Web Lesson 08 -- preserved structure.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * each changes matrix values without changing shape; transpose swaps axes.
# ***************************************************************************
;
def u:increment(x) { "Compute increment for this executable category-theory example.";  x + 1 }  # cell transformation
m = [[1, 2, 3], [4, 5, 6]]  # shape 2x3
mapped = each(:u:increment, m)  # still shape 2x3
turned = transpose(m)  # shape 3x2
disp(m)  # original cells and shape
disp(mapped)  # changed cells, same positions
disp(turned)  # same entries, exchanged axes
# ***************************************************************************
# * THE VISUAL
# * Both boxes stay 2x3 under each(+1); the shape itself is the invariant.
# ***************************************************************************
def u:shape_preservation_visual() { "Return the shape_preservation_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 280\" width=\"760\" height=\"280\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(370px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(370px)}}</style><rect width=\"760\" height=\"280\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"55\" y=\"60\" width=\"230\" height=\"160\" rx=\"14\"/><rect class=\"obj\" x=\"475\" y=\"60\" width=\"230\" height=\"160\" rx=\"14\"/><line class=\"arrow\" x1=\"285\" y1=\"140\" x2=\"475\" y2=\"140\"/><text x=\"170\" y=\"120\" text-anchor=\"middle\">1 2 3</text><text x=\"170\" y=\"160\" text-anchor=\"middle\">4 5 6</text><text x=\"590\" y=\"120\" text-anchor=\"middle\">2 3 4</text><text x=\"590\" y=\"160\" text-anchor=\"middle\">5 6 7</text><text x=\"170\" y=\"205\" text-anchor=\"middle\">shape 2x3</text><text x=\"590\" y=\"205\" text-anchor=\"middle\">shape 2x3</text><text x=\"380\" y=\"125\" text-anchor=\"middle\">each(+1)</text><circle class=\"token\" cx=\"270\" cy=\"160\" r=\"9\"/></svg>" }  # named custom visual
shape_preservation_visual = u:shape_preservation_visual()  # bind visual constant
shape_preservation_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Mapping preserves coordinates and shape; transpose preserves different data.
# * THE POINT -- always say which structure a transformation preserves.
# ***************************************************************************
