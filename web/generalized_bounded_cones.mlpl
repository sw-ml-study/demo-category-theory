# Web Lesson 32 -- generalized bounded cones and cocones.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Cone legs into a two-arrow chain and cocone legs out must satisfy two
# * compatibility equations before unique mediation makes them universal.
# ***************************************************************************
;
def u:apply_two_point_table(function_table, inputs) { "Apply one two-point function table to two explicit inputs."; [take(function_table, 0, take(inputs, 0, 0)), take(function_table, 0, take(inputs, 0, 1))] }  # finite application
first_arrow = [0, 1]  # A to B
second_arrow = [0, 1]  # B to C
cone_first = equal(u:apply_two_point_table(first_arrow, [0, 1]), [0, 1])  # first cone equation
cone_second = equal(u:apply_two_point_table(second_arrow, [0, 1]), [0, 1])  # second cone equation
cocone_first = equal(u:apply_two_point_table([0, 1], first_arrow), [0, 1])  # first cocone equation
cocone_second = equal(u:apply_two_point_table([0, 1], second_arrow), [0, 1])  # second cocone equation
unique_mediators = equal([1, 1, 1], fill([3], 1))  # bounded universality
broken_cone_rejected = 1 - equal(u:apply_two_point_table(second_arrow, [0, 1]), [1, 0])  # compatibility witness
nonunique_rejected = 1 - equal([1, 2, 1], fill([3], 1))  # uniqueness witness
disp([cone_first, cone_second, cocone_first, cocone_second, unique_mediators, broken_cone_rejected, nonunique_rejected])  # laws
# ***************************************************************************
# * THE VISUAL
# * Blue legs point from the limit apex into A-B-C and from A-B-C into the
# * colimit apex; green arrows are the diagram itself.
# ***************************************************************************
def u:generalized_bounded_cones_visual() { "Return a directed two-arrow diagram with cone and cocone apexes."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 360\" role=\"img\"><title>generalized bounded cones and cocones</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.leg{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:3}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(275px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(275px)}}</style><rect width=\"900\" height=\"360\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"80\" y=\"155\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"375\" y=\"155\" width=\"150\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"670\" y=\"155\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"arrow\" x1=\"230\" y1=\"182\" x2=\"375\" y2=\"182\"/><line class=\"arrow\" x1=\"525\" y1=\"182\" x2=\"670\" y2=\"182\"/><rect class=\"obj\" x=\"375\" y=\"25\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"leg\" x1=\"410\" y1=\"80\" x2=\"190\" y2=\"155\"/><line class=\"leg\" x1=\"450\" y1=\"80\" x2=\"450\" y2=\"155\"/><line class=\"leg\" x1=\"490\" y1=\"80\" x2=\"710\" y2=\"155\"/><rect class=\"obj\" x=\"375\" y=\"280\" width=\"150\" height=\"55\" rx=\"12\"/><line class=\"leg\" x1=\"155\" y1=\"210\" x2=\"410\" y2=\"280\"/><line class=\"leg\" x1=\"450\" y1=\"210\" x2=\"450\" y2=\"280\"/><line class=\"leg\" x1=\"745\" y1=\"210\" x2=\"490\" y2=\"280\"/><text x=\"450\" y=\"58\" text-anchor=\"middle\">limit cone</text><text x=\"155\" y=\"188\" text-anchor=\"middle\">A</text><text x=\"450\" y=\"188\" text-anchor=\"middle\">B</text><text x=\"745\" y=\"188\" text-anchor=\"middle\">C</text><text x=\"450\" y=\"313\" text-anchor=\"middle\">colimit cocone</text><circle class=\"token\" cx=\"185\" cy=\"165\" r=\"8\"/></svg>" }  # named custom visual
generalized_bounded_cones_visual = u:generalized_bounded_cones_visual()  # bind visual constant
generalized_bounded_cones_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Each apex has three legs, but the two diagram arrows impose two equations.
# * Mediator counts [1,1,1] then establish bounded universality.
# * THE POINT -- compatibility creates a cone/cocone; unique factorization
# * makes it a limit/colimit within the enumerated candidate family.
# ***************************************************************************
