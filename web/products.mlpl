# Web Lesson 05 -- products.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * A pair is the unique value fixed by its first and second projections.
# ***************************************************************************
;
p = {first: 3, second: 8}  # the mediator into the product
candidate = {first: 3, second: 9}  # a competitor that misses one projection
disp([p.first, p.second, candidate.first, candidate.second])  # 3,8 versus 3,9
# ***************************************************************************
# * THE VISUAL
# * Both green arrows leave one pair; each projection fixes one coordinate.
# ***************************************************************************
def u:products_visual() { "Return the products_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 280\" width=\"700\" height=\"280\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);fill:none;stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(90px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(90px)}}</style><rect width=\"700\" height=\"280\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"275\" y=\"45\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"65\" y=\"200\" width=\"150\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"485\" y=\"200\" width=\"150\" height=\"60\" rx=\"14\"/><path class=\"arrow\" d=\"M300 110L185 200M400 110L515 200\"/><text x=\"350\" y=\"82\" text-anchor=\"middle\">pair(3,8)</text><text x=\"230\" y=\"150\">fst</text><text x=\"455\" y=\"150\">snd</text><text x=\"140\" y=\"237\" text-anchor=\"middle\">3</text><text x=\"560\" y=\"237\" text-anchor=\"middle\">8</text><circle class=\"token\" cx=\"350\" cy=\"95\" r=\"10\"/></svg>" }  # named custom visual
products_visual = u:products_visual()  # bind visual constant
products_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Matching both targets forces (3,8); the candidate (3,9) cannot compete.
# * THE POINT -- the universal property is existence plus uniqueness.
# ***************************************************************************
