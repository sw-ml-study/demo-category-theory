# Web Lesson 17 -- bounded deterministic unfold.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * A seed, step, and explicit count generate one finite arithmetic sequence.
# ***************************************************************************
;
def u:unfold_schedule(seed, step, count) { "Generate a bounded arithmetic checkpoint schedule."; seed + range(count) * step }  # finite generator
generated = u:unfold_schedule(3, 2, 4)  # [3,5,7,9]
recovered_seed = take(generated, 0, 0)  # fold-like observation
recovered_step = take(generated, 0, 1) - recovered_seed  # first difference
regenerated = u:unfold_schedule(recovered_seed, recovered_step, 4)  # exact round-trip
irregular = [3, 5, 8, 9]  # outside the arithmetic fixture
irregular_regenerated = u:unfold_schedule(3, 2, 4)  # differs visibly
disp([equal(generated, regenerated), equal(irregular, irregular_regenerated)])  # 1 then 0
# ***************************************************************************
# * THE VISUAL
# * Green expands seed 3 by step 2; red exposes an irregular non-round-trip.
# ***************************************************************************
def u:bounded_unfold_visual() { "Render the directed SVG witness for this lesson categorical law."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 270\" width=\"820\" height=\"270\" role=\"img\"><title>bounded deterministic unfold</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{stroke-dasharray:10 7;stroke:rgb(247,118,142)}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(470px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(470px)}}</style><rect width=\"820\" height=\"270\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"45\" y=\"45\" width=\"190\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"590\" y=\"45\" width=\"185\" height=\"65\" rx=\"14\"/><line class=\"arrow\" x1=\"235\" y1=\"77\" x2=\"590\" y2=\"77\"/><text x=\"140\" y=\"84\" text-anchor=\"middle\">seed 3, step 2</text><text x=\"682\" y=\"84\" text-anchor=\"middle\">[3,5,7,9]</text><rect class=\"obj\" x=\"120\" y=\"180\" width=\"220\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"480\" y=\"180\" width=\"220\" height=\"60\" rx=\"14\"/><line class=\"arrow bad\" x1=\"340\" y1=\"210\" x2=\"480\" y2=\"210\"/><text x=\"230\" y=\"217\" text-anchor=\"middle\">irregular [3,5,8,9]</text><text x=\"590\" y=\"217\" text-anchor=\"middle\">arithmetic [3,5,7,9]</text><circle class=\"token\" cx=\"215\" cy=\"97\" r=\"9\"/></svg>" }  # named custom visual
bounded_unfold_visual = u:bounded_unfold_visual()  # bind visual constant
bounded_unfold_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Recovered arithmetic parameters regenerate only sequences in this fixture.
# * THE POINT -- bounded unfold is generation, not unrestricted recursion.
# ***************************************************************************
