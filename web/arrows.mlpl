# Web Lesson 01 -- arrows are functions.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * A concrete morphism: five source numbers and the five results of doubling.
# ***************************************************************************
;
def u:double(x) { "Compute double for this executable category-theory example.";  2 * x }  # the arrow's behavior
xs = range(5)  # the visible source object
ys = each(:u:double, xs)  # follow the arrow for every source value
disp([xs, ys])  # rows are source values and their destinations
# ***************************************************************************
# * THE VISUAL
# * The pink token is the same input before and after crossing double.
# ***************************************************************************
def u:arrows_visual() { "Return the arrows_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 220\" width=\"700\" height=\"220\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.o{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.a{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.t{fill:rgb(247,118,142);animation:m 3s infinite alternate}@keyframes m{to{transform:translateX(400px)}}@media(prefers-reduced-motion:reduce){.t{animation:none;transform:translateX(400px)}}</style><rect width=\"700\" height=\"220\" fill=\"rgb(26,27,38)\"/><rect class=\"o\" x=\"60\" y=\"70\" width=\"150\" height=\"90\" rx=\"16\"/><rect class=\"o\" x=\"490\" y=\"70\" width=\"150\" height=\"90\" rx=\"16\"/><line class=\"a\" x1=\"210\" y1=\"115\" x2=\"490\" y2=\"115\"/><text x=\"350\" y=\"95\" text-anchor=\"middle\">double</text><text x=\"135\" y=\"125\" text-anchor=\"middle\">3</text><text x=\"565\" y=\"125\" text-anchor=\"middle\">6</text><circle class=\"t\" cx=\"190\" cy=\"140\" r=\"11\"/></svg>" }  # named custom visual
arrows_visual = u:arrows_visual()  # bind visual constant
arrows_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The two array rows verify every mapping; the token makes one mapping seen.
# * THE POINT -- an arrow is an executable function, not decorative notation.
# ***************************************************************************
