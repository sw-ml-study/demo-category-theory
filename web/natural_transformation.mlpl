# Web Lesson 09 -- transpose as a natural transformation.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Transpose commutes with cellwise mapping across explicit matrix shapes.
# ***************************************************************************
;
def u:increment(x) { "Serve as the scalar morphism f whose lifted or composed action is being tested.";  x + 1 }  # a morphism mapped over every cell
m = [[1, 2, 3], [4, 5, 6]]  # the 2x3 component's input
map_then_transpose = transpose(each(:u:increment, m))  # map, then component
transpose_then_map = each(:u:increment, transpose(m))  # component, then map
disp(map_then_transpose)  # first route
disp(transpose_then_map)  # same destination by naturality
# ***************************************************************************
# * THE VISUAL
# * Green is the commuting component; red shows a bad +1 component: 3 != 4.
# ***************************************************************************
def u:natural_transformation_visual() { "Render the directed SVG witness for this lesson categorical law."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 330\" width=\"820\" height=\"330\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);fill:none;stroke:rgb(122,162,247);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 4s infinite alternate}.good{fill:none;stroke:rgb(158,206,106);stroke-width:7}.bad{fill:none;stroke:rgb(247,118,142);stroke-width:7}@keyframes p{to{transform:translate(150px,140px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translate(150px,140px)}}</style><rect width=\"820\" height=\"330\" fill=\"rgb(26,27,38)\"/><text x=\"410\" y=\"25\" text-anchor=\"middle\">transpose(each(f,m)) = each(f,transpose(m))</text><g><rect class=\"obj\" x=\"50\" y=\"55\" width=\"110\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"250\" y=\"55\" width=\"110\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"50\" y=\"230\" width=\"110\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"250\" y=\"230\" width=\"110\" height=\"55\" rx=\"12\"/><path class=\"arrow\" d=\"M160 82H250M105 110V230M305 110V230M160 257H250\"/><circle class=\"good\" cx=\"305\" cy=\"257\" r=\"24\"/><circle class=\"token\" cx=\"105\" cy=\"82\" r=\"9\"/><text x=\"205\" y=\"70\">each(f)</text><text x=\"75\" y=\"175\">T</text></g><g transform=\"translate(410 0)\"><rect class=\"obj\" x=\"50\" y=\"55\" width=\"110\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"250\" y=\"55\" width=\"110\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"50\" y=\"230\" width=\"110\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"250\" y=\"230\" width=\"110\" height=\"55\" rx=\"12\"/><path class=\"arrow\" d=\"M160 82H250M105 110V230M305 110V230M160 257H250\"/><circle class=\"bad\" cx=\"290\" cy=\"257\" r=\"20\"/><circle class=\"bad\" cx=\"325\" cy=\"257\" r=\"20\"/><text x=\"290\" y=\"263\" text-anchor=\"middle\">3</text><text x=\"325\" y=\"263\" text-anchor=\"middle\">4</text><text x=\"75\" y=\"175\">T,+1</text></g></svg>" }  # named custom visual
natural_transformation_visual = u:natural_transformation_visual()  # bind visual constant
natural_transformation_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Equal matrices prove one component; the family repeats for each shape.
# * THE POINT -- naturality means every component square commutes.
# ***************************************************************************
