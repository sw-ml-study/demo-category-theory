# Web Lesson 20 -- opposite category and dual statement.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Reversing every arrow also reverses the order of a composed path.
# ***************************************************************************
;
def u:opposite(adjacency) { "Reverse every arrow in a finite relation."; transpose(adjacency) }  # finite opposite
relation = [[0, 1, 0], [0, 0, 1], [0, 0, 0]]  # A to B to C
opposite = u:opposite(relation)  # C-op arrows point back
restored = u:opposite(opposite)  # involution
path = [10, 20, 30]  # f then g then h
dual_path = [take(path, 0, 2), take(path, 0, 1), take(path, 0, 0)]  # h-op then g-op then f-op
disp(opposite)  # transposed adjacency
disp(dual_path)  # reversed composition order
disp([equal(restored, relation), equal(dual_path, [30, 20, 10])])  # two laws
# ***************************************************************************
# * THE VISUAL
# * The right-hand arrows reverse, and the path labels reverse with them.
# ***************************************************************************
"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 840 280\" width=\"840\" height=\"280\" role=\"img\"><style>text{font-family:monospace;fill:#c0caf5}.obj{fill:#1f2335;stroke:#7aa2f7;stroke-width:3}.arrow{stroke:#9ece6a;stroke-width:4}.token{fill:#f7768e;animation:p 4s infinite alternate}@keyframes p{to{transform:translateX(190px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(190px)}}</style><rect width=\"840\" height=\"280\" fill=\"#1a1b26\"/><text x=\"210\" y=\"38\" text-anchor=\"middle\">C: A -f-&gt; B -g-&gt; C</text><text x=\"630\" y=\"38\" text-anchor=\"middle\">C-op: C -g-op-&gt; B -f-op-&gt; A</text><rect class=\"obj\" x=\"30\" y=\"80\" width=\"90\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"165\" y=\"80\" width=\"90\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"300\" y=\"80\" width=\"90\" height=\"60\" rx=\"12\"/><line class=\"arrow\" x1=\"120\" y1=\"110\" x2=\"165\" y2=\"110\"/><line class=\"arrow\" x1=\"255\" y1=\"110\" x2=\"300\" y2=\"110\"/><rect class=\"obj\" x=\"450\" y=\"80\" width=\"90\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"585\" y=\"80\" width=\"90\" height=\"60\" rx=\"12\"/><rect class=\"obj\" x=\"720\" y=\"80\" width=\"90\" height=\"60\" rx=\"12\"/><line class=\"arrow\" x1=\"540\" y1=\"110\" x2=\"585\" y2=\"110\"/><line class=\"arrow\" x1=\"675\" y1=\"110\" x2=\"720\" y2=\"110\"/><text x=\"420\" y=\"220\" text-anchor=\"middle\">transpose twice restores C; [f,g,h] dualizes to [h,g,f]</text><circle class=\"token\" cx=\"100\" cy=\"130\" r=\"9\"/></svg>"  # category and opposite
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Opposite is involutive, but the dual composite must be read backward.
# * THE POINT -- one arrow-reversal principle generates dual statements.
# ***************************************************************************
