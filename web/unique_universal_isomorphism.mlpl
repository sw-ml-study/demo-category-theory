# Web Lesson 29 -- uniqueness up to unique isomorphism.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Two representations of one binary product are connected by comparison
# * arrows forced by their projections; those arrows must be inverse.
# ***************************************************************************
;
def u:apply_four_point_map(function_table, inputs) {
  "Apply a finite function table to four explicit inputs.";
  [take(function_table, 0, take(inputs, 0, 0)), take(function_table, 0, take(inputs, 0, 1)), take(function_table, 0, take(inputs, 0, 2)), take(function_table, 0, take(inputs, 0, 3))]
}  # finite application
def u:compose_four_point_maps(first_map, second_map) {
  "Compose two four-point finite function tables.";
  u:apply_four_point_map(second_map, first_map)
}  # finite composition
def u:comparison_preserves_product_projections(comparison_map) {
  "Check both projections after mapping between the two product representations.";
  equal(u:apply_four_point_map([0, 0, 1, 1], comparison_map), [0, 1, 0, 1]) * equal(u:apply_four_point_map([0, 1, 0, 1], comparison_map), [0, 0, 1, 1])
}  # universal compatibility
comparison_map = [0, 2, 1, 3]  # forced by both projections
identity_map = [0, 1, 2, 3]  # identity on either four-element carrier
round_trip_p = u:compose_four_point_maps(comparison_map, comparison_map)  # v after u
round_trip_q = u:compose_four_point_maps(comparison_map, comparison_map)  # u after v
preserves_projections = u:comparison_preserves_product_projections(comparison_map)  # both triangles commute
bad_map_rejected = 1 - u:comparison_preserves_product_projections(identity_map)  # competing map fails
disp([comparison_map, round_trip_p, round_trip_q, identity_map])  # forced maps and inverse laws
disp([preserves_projections, bad_map_rejected])  # law and counterexample
# ***************************************************************************
# * THE VISUAL
# * Green arrows are the uniquely forced inverse comparisons. The dashed red
# * competitor does not preserve the displayed projections.
# ***************************************************************************
def u:unique_universal_isomorphism_visual() {
  "Return the directed diagram of forced inverse comparison arrows.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 860 330\" width=\"860\" height=\"330\" role=\"img\"><title>uniqueness up to unique isomorphism</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4;fill:none}.projection{marker-end:url(\\23 arrowhead);stroke:rgb(125,207,255);stroke-width:3}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:3;stroke-dasharray:8 6}</style><rect width=\"860\" height=\"330\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"85\" y=\"65\" width=\"200\" height=\"70\" rx=\"13\"/><rect class=\"obj\" x=\"575\" y=\"65\" width=\"200\" height=\"70\" rx=\"13\"/><rect class=\"obj\" x=\"330\" y=\"245\" width=\"200\" height=\"55\" rx=\"13\"/><path class=\"arrow\" d=\"M 285 82 C 380 25 480 25 575 82\"/><path class=\"arrow\" d=\"M 575 120 C 480 180 380 180 285 120\"/><line class=\"projection\" x1=\"230\" y1=\"135\" x2=\"380\" y2=\"245\"/><line class=\"projection\" x1=\"630\" y1=\"135\" x2=\"480\" y2=\"245\"/><path class=\"bad\" d=\"M 285 100 L 575 100\"/><text x=\"185\" y=\"107\" text-anchor=\"middle\">P = pairs</text><text x=\"675\" y=\"107\" text-anchor=\"middle\">Q = swapped storage</text><text x=\"430\" y=\"42\" text-anchor=\"middle\">forced u</text><text x=\"430\" y=\"190\" text-anchor=\"middle\">forced v; vu=idP, uv=idQ</text><text x=\"430\" y=\"278\" text-anchor=\"middle\">same projections</text><text x=\"430\" y=\"92\" text-anchor=\"middle\">bad map fails a projection</text></svg>"
}  # named custom visual
unique_universal_isomorphism_visual = u:unique_universal_isomorphism_visual()  # bind visual constant
unique_universal_isomorphism_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Matching both projections leaves only the swap comparison. Following the
# * forced comparison in either direction and back returns each representation.
# * THE POINT -- universal objects need not be equal; their universal property
# * forces exactly one structure-preserving isomorphism between them.
# ***************************************************************************
