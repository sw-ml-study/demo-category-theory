# Web Lesson 23 -- coequalizer.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Parallel arrows force output labels into one universal quotient class.
# ***************************************************************************
;
left_arrow = [0, 1]  # forces 0~1
right_arrow = [1, 2]  # forces 1~2
quotient = [0, 0, 0]  # transitive forced class
left_route = [take(quotient, 0, 0), take(quotient, 0, 1)]  # q after f
right_route = [take(quotient, 0, 1), take(quotient, 0, 2)]  # q after g
lawful_map = [7, 7, 7]  # factors through singleton as [7]
broken_map = [7, 8, 7]  # separates 0 from forced-equal 1
disp(quotient)  # one equivalence class
disp([equal(left_route, right_route), equal(broken_map, lawful_map)])  # 1 then 0
# ***************************************************************************
# * THE VISUAL
# * Green merges 0,1,2. Red [7,8,7] separates a pair the arrows forced equal.
# ***************************************************************************
def u:coequalizer_visual() { "Return the coequalizer_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 280\" width=\"820\" height=\"280\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{stroke:rgb(247,118,142)}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(390px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(390px)}}</style><rect width=\"820\" height=\"280\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"30\" y=\"55\" width=\"140\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"310\" y=\"55\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"650\" y=\"55\" width=\"140\" height=\"65\" rx=\"12\"/><line class=\"arrow\" x1=\"170\" y1=\"72\" x2=\"310\" y2=\"72\"/><line class=\"arrow\" x1=\"170\" y1=\"102\" x2=\"310\" y2=\"102\"/><line class=\"arrow\" x1=\"490\" y1=\"87\" x2=\"650\" y2=\"87\"/><text x=\"100\" y=\"94\" text-anchor=\"middle\">A=[0,1]</text><text x=\"400\" y=\"94\" text-anchor=\"middle\">B=[0,1,2]</text><text x=\"720\" y=\"94\" text-anchor=\"middle\">Q=one class</text><rect class=\"obj\" x=\"225\" y=\"185\" width=\"370\" height=\"60\" rx=\"12\"/><line class=\"arrow bad\" x1=\"410\" y1=\"165\" x2=\"410\" y2=\"185\"/><text x=\"410\" y=\"222\" text-anchor=\"middle\">bad map [7,8,7]</text><circle class=\"token\" cx=\"150\" cy=\"120\" r=\"9\"/></svg>" }  # named custom visual
coequalizer_visual = u:coequalizer_visual()  # bind visual constant
coequalizer_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Every map respecting the forced equalities factors through Q uniquely.
# * THE POINT -- coequalizer is the universal quotient of parallel arrows.
# ***************************************************************************
