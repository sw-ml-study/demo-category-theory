# Web Lesson 04 -- commutative and broken squares.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * One square where both routes agree, and one where changing +2 to +1 fails.
# ***************************************************************************
;
def u:increment(x) { "Compute increment for this executable category-theory example.";  x + 1 }  # top arrow; also the deliberately wrong bottom arrow
def u:double(x) { "Compute double for this executable category-theory example.";  2 * x }  # both vertical arrows
def u:add_two(x) { "Compute add two for this executable category-theory example.";  x + 2 }  # lawful bottom arrow
xs = range(6)  # every checked input
upper = each(:u:double, each(:u:increment, xs))  # across then down
lower = each(:u:add_two, each(:u:double, xs))  # down then across, lawful
broken = each(:u:increment, each(:u:double, xs))  # down then across, one bad arrow
disp([xs, upper, lower, broken])  # first three rows agree; fourth differs
# ***************************************************************************
# * THE VISUAL
# * Green means both routes meet. Split red destinations show 2 != 1 at x=0.
# ***************************************************************************
def u:commutative_square_visual() { "Return the commutative_square_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 330\" width=\"820\" height=\"330\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);fill:none;stroke:rgb(122,162,247);stroke-width:4}.token{fill:rgb(247,118,142)}.good{fill:none;stroke:rgb(158,206,106);stroke-width:8}.bad{fill:none;stroke:rgb(247,118,142);stroke-width:8}@media(prefers-reduced-motion:reduce){animateMotion{display:none}}</style><rect width=\"820\" height=\"330\" fill=\"rgb(26,27,38)\"/><text x=\"205\" y=\"25\" text-anchor=\"middle\">COMMUTES</text><text x=\"615\" y=\"25\" text-anchor=\"middle\">BROKEN AT x=0</text><g><rect class=\"obj\" x=\"55\" y=\"55\" width=\"100\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"255\" y=\"55\" width=\"100\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"55\" y=\"225\" width=\"100\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"255\" y=\"225\" width=\"100\" height=\"55\" rx=\"12\"/><path class=\"arrow\" d=\"M155 82H255M105 110V225M305 110V225M155 252H255\"/><circle class=\"good\" cx=\"305\" cy=\"252\" r=\"27\"/><circle class=\"token\" cx=\"305\" cy=\"252\" r=\"9\"/><text x=\"205\" y=\"72\">+1</text><text x=\"205\" y=\"242\">+2</text></g><g transform=\"translate(410 0)\"><rect class=\"obj\" x=\"55\" y=\"55\" width=\"100\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"255\" y=\"55\" width=\"100\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"55\" y=\"225\" width=\"100\" height=\"55\" rx=\"12\"/><rect class=\"obj\" x=\"255\" y=\"225\" width=\"100\" height=\"55\" rx=\"12\"/><path class=\"arrow\" d=\"M155 82H255M105 110V225M305 110V225M155 252H255\"/><circle class=\"bad\" cx=\"290\" cy=\"252\" r=\"21\"/><circle class=\"bad\" cx=\"330\" cy=\"252\" r=\"21\"/><text x=\"290\" y=\"258\" text-anchor=\"middle\">2</text><text x=\"330\" y=\"258\" text-anchor=\"middle\">1</text><text x=\"205\" y=\"72\">+1</text><text x=\"205\" y=\"242\">+1 wrong</text></g><circle class=\"token\" r=\"8\"><animateMotion path=\"M105 82H305V252\" dur=\"4s\" repeatCount=\"indefinite\"/></circle><circle class=\"token\" r=\"6\"><animateMotion path=\"M105 82V252H305\" dur=\"4s\" repeatCount=\"indefinite\"/></circle></svg>" }  # named custom visual
commutative_square_visual = u:commutative_square_visual()  # bind visual constant
commutative_square_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Rows 2 and 3 agree everywhere. Row 4 first differs at input 0: 2 vs 1.
# * THE POINT -- a commuting diagram is an executable equality of paths.
# ***************************************************************************
