# Web Lesson 03 -- associativity of composition.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Two bracketings of three arrows trace the same route in the same order.
# ***************************************************************************
;
def u:composition_leaf(arrow_name, arrow_function) {
  "Represent one named morphism as a leaf in an executable composition tree.";
  {tag: "leaf", name: arrow_name, arrow: arrow_function, first: 0, second: 0}
}  # leaf constructor
def u:compose_expressions(first_expression, second_expression) {
  "Construct a composition node that executes its first child and then its second.";
  {tag: "compose", name: "compose", arrow: :u:increment_value, first: first_expression, second: second_expression}
}  # branch constructor
def u:evaluate_composition(expression, input_value) {
  "Evaluate a composition tree while retaining its explicit parenthesized structure.";
  if equal(expression.tag, "leaf") {
    expression.arrow(input_value)
  } else { u:evaluate_composition(expression.second, u:evaluate_composition(expression.first, input_value)) }
}  # tree interpreter
def u:increment_value(x) {
  "Serve as the first morphism f in the associativity equation.";
  x + 1
}  # A to B
def u:double_value(x) {
  "Serve as the second morphism g in the associativity equation.";
  2 * x
}  # B to C
def u:square_value(x) {
  "Serve as the third morphism h in the associativity equation.";
  x * x
}  # C to D
f_expression = u:composition_leaf("f", :u:increment_value)  # first leaf
g_expression = u:composition_leaf("g", :u:double_value)  # second leaf
h_expression = u:composition_leaf("h", :u:square_value)  # third leaf
left_composition_tree = u:compose_expressions(u:compose_expressions(f_expression, g_expression), h_expression)  # compose(compose(f,g),h)
right_composition_tree = u:compose_expressions(f_expression, u:compose_expressions(g_expression, h_expression))  # compose(f,compose(g,h))
def u:evaluate_left_tree(x) {
  "Evaluate the left-associated composition tree.";
  u:evaluate_composition(left_composition_tree, x)
}  # left law side
def u:evaluate_right_tree(x) {
  "Evaluate the right-associated composition tree.";
  u:evaluate_composition(right_composition_tree, x)
}  # right law side
xs = range(5)  # finite visible witnesses
left_associated_outputs = each(:u:evaluate_left_tree, xs)  # execute left tree
right_associated_outputs = each(:u:evaluate_right_tree, xs)  # execute right tree
disp([left_associated_outputs, right_associated_outputs])  # equal rows verify associativity
disp([equal(left_composition_tree.first.tag, "compose"), equal(right_composition_tree.second.tag, "compose")])  # both structural checks are 1
# ***************************************************************************
# * THE VISUAL
# * Two different composition trees sit beside their common A-to-B-to-C-to-D path.
# ***************************************************************************
def u:composition_associativity_visual() {
  "Render the directed SVG witness for this lesson categorical law.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 220\" width=\"760\" height=\"220\" role=\"img\"><title>associativity of composition</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:m 4s infinite alternate}@keyframes m{to{transform:translateX(555px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(555px)}}</style><rect width=\"760\" height=\"220\" fill=\"rgb(26,27,38)\"/><text x=\"380\" y=\"30\" text-anchor=\"middle\">(f ; g) ; h = f ; (g ; h)</text><rect class=\"obj\" x=\"30\" y=\"80\" width=\"110\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"220\" y=\"80\" width=\"110\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"410\" y=\"80\" width=\"110\" height=\"70\" rx=\"14\"/><rect class=\"obj\" x=\"600\" y=\"80\" width=\"110\" height=\"70\" rx=\"14\"/><line class=\"arrow\" x1=\"140\" y1=\"115\" x2=\"220\" y2=\"115\"/><line class=\"arrow\" x1=\"330\" y1=\"115\" x2=\"410\" y2=\"115\"/><line class=\"arrow\" x1=\"520\" y1=\"115\" x2=\"600\" y2=\"115\"/><text x=\"180\" y=\"102\" text-anchor=\"middle\">f</text><text x=\"370\" y=\"102\" text-anchor=\"middle\">g</text><text x=\"560\" y=\"102\" text-anchor=\"middle\">h</text><text x=\"85\" y=\"122\" text-anchor=\"middle\">A</text><text x=\"275\" y=\"122\" text-anchor=\"middle\">B</text><text x=\"465\" y=\"122\" text-anchor=\"middle\">C</text><text x=\"655\" y=\"122\" text-anchor=\"middle\">D</text><circle class=\"token\" cx=\"120\" cy=\"140\" r=\"11\"/></svg>"
}  # named custom visual
def u:composition_trees_visual() {
  "Render both composition trees beside their shared path.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 900 360\" role=\"img\"><title>two composition trees, one morphism</title><desc>The inner compose node is left in the first tree and right in the second; both evaluate the path f then g then h.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:3}.token{fill:rgb(247,118,142);animation:p 4s infinite alternate}@keyframes p{to{transform:translateX(600px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(600px)}}</style><rect width=\"900\" height=\"360\" fill=\"rgb(26,27,38)\"/><text x=\"220\" y=\"25\" text-anchor=\"middle\">compose(compose(f,g),h)</text><text x=\"680\" y=\"25\" text-anchor=\"middle\">compose(f,compose(g,h))</text><rect class=\"obj\" x=\"160\" y=\"45\" width=\"120\" height=\"42\" rx=\"10\"/><text x=\"220\" y=\"72\" text-anchor=\"middle\">compose</text><rect class=\"obj\" x=\"65\" y=\"125\" width=\"120\" height=\"42\" rx=\"10\"/><text x=\"125\" y=\"152\" text-anchor=\"middle\">compose(f,g)</text><text x=\"315\" y=\"152\">h</text><line class=\"arrow\" x1=\"195\" y1=\"87\" x2=\"125\" y2=\"125\"/><line class=\"arrow\" x1=\"245\" y1=\"87\" x2=\"315\" y2=\"135\"/><rect class=\"obj\" x=\"620\" y=\"45\" width=\"120\" height=\"42\" rx=\"10\"/><text x=\"680\" y=\"72\" text-anchor=\"middle\">compose</text><text x=\"585\" y=\"152\">f</text><rect class=\"obj\" x=\"715\" y=\"125\" width=\"120\" height=\"42\" rx=\"10\"/><text x=\"775\" y=\"152\" text-anchor=\"middle\">compose(g,h)</text><line class=\"arrow\" x1=\"655\" y1=\"87\" x2=\"585\" y2=\"135\"/><line class=\"arrow\" x1=\"705\" y1=\"87\" x2=\"775\" y2=\"125\"/><text x=\"450\" y=\"215\" text-anchor=\"middle\">SAME EVALUATED PATH</text><text x=\"100\" y=\"275\">A</text><text x=\"330\" y=\"275\">B</text><text x=\"560\" y=\"275\">C</text><text x=\"790\" y=\"275\">D</text><line class=\"arrow\" x1=\"120\" y1=\"268\" x2=\"310\" y2=\"268\"/><line class=\"arrow\" x1=\"350\" y1=\"268\" x2=\"540\" y2=\"268\"/><line class=\"arrow\" x1=\"580\" y1=\"268\" x2=\"770\" y2=\"268\"/><text x=\"215\" y=\"255\">f</text><text x=\"445\" y=\"255\">g</text><text x=\"675\" y=\"255\">h</text><circle class=\"token\" cx=\"110\" cy=\"290\" r=\"10\"/></svg>"
}  # two-tree custom visual
composition_associativity_visual = u:composition_trees_visual()  # bind visual constant
composition_associativity_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Each tree has its inner compose node on a different side; outputs coincide.
# * THE POINT -- distinct composition structures denote the same morphism.
# ***************************************************************************
