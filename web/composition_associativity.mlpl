# Web Lesson 03 -- associativity of composition.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Two bracketings of three arrows trace the same route in the same order.
# ***************************************************************************
;
def u:increment_value(x) { "Compute increment value for this executable category-theory example.";  x + 1 }  # A to B
def u:double_value(x) { "Compute double value for this executable category-theory example.";  2 * x }  # B to C
def u:square_value(x) { "Compute square value for this executable category-theory example.";  x * x }  # C to D
xs = range(5)  # finite visible witnesses
left = each(:u:square_value, each(:u:double_value, each(:u:increment_value, xs)))  # (f ; g) ; h
right = each(:u:square_value, each(:u:double_value, each(:u:increment_value, xs)))  # f ; (g ; h)
disp([left, right])  # equal rows verify associativity
# ***************************************************************************
# * THE VISUAL
# * Brackets never change the A-to-B-to-C-to-D order, so arrivals coincide.
# ***************************************************************************
def u:composition_associativity_visual() { "Return the composition_associativity_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 220\" width=\"760\" height=\"220\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.o{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.a{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.t{fill:rgb(247,118,142);animation:m 4s infinite alternate}@keyframes m{to{transform:translateX(555px)}}@media(prefers-reduced-motion:reduce){.t{animation:none;transform:translateX(555px)}}</style><rect width=\"760\" height=\"220\" fill=\"rgb(26,27,38)\"/><text x=\"380\" y=\"30\" text-anchor=\"middle\">(f ; g) ; h = f ; (g ; h)</text><rect class=\"o\" x=\"30\" y=\"80\" width=\"110\" height=\"70\" rx=\"14\"/><rect class=\"o\" x=\"220\" y=\"80\" width=\"110\" height=\"70\" rx=\"14\"/><rect class=\"o\" x=\"410\" y=\"80\" width=\"110\" height=\"70\" rx=\"14\"/><rect class=\"o\" x=\"600\" y=\"80\" width=\"110\" height=\"70\" rx=\"14\"/><line class=\"a\" x1=\"140\" y1=\"115\" x2=\"220\" y2=\"115\"/><line class=\"a\" x1=\"330\" y1=\"115\" x2=\"410\" y2=\"115\"/><line class=\"a\" x1=\"520\" y1=\"115\" x2=\"600\" y2=\"115\"/><text x=\"85\" y=\"122\" text-anchor=\"middle\">A</text><text x=\"275\" y=\"122\" text-anchor=\"middle\">B</text><text x=\"465\" y=\"122\" text-anchor=\"middle\">C</text><text x=\"655\" y=\"122\" text-anchor=\"middle\">D</text><circle class=\"t\" cx=\"120\" cy=\"140\" r=\"11\"/></svg>" }  # named custom visual
composition_associativity_visual = u:composition_associativity_visual()  # bind visual constant
composition_associativity_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Both rows and the single route say the same thing: only grouping changed.
# * THE POINT -- composition is associative because arrow order is unchanged.
# ***************************************************************************
