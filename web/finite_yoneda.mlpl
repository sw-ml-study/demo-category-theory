# Web Lesson 28 -- finite Yoneda and category of elements.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * One element of F(A) generates a natural transformation from Hom(A,-),
# * and evaluation at idA recovers that element.
# ***************************************************************************
;
def u:functor_action(element) { "Map F(A)'s element along f into F(B)."; if equal(element, 10) { 20 } else { -1 } }  # F(f)
def u:transformation_from_element(element) { "Generate both finite transformation components from one element."; {at_a: element, at_b: u:functor_action(element)} }  # Yoneda forward
def u:element_from_transformation(transformation) { "Evaluate the A-component at identity A."; transformation.at_a }  # Yoneda inverse
transformation = u:transformation_from_element(10)  # components 10 and 20
recovered_element = u:element_from_transformation(transformation)  # returns 10
regenerated = u:transformation_from_element(recovered_element)  # round trip
naturality = equal(u:functor_action(transformation.at_a), transformation.at_b)  # square commutes
broken_naturality = 1 - equal(u:functor_action(10), 21)  # first witness
element_nodes = [[0,10],[1,20]]  # (A,10), (B,20)
element_edge = [0,1]  # induced by f
reconstructed_values = take(transpose(element_nodes), 0, 1)  # bounded density
disp([transformation.at_a, transformation.at_b, recovered_element, naturality, broken_naturality])  # laws
disp(element_nodes)  # category-of-elements rows
disp([element_edge, reconstructed_values])  # edge and rebuilt values
# ***************************************************************************
# * THE VISUAL
# * The upper route round-trips; the lower arrow is the category of elements.
# ***************************************************************************
def u:finite_yoneda_visual() { "Return the finite Yoneda and category-of-elements diagram."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 860 320\" width=\"860\" height=\"320\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(230px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(230px)}}</style><rect width=\"860\" height=\"320\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"25\" y=\"55\" width=\"190\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"335\" y=\"55\" width=\"190\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"645\" y=\"55\" width=\"190\" height=\"65\" rx=\"12\"/><line class=\"arrow\" x1=\"215\" y1=\"87\" x2=\"335\" y2=\"87\"/><line class=\"arrow\" x1=\"525\" y1=\"87\" x2=\"645\" y2=\"87\"/><text x=\"120\" y=\"94\" text-anchor=\"middle\">element 10</text><text x=\"430\" y=\"80\" text-anchor=\"middle\">eta(idA)=10</text><text x=\"430\" y=\"103\" text-anchor=\"middle\">eta(f)=20</text><text x=\"740\" y=\"94\" text-anchor=\"middle\">recover 10</text><rect class=\"obj\" x=\"125\" y=\"210\" width=\"210\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"525\" y=\"210\" width=\"210\" height=\"65\" rx=\"12\"/><line class=\"arrow\" x1=\"335\" y1=\"242\" x2=\"525\" y2=\"242\"/><text x=\"230\" y=\"249\" text-anchor=\"middle\">(A,10)</text><text x=\"630\" y=\"249\" text-anchor=\"middle\">(B,20)</text><text x=\"430\" y=\"225\" text-anchor=\"middle\">over f</text><circle class=\"token\" cx=\"195\" cy=\"107\" r=\"9\"/></svg>" }  # named custom visual
finite_yoneda_visual = u:finite_yoneda_visual()  # bind visual constant
finite_yoneda_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Naturality forces 10 to travel to 20; changing it to 21 breaks the square.
# * THE POINT -- the two element objects reconstruct this fixture's values;
# * that is density intuition, not a proof of the general density theorem.
# ***************************************************************************
