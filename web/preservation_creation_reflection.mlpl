# Web Lesson 33 -- preservation, creation, and reflection.
# visual: svg
# loops: 0
# ***************************************************************************
# * PREREQUISITES -- functors, cones, limits, colimits, universal properties.
# * CATEGORICAL SETTING -- explicit bounded source/target cone certificates.
# * LAW / UNIVERSAL PROPERTY -- compare universality before, after, and on lifts.
# * BOUNDARY -- Boolean certificates model finite checks, not arbitrary functors.
# * WHAT THIS SHOWS
# * Preservation goes forward; reflection detects backward; creation uniquely lifts.
# ***************************************************************************
;
def u:preserves_limit(source_is_limit, image_is_limit) { "Check that a known bounded source limit remains universal after mapping."; source_is_limit * image_is_limit }  # CT055
def u:preserves_colimit(source_is_colimit, image_is_colimit) { "Check the dual forward preservation condition for a bounded colimit."; source_is_colimit * image_is_colimit }  # CT056
def u:reflects_limit(image_is_limit, source_is_limit) { "Check that image universality detects source universality."; image_is_limit * source_is_limit }  # CT058
def u:creates_limit(target_is_limit, source_lift_is_limit, lift_count) { "Check that a target limit has exactly one universal source lift."; target_is_limit * source_lift_is_limit * eq(lift_count, 1) }  # CT057
preserved_limit = u:preserves_limit(1, 1)  # known source limit stays a limit
preserved_colimit = u:preserves_colimit(1, 1)  # dual colimit stays a colimit
reflected_limit = u:reflects_limit(1, 1)  # image limit detects source limit
created_limit = u:creates_limit(1, 1, 1)  # target limit has one universal lift
lost_universality = 1 - u:preserves_limit(1, 0)  # COUNTEREXAMPLE: preservation fails
false_reflection = 1 - u:reflects_limit(1, 0)  # COUNTEREXAMPLE: reflection fails
nonunique_creation = 1 - u:creates_limit(1, 1, 2)  # COUNTEREXAMPLE: creation fails
disp([preserved_limit, preserved_colimit, reflected_limit, created_limit])  # four lawful checks
disp([lost_universality, false_reflection, nonunique_creation])  # three distinct failures
# ***************************************************************************
# * THE VISUAL
# * Four panels encode direction and unique lifting; dashed witnesses differ.
# ***************************************************************************
def u:preservation_creation_reflection_visual() { "Render four functor properties and three distinct bounded counterexamples."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 960 400\" role=\"img\"><title>preservation creation and reflection are different</title><desc>Preservation maps a known limit or colimit forward. Reflection detects a source limit from its image. Creation uniquely lifts a target limit. Dashed counterexamples distinguish them.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{marker-end:url(\\23 arrowhead);stroke:rgb(247,118,142);stroke-width:4;stroke-dasharray:10 7}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(180px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(180px)}}</style><rect width=\"960\" height=\"400\" fill=\"rgb(26,27,38)\"/><g><text x=\"240\" y=\"28\" text-anchor=\"middle\">PRESERVE LIMIT: forward</text><rect class=\"obj\" x=\"45\" y=\"50\" width=\"170\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"300\" y=\"50\" width=\"170\" height=\"55\" rx=\"10\"/><text x=\"130\" y=\"83\" text-anchor=\"middle\">source LIMIT</text><text x=\"385\" y=\"83\" text-anchor=\"middle\">image LIMIT</text><line class=\"arrow\" x1=\"215\" y1=\"77\" x2=\"300\" y2=\"77\"/></g><g><text x=\"720\" y=\"28\" text-anchor=\"middle\">PRESERVE COLIMIT: dual</text><rect class=\"obj\" x=\"525\" y=\"50\" width=\"170\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"780\" y=\"50\" width=\"150\" height=\"55\" rx=\"10\"/><text x=\"610\" y=\"83\" text-anchor=\"middle\">source COLIMIT</text><text x=\"855\" y=\"83\" text-anchor=\"middle\">image COLIMIT</text><line class=\"arrow\" x1=\"695\" y1=\"77\" x2=\"780\" y2=\"77\"/></g><g><text x=\"240\" y=\"160\" text-anchor=\"middle\">REFLECT LIMIT: detect backward</text><rect class=\"obj\" x=\"45\" y=\"180\" width=\"170\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"300\" y=\"180\" width=\"170\" height=\"55\" rx=\"10\"/><text x=\"130\" y=\"213\" text-anchor=\"middle\">source LIMIT</text><text x=\"385\" y=\"213\" text-anchor=\"middle\">image LIMIT</text><line class=\"arrow\" x1=\"300\" y1=\"207\" x2=\"215\" y2=\"207\"/></g><g><text x=\"720\" y=\"160\" text-anchor=\"middle\">CREATE LIMIT: uniquely lift</text><rect class=\"obj\" x=\"525\" y=\"180\" width=\"170\" height=\"55\" rx=\"10\"/><rect class=\"obj\" x=\"780\" y=\"180\" width=\"150\" height=\"55\" rx=\"10\"/><text x=\"610\" y=\"213\" text-anchor=\"middle\">ONE source lift</text><text x=\"855\" y=\"213\" text-anchor=\"middle\">target LIMIT</text><line class=\"arrow\" x1=\"780\" y1=\"207\" x2=\"695\" y2=\"207\"/></g><text x=\"480\" y=\"285\" text-anchor=\"middle\">COUNTEREXAMPLES</text><path class=\"bad\" d=\"M70 325H260\"/><text x=\"165\" y=\"315\" text-anchor=\"middle\">image not universal</text><path class=\"bad\" d=\"M385 325H575\"/><text x=\"480\" y=\"315\" text-anchor=\"middle\">source not universal</text><path class=\"bad\" d=\"M700 325H890\"/><text x=\"795\" y=\"315\" text-anchor=\"middle\">2 lifts: not created</text><circle class=\"token\" cx=\"75\" cy=\"95\" r=\"8\"/><text x=\"480\" y=\"380\" text-anchor=\"middle\">Creation is stronger data than reflection: it selects exactly one lift.</text></svg>" }  # named custom visual
preservation_creation_reflection_visual = u:preservation_creation_reflection_visual()  # bind visual constant
preservation_creation_reflection_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Forward arrows preserve; backward arrows reflect or lift; only creation says ONE.
# * THE POINT -- before/after universality and lift uniqueness distinguish the terms.
# ***************************************************************************
