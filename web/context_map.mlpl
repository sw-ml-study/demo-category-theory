# Web Lesson 12 -- contextual mapping.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Mapping changes a success payload while preserving a failure unchanged.
# ***************************************************************************
;
def u:increment_payload(value) { "Increment one successful payload."; value + 1 }  # mapped transform
success = {tag: "success", value: 3, message: ""}  # successful context
failure = {tag: "failure", value: 0, message: "bad input"}  # failed context
mapped_success = {tag: "success", value: u:increment_payload(success.value), message: ""}  # map success
mapped_failure = failure  # map skips failure payload
disp([success.value, mapped_success.value, equal(failure, mapped_failure)])  # 3, 4, preserved
# ***************************************************************************
# * THE VISUAL
# * Green transforms 3 to 4; red carries the same failure around the function.
# ***************************************************************************
def u:context_map_visual() { "Render the directed SVG witness for this lesson categorical law."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 760 270\" width=\"760\" height=\"270\" role=\"img\"><title>contextual mapping</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.failed{stroke-dasharray:10 7;stroke:rgb(247,118,142)}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(380px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(380px)}}</style><rect width=\"760\" height=\"270\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"50\" y=\"55\" width=\"160\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"550\" y=\"55\" width=\"160\" height=\"60\" rx=\"14\"/><line class=\"arrow\" x1=\"210\" y1=\"85\" x2=\"550\" y2=\"85\"/><text x=\"130\" y=\"92\" text-anchor=\"middle\">success 3</text><text x=\"630\" y=\"92\" text-anchor=\"middle\">success 4</text><rect class=\"obj\" x=\"50\" y=\"170\" width=\"160\" height=\"60\" rx=\"14\"/><rect class=\"obj\" x=\"550\" y=\"170\" width=\"160\" height=\"60\" rx=\"14\"/><line class=\"arrow failed\" x1=\"210\" y1=\"200\" x2=\"550\" y2=\"200\"/><text x=\"130\" y=\"207\" text-anchor=\"middle\">failure bad</text><text x=\"630\" y=\"207\" text-anchor=\"middle\">failure bad</text><circle class=\"token\" cx=\"190\" cy=\"105\" r=\"9\"/></svg>" }  # named custom visual
context_map_visual = u:context_map_visual()  # bind visual constant
context_map_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The success payload changes; the failure record remains equal to itself.
# * THE POINT -- map preserves the context while transforming its value.
# ***************************************************************************

