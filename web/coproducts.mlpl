# Web Lesson 06 -- coproducts.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * Tagged left and right values determine one case-analysis function.
# ***************************************************************************
;
def u:increment(x) { "Provide the left-branch morphism selected by coproduct case analysis.";  x + 1 }  # action for left values
def u:negate(x) { "Provide the right-branch morphism selected by coproduct case analysis.";  0 - x }  # action for right values
left_injected_value = {tag: "left", value: 3}  # left injection
right_injected_value = {tag: "right", value: 3}  # right injection
left_result = call(:u:increment, [left_injected_value.value])  # chosen by the left tag
right_result = call(:u:negate, [right_injected_value.value])  # chosen by the right tag
disp([left_result, right_result])  # destinations 4 and -3
# ***************************************************************************
# * THE VISUAL
# * Two tagged entrances converge; their tags select different behavior.
# ***************************************************************************
def u:coproducts_visual() { "Render the directed SVG witness for this lesson categorical law."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 280\" width=\"700\" height=\"280\" role=\"img\"><title>coproducts</title><desc>Blue outlined containers are categorical objects; labeled directed arrows are morphisms; circular tokens are elements. Dashed paths and COUNTEREXAMPLE labels mark failures without relying on color.</desc><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);fill:none;stroke:rgb(158,206,106);stroke-width:4}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateY(90px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateY(90px)}}</style><rect width=\"700\" height=\"280\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"65\" y=\"45\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"485\" y=\"45\" width=\"150\" height=\"65\" rx=\"14\"/><rect class=\"obj\" x=\"275\" y=\"200\" width=\"150\" height=\"60\" rx=\"14\"/><path class=\"arrow\" d=\"M185 110L300 200M515 110L400 200\"/><text x=\"140\" y=\"82\" text-anchor=\"middle\">left 3 -&gt; 4</text><text x=\"560\" y=\"82\" text-anchor=\"middle\">right 3 -&gt; -3</text><text x=\"350\" y=\"237\" text-anchor=\"middle\">case analysis</text><circle class=\"token\" cx=\"140\" cy=\"95\" r=\"10\"/></svg>" }  # named custom visual
coproducts_visual = u:coproducts_visual()  # bind visual constant
coproducts_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * The tag remembers the entrance, so one map can apply inc or negate.
# * THE POINT -- this models values, not statically exhaustive sum types.
# ***************************************************************************
