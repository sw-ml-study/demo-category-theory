# Web Lesson 22 -- equalizer.
# visual: svg
# loops: 0
# ***************************************************************************
# * WHAT THIS SHOWS
# * The equalizer keeps exactly the inputs where two classifiers agree.
# ***************************************************************************
;
left_classifier = [0, 1, 1, 2]  # first parallel arrow
right_classifier = [0, 2, 1, 0]  # second parallel arrow
equalizer = [0, 2]  # agreeing source indices
left_route = [take(left_classifier, 0, 0), take(left_classifier, 0, 2)]  # through f
right_route = [take(right_classifier, 0, 0), take(right_classifier, 0, 2)]  # through g
lawful_factor = [0, 1]  # reconstructs inclusion [0,2]
broken_mediator = [0, 1]  # includes a disagreeing source row
disp(equalizer)  # largest agreeing subset
disp([equal(left_route, right_route), equal(broken_mediator, equalizer)])  # 1 then 0
# ***************************************************************************
# * THE VISUAL
# * Green E=[0,2] equalizes f and g; red row 1 makes their outputs split.
# ***************************************************************************
def u:equalizer_visual() { "Return the equalizer_visual diagram for the web renderer."; "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 820 280\" width=\"820\" height=\"280\" role=\"img\"><defs><marker id=\"arrowhead\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"context-stroke\"/></marker></defs><style>text{font-family:monospace;fill:rgb(192,202,245)}.obj{fill:rgb(31,35,53);stroke:rgb(122,162,247);stroke-width:3}.arrow{marker-end:url(\\23 arrowhead);stroke:rgb(158,206,106);stroke-width:4}.bad{stroke:rgb(247,118,142)}.token{fill:rgb(247,118,142);animation:p 3s infinite alternate}@keyframes p{to{transform:translateX(390px)}}@media(prefers-reduced-motion:reduce){.token{animation:none;transform:translateX(390px)}}</style><rect width=\"820\" height=\"280\" fill=\"rgb(26,27,38)\"/><rect class=\"obj\" x=\"30\" y=\"55\" width=\"150\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"315\" y=\"55\" width=\"180\" height=\"65\" rx=\"12\"/><rect class=\"obj\" x=\"650\" y=\"55\" width=\"140\" height=\"65\" rx=\"12\"/><line class=\"arrow\" x1=\"180\" y1=\"87\" x2=\"315\" y2=\"87\"/><line class=\"arrow\" x1=\"495\" y1=\"72\" x2=\"650\" y2=\"72\"/><line class=\"arrow\" x1=\"495\" y1=\"102\" x2=\"650\" y2=\"102\"/><text x=\"105\" y=\"94\" text-anchor=\"middle\">E=[0,2]</text><text x=\"405\" y=\"94\" text-anchor=\"middle\">A=[0,1,2,3]</text><text x=\"720\" y=\"94\" text-anchor=\"middle\">B</text><rect class=\"obj\" x=\"230\" y=\"185\" width=\"360\" height=\"60\" rx=\"12\"/><line class=\"arrow bad\" x1=\"410\" y1=\"165\" x2=\"410\" y2=\"185\"/><text x=\"410\" y=\"222\" text-anchor=\"middle\">row 1: f=1, g=2</text><circle class=\"token\" cx=\"160\" cy=\"107\" r=\"9\"/></svg>" }  # named custom visual
equalizer_visual = u:equalizer_visual()  # bind visual constant
equalizer_visual  # display bound visual once
# ***************************************************************************
# * HOW TO READ THE RESULT
# * Every lawful mediator lands in E and therefore factors through inclusion.
# * THE POINT -- equalizer is the universal agreeing subobject.
# ***************************************************************************
